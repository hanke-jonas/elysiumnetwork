---
layout: base.njk
pagination:
  data: site.branches
  size: 1
  alias: b
permalink: "/{{ b.slug }}/"
eleventyComputed:
  title: "{{ b.name }} — Elysium+ Network"
  description: "{{ b.about }}"
---
{% set accent = b.accent %}
{% set inFormation = b.status == "In formation" %}

<section class="relative overflow-hidden bg-paper border-b-2 border-ink">
  <div class="pointer-events-none absolute inset-0" style="background:linear-gradient(160deg,{{ accent }}33 0%,transparent 55%)"></div>
  <div class="relative max-w-7xl mx-auto px-5 sm:px-6 pt-14 pb-16">
    <nav class="mono text-xs text-muted mb-8 uppercase tracking-wider"><a href="/" class="hover:underline">Home</a> <span class="mx-1 opacity-40">/</span> <span>Network</span> <span class="mx-1 opacity-40">/</span> <span class="text-ink/90">{{ b.country }}</span></nav>
    <div class="flex items-center gap-4">
      <span class="text-6xl leading-none">{{ b.flag }}</span>
      <span class="tag" style="border-color:{{ accent }};background:{{ accent }}33">{{ b.status }}</span>
    </div>
    <h1 class="h-hero mt-5">{{ b.name }}</h1>
    <p class="mt-2 text-lg text-muted font-display font-semibold">{{ b.name_native }}</p>
    <p class="mt-5 text-xl max-w-2xl leading-relaxed">{{ b.tagline }}</p>
    {% if b.esc %}
    <a href="{{ b.esc.url }}" target="_blank" rel="noopener" class="mt-5 inline-flex items-center gap-2.5 rounded-xl border-2 border-ink bg-white px-4 py-2.5 hover:-translate-y-0.5 transition">
      <span class="w-2 h-2 rounded-full border border-ink" style="background:var(--mint)"></span>
      <span class="text-sm font-bold">Accredited European Solidarity Corps {{ b.esc.role }}</span>
      {% icon "arrow-ur", "w-3.5 h-3.5 opacity-60" %}
    </a>
    {% endif %}
    <div class="mt-8 inline-flex items-center gap-3 rounded-xl border-2 border-ink bg-white px-5 py-3">
      <span class="w-2.5 h-2.5 rounded-full border border-ink" style="background:{{ accent }}"></span>
      <span class="mono text-sm text-muted">Local time</span>
      <span class="mono text-lg font-bold clock-time" data-tz="{{ b.tz }}">--:--:--</span>
    </div>
  </div>
</section>

<section class="bg-paper">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 py-16 grid lg:grid-cols-12 gap-10 items-start">
    <div class="lg:col-span-7">
      <p class="eyebrow" style="color:{{ accent }}">About</p>
      <h2 class="h-sec mt-3 mb-5">The story so far</h2>
      <p class="text-lg leading-relaxed">{{ b.about }}</p>

      {% if inFormation %}
      <div class="mt-6 rounded-2xl border-2 border-ink p-5 flex gap-4" style="background:{{ accent }}22">
        <span class="text-2xl">🚧</span>
        <p class="leading-relaxed">Astra is still being set up. A dedicated site is on the way at
          <a href="{{ b.website }}" target="_blank" rel="noopener" class="font-bold underline underline-offset-2">astra.ngo</a>. In the meantime, reach the German branch through the network.</p>
      </div>
      {% endif %}

      {% if b.slug == 'ukraine' %}
      <div class="mt-6 rounded-2xl border-2 border-ink p-5 flex gap-4" style="background:#C0392B14">
        <span class="text-2xl">⚠️</span>
        <div>
          <p class="leading-relaxed">Since February 2022, Russia's invasion has occupied, besieged and bombed this region.</p>
          <a href="/against-the-war/" class="mt-2 inline-flex items-center gap-1.5 font-bold hover:gap-2.5 transition-all">A sourced account of what happened here {% icon "arrow", "w-4 h-4" %}</a>
        </div>
      </div>
      {% endif %}

      {% for c in calls %}{% if c.branchSlug == b.slug and c.status != 'closed' %}
      <div class="mt-6 rounded-2xl border-2 border-dashed border-ink p-5" style="background:{{ accent }}18">
        <span class="stamp" style="border-color:{{ accent }}">{% if c.status == 'coming_up' %}Coming up{% else %}Open now{% endif %}</span>
        <h3 class="font-display text-xl font-bold mt-3">{{ c.title }}</h3>
        <p class="mt-2 leading-relaxed">{{ c.summary }}</p>
        <p class="mt-2 text-sm font-bold">{{ c.deadline }}</p>
        <a href="{{ c.link }}"{% if '://' in c.link %} target="_blank" rel="noopener"{% endif %} class="mt-3 inline-flex items-center gap-1.5 font-bold hover:gap-2.5 transition-all">{{ c.linkLabel }} {% icon "arrow", "w-4 h-4" %}</a>
      </div>
      {% endif %}{% endfor %}

      <h3 class="font-display text-2xl font-bold mt-12 mb-4">Focus areas</h3>
      <div class="flex flex-wrap gap-2.5">
        {% for f in b.focus %}
        {# Equality-related focus areas get a plum border regardless of the
           branch's own accent color — the one place a value overrides the
           per-branch color-coding, signalling that equality isn't any one
           branch's issue, it's the network's. #}
        {% set fLower = f | lower %}
        {% set isEquality = "inclusion" in fLower or "equality" in fLower or "rights" in fLower %}
        <span class="tag" style="background:{{ accent }}22{% if isEquality %};border-color:var(--plum){% endif %}">{{ f }}</span>
        {% endfor %}
      </div>

      <h3 class="font-display text-2xl font-bold mt-12 mb-5">People</h3>
      <div class="grid sm:grid-cols-2 gap-5">
        {% for p in b.people %}
        <div class="card p-5">
          <div class="w-11 h-11 rounded-full grid place-items-center font-display font-bold text-lg border-2 border-ink" style="background:{{ accent }}">
            {{ p.name | first | upper }}
          </div>
          <h4 class="font-display text-lg font-bold mt-4">{{ p.name }}</h4>
          <p class="text-sm text-muted mt-0.5">{{ p.role }}</p>
          {% if p.bio %}<p class="text-sm mt-3 leading-relaxed">{{ p.bio }}</p>{% endif %}
          <a href="mailto:{{ p.email }}" class="mt-3 inline-flex items-center gap-1.5 text-sm font-bold hover:gap-2.5 transition-all">{% icon "mail", "w-4 h-4" %} {{ p.email }}</a>
        </div>
        {% endfor %}
      </div>
    </div>

    <aside class="lg:col-span-5 lg:sticky lg:top-24">
      <div class="rounded-2xl border-2 border-ink overflow-hidden card">
        <div class="h-2 border-b-2 border-ink" style="background:{{ accent }}"></div>
        <div class="p-7">
          <h2 class="eyebrow text-muted mb-5">Organisation details</h2>
          <dl class="space-y-4">
            <div class="flex gap-3">
              <span class="mt-0.5 opacity-45">{% icon "id", "w-5 h-5" %}</span>
              <div class="min-w-0"><dt class="eyebrow opacity-70">Legal name</dt><dd class="leading-snug break-words">{{ b.name_native }}</dd></div>
            </div>
            <div class="flex gap-3">
              <span class="mt-0.5 opacity-45">{% icon "id", "w-5 h-5" %}</span>
              <div class="min-w-0"><dt class="eyebrow opacity-70">Erasmus+ OID</dt><dd class="leading-snug break-words mono">{{ b.oid }}</dd></div>
            </div>
            <div class="flex gap-3">
              <span class="mt-0.5 opacity-45">{% icon "pin", "w-5 h-5" %}</span>
              <div class="min-w-0"><dt class="eyebrow opacity-70">Type</dt><dd class="leading-snug break-words">{{ b.type }}</dd></div>
            </div>
            {% if b.esc %}
            <div class="flex gap-3">
              <span class="mt-0.5 opacity-45">{% icon "id", "w-5 h-5" %}</span>
              <div class="min-w-0"><dt class="eyebrow opacity-70">ESC accreditation</dt><dd class="leading-snug break-words">{{ b.esc.role }} · valid until {{ b.esc.validUntil }} — <a href="{{ b.esc.url }}" target="_blank" rel="noopener" class="font-bold underline underline-offset-2">verify on the EU Youth Portal</a></dd></div>
            </div>
            {% endif %}
            <div class="flex gap-3">
              <span class="mt-0.5 opacity-45">{% icon "pin", "w-5 h-5" %}</span>
              <div class="min-w-0"><dt class="eyebrow opacity-70">Location</dt><dd class="leading-snug break-words">{{ b.address }}</dd></div>
            </div>
            {% if b.phone %}
            <div class="flex gap-3">
              <span class="mt-0.5 opacity-45">{% icon "pin", "w-5 h-5" %}</span>
              <div class="min-w-0"><dt class="eyebrow opacity-70">Phone</dt><dd class="leading-snug break-words">{{ b.phone }}</dd></div>
            </div>
            {% endif %}
            <div class="flex gap-3">
              <span class="mt-0.5 opacity-45">{% icon "mail", "w-5 h-5" %}</span>
              <div class="min-w-0"><dt class="eyebrow opacity-70">Email</dt><dd class="leading-snug break-words"><a href="mailto:{{ b.email }}" class="hover:underline font-medium">{{ b.email }}</a></dd></div>
            </div>
          </dl>
          {% if b.website %}
          <a href="{{ b.website }}" target="_blank" rel="noopener" class="btn btn-ink w-full justify-center mt-7">Visit website {% icon "arrow-ur", "w-4 h-4" %}</a>
          {% else %}
          <a href="{{ site.join_form }}" class="btn btn-accent w-full justify-center mt-7">Get involved</a>
          {% endif %}
        </div>
      </div>
    </aside>
  </div>
</section>

<section class="bg-paper-2 border-t-2 border-ink">
  <div class="max-w-7xl mx-auto px-5 sm:px-6 py-14 flex flex-wrap items-center justify-between gap-4">
    <p class="text-lg">Explore the rest of the network.</p>
    <div class="flex flex-wrap gap-2.5">
      {% for ob in site.branches %}{% if ob.slug != b.slug %}
      <a href="/{{ ob.slug }}/" class="inline-flex items-center gap-2 rounded-full bg-white border-2 border-ink px-4 py-2 text-sm font-semibold hover:-translate-y-0.5 transition">{{ ob.flag }} {{ ob.name }}</a>
      {% endif %}{% endfor %}
    </div>
  </div>
</section>
