---
layout: base.njk
title: "Sign up — Elysium+ Network"
description: "Create an Elysium+ Network account to express interest in calls and manage your profile."
permalink: /account/signup/
---
<section class="bg-paper">
  <div class="max-w-md mx-auto px-5 py-16">
    <p class="eyebrow" style="color:var(--coral-ink)">Elysium+ Network</p>
    <h1 class="h-hero mt-4">Sign up</h1>
    <p class="mt-4 text-muted leading-relaxed">Create an account to express interest in open calls and manage your profile.</p>

    <div class="card p-8 mt-8">
      <form id="signup-form" class="flex flex-col gap-4">
        <div>
          <label class="form-label" for="name">Name</label>
          <input class="input" type="text" id="name" name="name" autocomplete="name" required>
        </div>
        <div>
          <label class="form-label" for="email">Email</label>
          <input class="input" type="email" id="email" name="email" autocomplete="email" required>
        </div>
        <div>
          <label class="form-label" for="password">Password</label>
          <input class="input" type="password" id="password" name="password" autocomplete="new-password" minlength="8" required>
          <p class="text-xs text-muted mt-1">Must be at least 8 characters.</p>
        </div>
        <div class="flex items-start gap-2 mt-1">
          <input class="input w-auto mt-0.5" type="checkbox" id="newsletter" name="newsletter" style="width:auto">
          <label class="form-label !mb-0" for="newsletter">Subscribe me to the newsletter</label>
        </div>
        <button type="submit" id="submit-btn" class="btn btn-accent w-full justify-center mt-1">Create account</button>
        <p id="status-msg" role="status" aria-live="polite" class="text-sm"></p>
      </form>

      <p class="text-sm text-muted mt-6" id="login-link-p">Already have an account? <a href="/account/login/" id="login-link" class="underline">Log in</a></p>
    </div>
  </div>
</section>

<script>
  function nextUrl() {
    var params = new URLSearchParams(location.search);
    return params.get('next') || '/account/';
  }

  (function () {
    var next = new URLSearchParams(location.search).get('next');
    var loginLink = document.getElementById('login-link');
    if (next) {
      loginLink.href = '/account/login/?next=' + encodeURIComponent(next);
    }

    fetch('/api/auth/me', { credentials: 'include' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (data.signedIn && data.type === 'public') {
          location.href = '/account/';
        }
      });
  })();

  document.getElementById('signup-form').addEventListener('submit', function (e) {
    e.preventDefault();

    var statusMsg = document.getElementById('status-msg');
    var submitBtn = document.getElementById('submit-btn');
    var name = document.getElementById('name').value.trim();
    var email = document.getElementById('email').value.trim();
    var password = document.getElementById('password').value;
    var newsletterOptIn = document.getElementById('newsletter').checked;

    statusMsg.style.color = 'unset';
    statusMsg.textContent = 'Creating account…';
    submitBtn.disabled = true;

    fetch('/api/auth/signup', {
      method: 'POST',
      credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: email, password: password, name: name, newsletterOptIn: newsletterOptIn })
    }).then(function (res) {
      return res.json().then(function (data) { return { ok: res.ok, status: res.status, data: data }; });
    }).then(function (r) {
      if (!r.ok) {
        statusMsg.style.color = 'var(--coral-ink)';
        statusMsg.textContent = (r.data && r.data.error) || 'Something went wrong. Please try again.';
        submitBtn.disabled = false;
        return;
      }
      location.href = nextUrl();
    }).catch(function () {
      statusMsg.style.color = 'var(--coral-ink)';
      statusMsg.textContent = 'Network error. Please try again.';
      submitBtn.disabled = false;
    });
  });
</script>
