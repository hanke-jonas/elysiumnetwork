---
layout: base.njk
title: Active calls — Elysium+ Network
description: Open calls for youth exchanges, trainings and youth-led projects across the Elysium+ network in Ukraine, Poland, Italy and Germany.
permalink: /calls/
---

<section class="relative overflow-hidden bg-paper border-b-2 border-ink">
  <div class="relative max-w-4xl mx-auto px-5 sm:px-6 pt-14 pb-16">
    <p class="eyebrow" style="color:var(--coral-ink)">Opportunities</p>
    <h1 class="h-hero mt-4">Active <mark>calls</mark></h1>
    <p class="mt-6 text-lg text-muted max-w-2xl leading-relaxed">Open calls for exchanges, trainings and youth-led projects across the network. New calls are announced here and on our social channels.</p>
  </div>
</section>

<section class="bg-paper">
  <div class="max-w-4xl mx-auto px-5 sm:px-6 py-16 space-y-6">
    {% include "opportunity-portal-promo.njk" %}

    {% set statusMeta = {
      open: { label: "Open", bg: "var(--mint)", dot: "bg-white" },
      coming_up: { label: "Coming up", bg: "var(--sun)", dot: "bg-ink/70" },
      closed: { label: "Closed", bg: "var(--paper-2)", dot: "bg-ink/30" }
    } %}
    {% for c in calls %}
    {% for cb in site.branches %}{% if cb.slug == c.branchSlug %}
    {% set sm = statusMeta[c.status] or statusMeta.closed %}
    <div class="card !rounded-2xl overflow-hidden reveal">
      <div class="h-1.5 border-b-2 border-ink" style="background:{{ cb.accent }}"></div>
      <div class="p-7 sm:p-8">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="tag" style="background:{{ cb.accent }}33">{{ cb.flag }} {{ cb.name }}</span>
          <span class="tag" style="background:{{ sm.bg }}">
            <span class="w-1.5 h-1.5 rounded-full {{ sm.dot }}"></span>{{ sm.label }}
          </span>
        </div>
        <h2 class="h-card text-2xl">{{ c.title }}</h2>
        <p class="mt-3 leading-relaxed">{{ c.summary }}</p>
        <div class="mt-6 flex flex-wrap items-center gap-4">
          <a href="{{ c.link }}"{% if '://' in c.link %} target="_blank" rel="noopener"{% endif %} class="btn {% if c.status == 'open' %}btn-accent{% endif %}">{{ c.linkLabel }} {% icon "arrow", "w-4 h-4" %}</a>
          {% if c.status == 'open' %}
          <button type="button" class="btn express-interest-btn" data-call-id="{{ c.id }}">I'm interested</button>
          {% endif %}
          <span class="text-sm text-muted">{{ c.deadline }}</span>
        </div>
      </div>
    </div>
    {% endif %}{% endfor %}
    {% endfor %}

    <div class="rounded-2xl border-2 border-ink p-8 sm:p-10 text-center reveal" style="background:var(--paper-2)">
      <h2 class="font-display text-2xl font-bold">Looking for the next opportunity?</h2>
      <p class="mt-3 leading-relaxed max-w-xl mx-auto">New exchanges and trainings open throughout the year. Follow us or join our mailing list to be first to hear — individual applications for Erasmus+ always run through the network.</p>
      <div class="mt-6 flex flex-wrap gap-3 justify-center">
        <a href="{{ site.join_form }}" class="btn btn-accent">Join Us</a>
        <a href="https://www.instagram.com/beyondborders.ngo" target="_blank" rel="noopener" class="btn">Follow on Instagram</a>
      </div>
    </div>
  </div>
</section>

<script>
  (function(){
    var buttons = document.querySelectorAll('.express-interest-btn');
    if (!buttons.length) return;

    function markInterested(btn){
      btn.textContent = "You're interested ✓";
      btn.disabled = true;
    }

    fetch('/api/auth/me', {credentials:'include'}).then(function(r){ return r.json(); }).then(function(session){
      if (!session.signedIn || session.type !== 'public') return;
      fetch('/api/calls/interest', {credentials:'include'}).then(function(r){ return r.json(); }).then(function(data){
        (data.callIds || []).forEach(function(id){
          var btn = document.querySelector('.express-interest-btn[data-call-id="' + id + '"]');
          if (btn) markInterested(btn);
        });
      });
    });

    buttons.forEach(function(btn){
      btn.addEventListener('click', function(){
        fetch('/api/auth/me', {credentials:'include'}).then(function(r){ return r.json(); }).then(function(session){
          if (!session.signedIn || session.type !== 'public') {
            location.href = '/account/login/?next=' + encodeURIComponent('/calls/');
            return;
          }
          btn.disabled = true;
          fetch('/api/calls/interest', {
            method: 'POST', credentials: 'include',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({callId: btn.getAttribute('data-call-id')})
          }).then(function(res){ return res.json().then(function(data){ return {ok: res.ok, data: data}; }); })
            .then(function(r){
              if (!r.ok) { btn.disabled = false; alert(r.data.error || 'Something went wrong — please try again.'); return; }
              markInterested(btn);
            })
            .catch(function(){ btn.disabled = false; alert('Something went wrong — please try again.'); });
        });
      });
    });
  })();
</script>
