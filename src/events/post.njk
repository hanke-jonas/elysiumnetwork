---
layout: base.njk
pagination:
  data: events
  size: 1
  alias: event
permalink: "/events/{{ event.slug }}/"
eleventyComputed:
  title: "{{ event.title }} — Elysium+ Network"
  description: "{{ event.description or event.title }}"
---
<section class="bg-paper">
  <div class="max-w-3xl mx-auto px-5 sm:px-6 pt-10 pb-20">
    <nav class="mono text-xs text-muted mb-8 uppercase tracking-wider">
      <a href="/" class="hover:underline">Home</a> <span class="mx-1 opacity-40">/</span>
      <a href="/events/" class="hover:underline">Events</a> <span class="mx-1 opacity-40">/</span>
      <span class="text-ink/90">{{ event.title }}</span>
    </nav>

    {% if event.coverImage %}
    <img src="{{ event.coverImage }}" alt="{{ event.title }}" width="1200" height="420" class="max-h-[420px] object-cover w-full rounded-2xl border-2 border-ink mb-8" style="aspect-ratio:1200/420">
    {% endif %}

    <p class="mono text-xs text-muted uppercase tracking-wider">
      {{ event.startDate | readableDate }}{% if event.endDate %} – {{ event.endDate | readableDate }}{% endif %}{% if event.location %} · {{ event.location }}{% endif %}
    </p>

    <h1 class="h-hero mt-5">{{ event.title }}</h1>

    {% if event.description %}
    <p class="mt-6 text-lg text-muted leading-relaxed">{{ event.description }}</p>
    {% endif %}

    <div class="post-body mt-10">
      {{ event.bodyHtml | safe }}
    </div>

    <div class="mt-12 p-6 sm:p-8 rounded-2xl border-2 border-ink" style="background:var(--paper-2)">
      <h2 class="font-display text-xl font-bold">RSVP for this event</h2>
      <div class="mt-4 flex flex-wrap items-center gap-4">
        <button type="button" id="rsvpBtn" class="btn btn-accent">RSVP</button>
        {% if event.capacity %}
        <span class="text-sm text-muted">Limited to {{ event.capacity }} spots</span>
        {% endif %}
      </div>
      <p id="rsvpStatus" role="status" aria-live="polite" class="mt-3 text-sm"></p>
    </div>

    <div class="mt-14 pt-8 border-t-2 border-ink">
      <a href="/events/" class="btn">{% icon "arrow", "w-4 h-4 rotate-180" %} Back to Events</a>
    </div>
  </div>
</section>

<style>
  /* Baseline styling for the rich-text body only — this project has no
     @tailwindcss/typography plugin, so raw tags coming out of the events
     editor (h1-h3, p, ul, ol, li, blockquote, a, img, strong, em) need
     some minimal, scoped rules to read well. Kept deliberately small and
     matched to the site's existing type scale rather than inventing a
     new visual language. */
  .post-body{ font-size:1.05rem; line-height:1.75; }
  .post-body h1, .post-body h2, .post-body h3{ font-family:"Bricolage Grotesque",system-ui,sans-serif; font-weight:800; letter-spacing:-0.02em; line-height:1.15; margin-top:1.6em; margin-bottom:.6em; }
  .post-body h1{ font-size:2rem; }
  .post-body h2{ font-size:1.6rem; }
  .post-body h3{ font-size:1.3rem; }
  .post-body p{ margin-top:1em; }
  .post-body ul, .post-body ol{ margin-top:1em; padding-left:1.4em; }
  .post-body ul{ list-style:disc; }
  .post-body ol{ list-style:decimal; }
  .post-body li{ margin-top:.4em; }
  .post-body li + li{ margin-top:.4em; }
  .post-body a{ text-decoration:underline; text-underline-offset:2px; font-weight:600; }
  .post-body strong{ font-weight:700; }
  .post-body em{ font-style:italic; }
  .post-body blockquote{ margin-top:1.4em; padding-left:1.2em; border-left:3px solid var(--ink); opacity:.75; font-style:italic; }
  .post-body img{ margin-top:1.4em; max-width:100%; height:auto; border-radius:.9rem; border:2px solid var(--ink); }
  .post-body :first-child{ margin-top:0; }
</style>

<script>
  (function(){
    var btn = document.getElementById('rsvpBtn');
    var statusEl = document.getElementById('rsvpStatus');
    if (!btn) return;
    var eventId = "{{ event.id }}";

    function setStatus(msg, isError){
      statusEl.textContent = msg || '';
      statusEl.style.color = isError ? 'var(--coral-ink)' : '';
    }

    function markGoing(){
      btn.textContent = "You're going! ✓";
      btn.disabled = true;
    }

    // Reflect existing RSVP state on load, for signed-in public visitors only.
    fetch('/api/auth/me', {credentials:'include'})
      .then(function(r){ return r.json(); })
      .then(function(session){
        if (!session.signedIn || session.type !== 'public') return;
        return fetch('/api/events/rsvp', {credentials:'include'})
          .then(function(r){ return r.json(); })
          .then(function(data){
            var ids = (data.eventIds || []).map(function(id){ return String(id); });
            if (ids.indexOf(eventId) !== -1) markGoing();
          });
      })
      .catch(function(){ /* not signed in / request failed — leave button as-is */ });

    btn.addEventListener('click', function(){
      btn.disabled = true;
      setStatus('');
      fetch('/api/auth/me', {credentials:'include'})
        .then(function(r){ return r.json(); })
        .then(function(session){
          if (!session.signedIn || session.type !== 'public') {
            location.href = '/account/login/?next=' + encodeURIComponent(location.pathname);
            return;
          }
          return fetch('/api/events/rsvp', {
            method: 'POST',
            credentials: 'include',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({eventId: eventId})
          }).then(function(res){
            return res.json().then(function(data){ return {ok: res.ok, data: data}; });
          }).then(function(r){
            if (!r.ok) {
              btn.disabled = false;
              setStatus(r.data.error || 'Something went wrong — please try again.', true);
              return;
            }
            markGoing();
          });
        })
        .catch(function(){
          btn.disabled = false;
          setStatus('Something went wrong — please try again.', true);
        });
    });
  })();
</script>
