{% set sections = [
  ["Introduction", "This Privacy Policy explains how Elysium+ collects, uses and protects personal data when you visit our website, contact us or take part in our activities. We are committed to handling your information responsibly, transparently and in line with the General Data Protection Regulation (GDPR). By using our website, you agree to the practices described here."],
