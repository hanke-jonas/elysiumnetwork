---
layout: admin-base.njk
title: "Media Library"
permalink: /admin/media/
---
<div class="flex flex-wrap items-center justify-between gap-4 mb-8">
  <div>
    <p class="eyebrow" style="color:var(--coral-ink)">Admin</p>
    <h1 class="h-sec mt-1">Media library</h1>
    <p class="text-sm text-muted mt-1">Every image and file here is available to use anywhere on the org site.</p>
  </div>
  <div class="flex gap-2">
    <button id="newFolderBtn" type="button" class="btn">{% icon "plus", "w-4 h-4" %} New folder</button>
    <button id="uploadBtn" type="button" class="btn btn-accent">{% icon "box", "w-4 h-4" %} Upload files</button>
  </div>
</div>

<input type="file" id="fileInput" multiple style="display:none">

<nav id="breadcrumb" class="mono text-xs text-muted mb-5 uppercase tracking-wider"></nav>

<div id="dropzone" class="rounded-2xl border-2 border-dashed p-4 mb-6 text-center text-sm text-muted transition" style="background:var(--paper-2);border-color:rgba(25,23,18,.3)">
  Drag files here, or use "Upload files" above
</div>

<p id="status" role="status" aria-live="polite" class="text-sm mb-4"></p>

<div id="bulkBar" class="hidden items-center gap-3 rounded-xl border-2 border-ink px-4 py-2.5 mb-4" style="background:var(--paper-2)">
  <span id="bulkCount" class="text-sm font-semibold"></span>
  <button type="button" id="bulkDeleteBtn" class="btn !py-1.5 !px-3 text-xs">{% icon "close", "w-3.5 h-3.5" %} Delete selected</button>
  <button type="button" id="bulkClearBtn" class="btn !py-1.5 !px-3 text-xs">Clear selection</button>
</div>

<div id="grid" class="grid gap-4" style="grid-template-columns:repeat(auto-fill,minmax(150px,1fr))"></div>

<script>
(function () {
  var grid = document.getElementById('grid');
  var breadcrumb = document.getElementById('breadcrumb');
  var status = document.getElementById('status');
  var dropzone = document.getElementById('dropzone');
  var fileInput = document.getElementById('fileInput');
  var prefix = '';

  function setStatus(msg, isError) {
    status.textContent = msg || '';
    status.style.color = isError ? 'var(--coral-ink)' : '';
  }

  function humanSize(bytes) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1024 * 1024) return Math.round(bytes / 1024) + ' KB';
    return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
  }

  function renderBreadcrumb() {
    var parts = prefix ? prefix.replace(/\/$/, '').split('/') : [];
    var html = '<a href="#" data-nav="" class="hover:underline">Media library</a>';
    var acc = '';
    parts.forEach(function (part) {
      acc += part + '/';
      html += ' <span class="mx-1 opacity-40">/</span> <a href="#" data-nav="' + acc + '" class="hover:underline">' + part + '</a>';
    });
    breadcrumb.innerHTML = html;
    breadcrumb.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        load(a.getAttribute('data-nav'));
      });
    });
  }

  function copyToClipboard(text, btn) {
    navigator.clipboard.writeText(location.origin + text).then(function () {
      var orig = btn.textContent;
      btn.textContent = 'Copied!';
      setTimeout(function () { btn.textContent = orig; }, 1200);
    });
  }

  function isImage(name) { return /\.(jpe?g|png|webp|gif|svg)$/i.test(name); }

  // Folder/file names go through innerHTML below. They're already
  // constrained today (folder names are regex-sanitised at creation, file
  // names are randomId-based, never the original uploaded filename) — this
  // is defense-in-depth so that stays true even if a later change starts
  // displaying real, unsanitised text here.
  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  function render(data) {
    grid.innerHTML = '';

    data.folders.forEach(function (name) {
      var isProtected = data.protectedByName && data.protectedByName[name];
      var card = document.createElement('div');
      card.className = 'card p-4 relative';
      card.innerHTML =
        '<button type="button" class="text-left w-full folder-open" style="cursor:pointer">' +
          '<div class="text-3xl mb-2">' + (isProtected ? '🔒' : '📁') + '</div>' +
          '<p class="font-semibold text-sm truncate">' + escapeHtml(name) + '</p>' +
        '</button>' +
        '<button type="button" class="btn !py-1.5 !px-2 !whitespace-normal !leading-snug text-center justify-center text-xs mt-2 w-full folder-protect" data-folder="' + escapeHtml(name) + '" data-protected="' + (isProtected ? '1' : '0') + '">' +
          (isProtected ? 'Sharing settings' : 'Password-protect & share') +
        '</button>' +
        '<button type="button" class="btn !py-1.5 !px-2 text-xs mt-1.5 w-full justify-center folder-delete" data-folder="' + escapeHtml(name) + '">Delete folder</button>';
      card.querySelector('.folder-open').addEventListener('click', function () { load(prefix + name + '/'); });
      grid.appendChild(card);
    });

    data.files.forEach(function (f) {
      var card = document.createElement('div');
      card.className = 'card p-3 flex flex-col gap-2 relative';
      var preview = isImage(f.name)
        ? '<img src="' + f.url + '" alt="" class="w-full h-24 object-cover rounded-lg border-2 border-ink">'
        : '<div class="w-full h-24 grid place-items-center rounded-lg border-2 border-ink text-3xl" style="background:var(--paper-2)">📄</div>';
      card.innerHTML =
        '<input type="checkbox" class="mark-check absolute top-2 left-2 z-10 w-5 h-5" data-key="' + f.key + '" aria-label="Mark ' + escapeHtml(f.name) + '">' +
        preview +
        '<p class="text-xs font-semibold truncate" title="' + escapeHtml(f.name) + '">' + escapeHtml(f.name) + '</p>' +
        '<p class="text-[11px] text-muted">' + humanSize(f.size) + '</p>' +
        '<div class="flex gap-1.5">' +
          '<button type="button" class="btn !py-1 !px-2 text-xs flex-1" data-copy="' + f.url + '">Copy URL</button>' +
          '<button type="button" class="btn !py-1 !px-2 text-xs" data-del="' + f.key + '" aria-label="Delete">🗑</button>' +
        '</div>';
      grid.appendChild(card);
    });

    grid.querySelectorAll('[data-copy]').forEach(function (btn) {
      btn.addEventListener('click', function () { copyToClipboard(btn.getAttribute('data-copy'), btn); });
    });
    grid.querySelectorAll('[data-del]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (!confirm('Delete this file? This cannot be undone.')) return;
        adminFetch('/api/admin/media', { method: 'POST', body: JSON.stringify({ action: 'delete', key: btn.getAttribute('data-del') }) })
          .then(function () { load(prefix); });
      });
    });
    grid.querySelectorAll('.mark-check').forEach(function (cb) {
      cb.addEventListener('change', updateBulkBar);
    });
    grid.querySelectorAll('.folder-protect').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var name = btn.getAttribute('data-folder');
        var already = btn.getAttribute('data-protected') === '1';
        if (already) {
          var action = confirm('This folder is already shared with a password.\n\nOK = set a new password\nCancel = remove password protection entirely');
          if (!action) {
            if (!confirm('Remove password protection from "' + name + '"? The share link will stop working.')) return;
            adminFetch('/api/admin/media', { method: 'POST', body: JSON.stringify({ action: 'unprotect-folder', prefix: prefix + name + '/' }) })
              .then(function () { load(prefix); });
            return;
          }
        }
        var pw = prompt('Set a password for "' + name + '" (visitors will use this + a link to view the files, no account needed):');
        if (!pw) return;
        if (pw.length < 6) { alert('Password must be at least 6 characters.'); return; }
        adminFetch('/api/admin/media', { method: 'POST', body: JSON.stringify({ action: 'protect-folder', prefix: prefix + name + '/', password: pw, label: name }) })
          .then(function (res) {
            if (!res.ok) { alert(res.data.error || 'Could not protect folder'); return; }
            prompt('Share this link (password: what you just set):', location.origin + res.data.shareUrl);
            load(prefix);
          });
      });
    });
    grid.querySelectorAll('.folder-delete').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var name = btn.getAttribute('data-folder');
        if (!confirm('Delete "' + name + '" and everything inside it? This cannot be undone.')) return;
        adminFetch('/api/admin/media', { method: 'POST', body: JSON.stringify({ action: 'delete-folder', prefix: prefix + name + '/' }) })
          .then(function (res) {
            if (!res.ok) { setStatus(res.data.error || 'Could not delete folder', true); return; }
            load(prefix);
          });
      });
    });

    if (!data.folders.length && !data.files.length) {
      grid.innerHTML = '<p class="text-muted text-sm col-span-full">Nothing here yet.</p>';
    }
    updateBulkBar();
  }

  var bulkBar = document.getElementById('bulkBar');
  var bulkCount = document.getElementById('bulkCount');
  function markedKeys() {
    return Array.prototype.slice.call(grid.querySelectorAll('.mark-check:checked')).map(function (cb) { return cb.getAttribute('data-key'); });
  }
  function updateBulkBar() {
    var n = markedKeys().length;
    bulkBar.classList.toggle('hidden', n === 0);
    bulkBar.classList.toggle('flex', n > 0);
    bulkCount.textContent = n + ' marked';
  }
  document.getElementById('bulkClearBtn').addEventListener('click', function () {
    grid.querySelectorAll('.mark-check:checked').forEach(function (cb) { cb.checked = false; });
    updateBulkBar();
  });
  document.getElementById('bulkDeleteBtn').addEventListener('click', function () {
    var keys = markedKeys();
    if (!keys.length) return;
    if (!confirm('Delete ' + keys.length + ' marked file(s)? This cannot be undone.')) return;
    adminFetch('/api/admin/media', { method: 'POST', body: JSON.stringify({ action: 'delete-many', keys: keys }) })
      .then(function () { load(prefix); });
  });

  function load(newPrefix) {
    prefix = newPrefix || '';
    setStatus('Loading…');
    adminFetch('/api/admin/media?prefix=' + encodeURIComponent(prefix)).then(function (res) {
      if (!res.ok) { setStatus(res.data.error || 'Failed to load', true); return; }
      setStatus('');
      renderBreadcrumb();
      render(res.data);
    });
  }

  document.getElementById('newFolderBtn').addEventListener('click', function () {
    var name = prompt('Folder name:');
    if (!name) return;
    adminFetch('/api/admin/media', { method: 'POST', body: JSON.stringify({ action: 'create-folder', prefix: prefix, name: name }) })
      .then(function (res) {
        if (!res.ok) { setStatus(res.data.error || 'Could not create folder', true); return; }
        load(prefix);
      });
  });

  function uploadFiles(fileList) {
    var files = Array.prototype.slice.call(fileList);
    if (!files.length) return;
    setStatus('Uploading ' + files.length + ' file' + (files.length > 1 ? 's' : '') + '…');
    Promise.all(files.map(function (file) {
      var fd = new FormData();
      fd.append('file', file);
      fd.append('folder', prefix);
      return adminFetch('/api/admin/upload', { method: 'POST', body: fd });
    })).then(function (results) {
      var failed = results.filter(function (r) { return !r.ok; });
      setStatus(failed.length ? (failed.length + ' file(s) failed to upload') : 'Done.', !!failed.length);
      load(prefix);
    });
  }

  document.getElementById('uploadBtn').addEventListener('click', function () { fileInput.click(); });
  fileInput.addEventListener('change', function () { uploadFiles(fileInput.files); fileInput.value = ''; });

  dropzone.addEventListener('dragover', function (e) { e.preventDefault(); dropzone.style.borderColor = 'var(--blue-ink)'; });
  dropzone.addEventListener('dragleave', function () { dropzone.style.borderColor = 'rgba(25,23,18,.3)'; });
  dropzone.addEventListener('drop', function (e) {
    e.preventDefault();
    dropzone.style.borderColor = 'rgba(25,23,18,.3)';
    uploadFiles(e.dataTransfer.files);
  });

  document.addEventListener('admin:ready', function () { load(''); });
})();
</script>
