---
layout: admin-base.njk
title: "DOTS Alumni"
permalink: /admin/dots-alumni/
---
<div class="flex flex-wrap items-center justify-between gap-4 mb-8">
  <div>
    <p class="eyebrow" style="color:var(--coral-ink)">Admin</p>
    <h1 class="h-sec mt-1">DOTS Alumni</h1>
    <p class="text-sm text-muted mt-1">Submissions come in from the public form at /dots/alumni/ — approve one to put it live.</p>
  </div>
</div>

<div id="formCard" class="card p-6 mb-8" hidden>
  <h2 class="h-card mb-4">Edit entry</h2>
  <form id="alumniForm" class="flex flex-col gap-5">
    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="form-label" for="f_edition">Edition</label>
        <input class="input" type="text" id="f_edition" name="edition" required>
        <p class="text-xs text-muted mt-1">Which DOTS cohort they took part in — not currently shown publicly, kept for your own records.</p>
      </div>
      <div>
        <label class="form-label" for="f_status">Status</label>
        <select class="input" id="f_status" name="status">
          <option value="pending">Pending</option>
          <option value="published">Published</option>
          <option value="rejected">Rejected</option>
        </select>
      </div>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="form-label" for="f_name">Name *</label>
        <input class="input" type="text" id="f_name" required maxlength="100">
      </div>
      <div>
        <label class="form-label" for="f_pronouns">Pronouns</label>
        <input class="input" type="text" id="f_pronouns" maxlength="30">
      </div>
    </div>

    <div>
      <p class="form-label">Photo</p>
      <input type="hidden" id="f_photo_url">
      <div id="photoEmpty">
        <label class="btn cursor-pointer inline-flex">📷 Add a photo<input type="file" id="photoFile" accept="image/jpeg,image/png,image/webp" class="sr-only"></label>
      </div>
      <div id="photoFilled" hidden class="flex items-center gap-3">
        <img id="photoPreview" src="" alt="" class="w-20 h-20 rounded-xl object-cover border-2 border-ink">
        <div class="flex gap-2">
          <label class="btn !py-1.5 !px-3 text-xs cursor-pointer inline-flex">Change<input type="file" id="photoFileChange" accept="image/jpeg,image/png,image/webp" class="sr-only"></label>
          <button type="button" id="photoRemoveBtn" class="btn btn-coral !py-1.5 !px-3 text-xs">Remove</button>
        </div>
      </div>
      <p id="photoStatus" role="status" aria-live="polite" class="text-xs mt-2 text-muted"></p>
    </div>

    <div>
      <label class="form-label" for="f_bio">Bio *</label>
      <textarea class="input" id="f_bio" rows="3" maxlength="600" required></textarea>
    </div>

    <div class="grid sm:grid-cols-2 gap-4">
      <div>
        <label class="form-label" for="f_role">What they're up to</label>
        <input class="input" type="text" id="f_role" maxlength="120">
      </div>
      <div>
        <label class="form-label" for="f_location">Based in</label>
        <input class="input" type="text" id="f_location" maxlength="80">
      </div>
    </div>

    <div>
      <label class="form-label" for="f_quote">Quote</label>
      <input class="input" type="text" id="f_quote" maxlength="300">
    </div>

    <div>
      <label class="form-label" for="f_story">Story (shown only on their individual page)</label>
      <textarea class="input" id="f_story" rows="5" maxlength="4000"></textarea>
    </div>

    <div>
      <p class="form-label">Links</p>
      <div class="flex flex-col gap-2 mt-1">
        <input class="input" type="text" id="f_instagram" placeholder="Instagram" maxlength="300">
        <input class="input" type="text" id="f_linkedin" placeholder="LinkedIn" maxlength="300">
        <input class="input" type="text" id="f_website" placeholder="Website" maxlength="300">
      </div>
    </div>

    <div>
      <p class="form-label">More photos</p>
      <input type="hidden" id="f_photos">
      <div id="extraPhotosGrid" class="grid grid-cols-3 sm:grid-cols-4 gap-2 mb-2"></div>
      <label id="addExtraPhotoBtn" class="btn !py-1.5 !px-3 text-xs cursor-pointer inline-flex">+ Add a photo<input type="file" id="extraPhotoFile" accept="image/jpeg,image/png,image/webp" class="sr-only"></label>
      <p id="extraPhotoStatus" role="status" aria-live="polite" class="text-xs mt-2 text-muted"></p>
    </div>

    <p id="formStatus" role="status" aria-live="polite" class="text-sm"></p>
    <div class="flex items-center gap-3 mt-1">
      <button type="submit" id="saveBtn" class="btn btn-accent">Save changes</button>
      <button type="button" id="cancelBtn" class="btn">Cancel</button>
    </div>
  </form>
</div>

<div class="card overflow-x-auto">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Photo</th>
        <th>Name</th>
        <th>Edition</th>
        <th>Bio</th>
        <th>Status</th>
        <th>Submitted</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="alumniTbody">
      <tr><td colspan="7" class="text-muted">Loading…</td></tr>
    </tbody>
  </table>
</div>
<p id="tableStatus" role="status" aria-live="polite" class="mt-3 text-sm"></p>

<div id="previewOverlay" style="display:none; position:fixed; inset:0; background:rgba(25,23,18,.6); z-index:100; overflow-y:auto;">
  <div style="max-width:56rem; margin:2.5rem auto; padding:0 1rem 3rem;">
    <div class="flex justify-end mb-3">
      <button type="button" id="previewCloseBtn" class="btn">{% icon "close", "w-4 h-4" %} Close preview</button>
    </div>
    <div class="rounded-2xl border-2 border-ink overflow-hidden" style="background:#fff">
      <div id="previewBody" style="max-width:52rem; margin:0 auto; padding:2.5rem 2rem 3rem;"></div>
    </div>
    <div class="flex items-center gap-3 mt-4 justify-center" id="previewActions"></div>
  </div>
</div>

<div id="cropModalOverlay" style="position:fixed;inset:0;background:rgba(25,23,18,.85);z-index:300;display:none;align-items:center;justify-content:center;padding:1rem">
  <div style="background:#fff;border:2px solid var(--ink);border-radius:1rem;box-shadow:8px 8px 0 var(--ink);max-width:26rem;width:100%;padding:1.5rem;max-height:92vh;overflow-y:auto">
    <h3 class="h-card mb-1">Move and scale</h3>
    <p class="text-xs text-muted mb-3">Drag to reposition, pinch or use the slider to zoom — or skip straight to automatic face detection.</p>
    <div id="cropFrame" style="position:relative;width:100%;aspect-ratio:1/1;overflow:hidden;border-radius:1rem;background:#191712;cursor:grab;touch-action:none">
      <canvas id="cropCanvas" style="position:absolute;top:0;left:0;width:100%;height:100%"></canvas>
      <div style="position:absolute;inset:0;pointer-events:none;border-radius:50%;box-shadow:0 0 0 9999px rgba(25,23,18,.72);outline:2px solid rgba(255,255,255,.9)"></div>
    </div>
    <div class="flex items-center gap-3 mt-4">
      <span class="text-xs text-muted mono" aria-hidden="true">–</span>
      <input type="range" id="cropZoom" min="1" max="3" step="0.01" value="1" style="flex:1" aria-label="Zoom">
      <span class="text-xs text-muted mono" aria-hidden="true">+</span>
    </div>
    <div class="flex flex-wrap gap-2 mt-4">
      <button type="button" id="cropUseRecommendedBtn" class="btn btn-accent">✨ Use recommended (automatic face detection)</button>
      <button type="button" id="cropSaveBtn" class="btn">Save this crop</button>
      <button type="button" id="cropCancelBtn" class="btn btn-coral">Cancel</button>
    </div>
    <p id="cropStatus" role="status" aria-live="polite" class="text-xs mt-2 text-muted"></p>
  </div>
</div>

<script>
(function () {
  var items = [];
  var editingId = null;
  var extraPhotos = [];
  var MAX_EXTRA_PHOTOS = 6;

  var formCard = document.getElementById('formCard');
  var form = document.getElementById('alumniForm');
  var saveBtn = document.getElementById('saveBtn');
  var cancelBtn = document.getElementById('cancelBtn');
  var formStatus = document.getElementById('formStatus');
  var tableStatus = document.getElementById('tableStatus');
  var tbody = document.getElementById('alumniTbody');

  var f_edition = document.getElementById('f_edition');
  var f_status = document.getElementById('f_status');

  function setFormStatus(msg, isError) {
    formStatus.textContent = msg || '';
    formStatus.style.color = isError ? 'var(--coral-ink)' : '';
  }

  function setTableStatus(msg, isError) {
    tableStatus.textContent = msg || '';
    tableStatus.style.color = isError ? 'var(--coral-ink)' : '';
  }

  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]; }); }
  function safeParse(str, fallback) { try { return JSON.parse(str || 'null') || fallback; } catch (e) { return fallback; } }

  function uploadAdminImage(file, onDone) {
    var fd = new FormData();
    fd.append('file', file);
    adminFetch('/api/admin/upload', { method: 'POST', body: fd }).then(function (r) {
      onDone(r.ok ? r.data.url : null, r.ok ? null : (r.data && r.data.error));
    });
  }

  // --- Crop / reposition modal (mirrors src/dots/alumni-submit.njk's --
  // same reasoning: "recommended" just keeps the already-uploaded
  // original, since every photo display already runs it through
  // Cloudflare's automatic face-aware crop; "Save this crop" renders the
  // current pan/zoom and uploads that as a new file instead.) -----------
  (function () {
    var overlay = document.getElementById('cropModalOverlay');
    var frame = document.getElementById('cropFrame');
    var canvas = document.getElementById('cropCanvas');
    var ctx = canvas.getContext('2d');
    var zoomSlider = document.getElementById('cropZoom');
    var useRecommendedBtn = document.getElementById('cropUseRecommendedBtn');
    var saveBtn = document.getElementById('cropSaveBtn');
    var cancelBtn = document.getElementById('cropCancelBtn');
    var cropStatus = document.getElementById('cropStatus');

    var img = null, coverScale = 1, scale = 1, offsetX = 0, offsetY = 0;
    var activeOriginalUrl = null, activeOnDone = null;
    var OUT_W = 960, OUT_H = 960;

    // See src/dots/alumni-submit.njk's identical crop modal for the
    // reasoning behind pinch-tracking two simultaneous pointers -- kept
    // in sync here since this codebase duplicates the modal rather than
    // sharing a module between the participant and staff editors.
    var pointers = {};
    var panFrom = null;
    var pinchFrom = null;

    function frameSize() {
      var rect = frame.getBoundingClientRect();
      return { w: rect.width, h: rect.height };
    }

    function minScale() { return coverScale; }
    function maxScale() { return coverScale * 3; }

    function clampOffsets() {
      var fs = frameSize();
      var iw = img.naturalWidth * scale, ih = img.naturalHeight * scale;
      offsetX = Math.min(0, Math.max(fs.w - iw, offsetX));
      offsetY = Math.min(0, Math.max(fs.h - ih, offsetY));
    }

    function draw() {
      var fs = frameSize();
      var dpr = window.devicePixelRatio || 1;
      canvas.width = fs.w * dpr;
      canvas.height = fs.h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, fs.w, fs.h);
      if (!img) return;
      ctx.drawImage(img, offsetX, offsetY, img.naturalWidth * scale, img.naturalHeight * scale);
    }

    function pointerDist(ids) {
      var a = pointers[ids[0]], b = pointers[ids[1]];
      return Math.hypot(a.x - b.x, a.y - b.y);
    }
    function pointerMid(ids) {
      var a = pointers[ids[0]], b = pointers[ids[1]];
      return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
    }

    function setZoomFromScale() {
      zoomSlider.value = String(scale / coverScale);
    }

    frame.addEventListener('pointerdown', function (e) {
      if (!img) return;
      frame.setPointerCapture(e.pointerId);
      pointers[e.pointerId] = { x: e.clientX, y: e.clientY };
      var ids = Object.keys(pointers);
      if (ids.length === 1) {
        panFrom = { x: e.clientX, y: e.clientY, offsetX: offsetX, offsetY: offsetY };
        frame.style.cursor = 'grabbing';
      } else if (ids.length === 2) {
        panFrom = null;
        pinchFrom = { dist: pointerDist(ids), scale: scale };
      }
    });
    frame.addEventListener('pointermove', function (e) {
      if (!pointers[e.pointerId] || !img) return;
      pointers[e.pointerId] = { x: e.clientX, y: e.clientY };
      var ids = Object.keys(pointers);
      if (ids.length === 2 && pinchFrom) {
        var rect = frame.getBoundingClientRect();
        var mid = pointerMid(ids);
        var localX = mid.x - rect.left, localY = mid.y - rect.top;
        var newScale = Math.min(maxScale(), Math.max(minScale(), pinchFrom.scale * (pointerDist(ids) / pinchFrom.dist)));
        var ratio = newScale / scale;
        offsetX = localX - (localX - offsetX) * ratio;
        offsetY = localY - (localY - offsetY) * ratio;
        scale = newScale;
        setZoomFromScale();
        clampOffsets();
        draw();
      } else if (ids.length === 1 && panFrom) {
        offsetX = panFrom.offsetX + (e.clientX - panFrom.x);
        offsetY = panFrom.offsetY + (e.clientY - panFrom.y);
        clampOffsets();
        draw();
      }
    });
    function releasePointer(e) {
      delete pointers[e.pointerId];
      var ids = Object.keys(pointers);
      pinchFrom = null;
      if (ids.length === 1) {
        var p = pointers[ids[0]];
        panFrom = { x: p.x, y: p.y, offsetX: offsetX, offsetY: offsetY };
      } else {
        panFrom = null;
      }
      if (!ids.length) frame.style.cursor = 'grab';
    }
    ['pointerup', 'pointercancel', 'pointerleave'].forEach(function (evt) {
      frame.addEventListener(evt, releasePointer);
    });

    zoomSlider.addEventListener('input', function () {
      if (!img) return;
      var fs = frameSize();
      var cx = fs.w / 2, cy = fs.h / 2;
      var prevScale = scale;
      scale = coverScale * Number(zoomSlider.value);
      var ratio = scale / prevScale;
      offsetX = cx - (cx - offsetX) * ratio;
      offsetY = cy - (cy - offsetY) * ratio;
      clampOffsets();
      draw();
    });

    function loadImage(url) {
      cropStatus.textContent = '';
      cropStatus.style.color = '';
      img = null;
      var el = new Image();
      el.onload = function () {
        img = el;
        var fs = frameSize();
        coverScale = Math.max(fs.w / img.naturalWidth, fs.h / img.naturalHeight);
        scale = coverScale;
        zoomSlider.value = '1';
        offsetX = (fs.w - img.naturalWidth * scale) / 2;
        offsetY = (fs.h - img.naturalHeight * scale) / 2;
        draw();
      };
      el.onerror = function () {
        cropStatus.style.color = 'var(--coral-ink)';
        cropStatus.textContent = "Couldn't load that image for cropping — try again.";
      };
      el.src = url;
    }

    window.openCropModal = function (originalUrl, onDone) {
      activeOriginalUrl = originalUrl;
      activeOnDone = onDone;
      overlay.style.display = 'flex';
      loadImage(originalUrl);
    };

    function close() {
      overlay.style.display = 'none';
      img = null;
      activeOriginalUrl = null;
      activeOnDone = null;
    }

    cancelBtn.addEventListener('click', close);
    overlay.addEventListener('click', function (e) { if (e.target === overlay) close(); });

    useRecommendedBtn.addEventListener('click', function () {
      var onDone = activeOnDone;
      var url = activeOriginalUrl;
      close();
      if (onDone) onDone(url);
    });

    saveBtn.addEventListener('click', function () {
      if (!img) return;
      saveBtn.disabled = true;
      cropStatus.style.color = '';
      cropStatus.textContent = 'Saving your crop…';

      var out = document.createElement('canvas');
      out.width = OUT_W; out.height = OUT_H;
      var octx = out.getContext('2d');
      var fs = frameSize();
      var sx = OUT_W / fs.w, sy = OUT_H / fs.h;
      octx.drawImage(img, offsetX * sx, offsetY * sy, img.naturalWidth * scale * sx, img.naturalHeight * scale * sy);

      out.toBlob(function (blob) {
        if (!blob) {
          saveBtn.disabled = false;
          cropStatus.style.color = 'var(--coral-ink)';
          cropStatus.textContent = "Couldn't process that crop — try again.";
          return;
        }
        var file = new File([blob], 'cropped.jpg', { type: 'image/jpeg' });
        var onDone = activeOnDone;
        uploadAdminImage(file, function (url, err) {
          saveBtn.disabled = false;
          if (!url) {
            cropStatus.style.color = 'var(--coral-ink)';
            cropStatus.textContent = err || 'Upload failed — try again.';
            return;
          }
          close();
          if (onDone) onDone(url);
        });
      }, 'image/jpeg', 0.9);
    });
  })();

  // --- Main photo -------------------------------------------------------
  var f_photo_url = document.getElementById('f_photo_url');
  var photoEmpty = document.getElementById('photoEmpty');
  var photoFilled = document.getElementById('photoFilled');
  var photoPreview = document.getElementById('photoPreview');
  var photoStatus = document.getElementById('photoStatus');

  function setPhoto(url) {
    f_photo_url.value = url || '';
    if (url) {
      photoPreview.src = url;
      photoEmpty.hidden = true;
      photoFilled.hidden = false;
    } else {
      photoEmpty.hidden = false;
      photoFilled.hidden = true;
    }
  }

  function handlePhotoFile(file) {
    if (!file) return;
    photoStatus.style.color = '';
    photoStatus.textContent = 'Uploading…';
    uploadAdminImage(file, function (url, err) {
      if (!url) {
        photoStatus.style.color = 'var(--coral-ink)';
        photoStatus.textContent = err || 'Upload failed — try again.';
        return;
      }
      photoStatus.textContent = '';
      window.openCropModal(url, function (finalUrl) { setPhoto(finalUrl); });
    });
  }

  document.getElementById('photoFile').addEventListener('change', function (e) { handlePhotoFile(e.target.files[0]); e.target.value = ''; });
  document.getElementById('photoFileChange').addEventListener('change', function (e) { handlePhotoFile(e.target.files[0]); e.target.value = ''; });
  document.getElementById('photoRemoveBtn').addEventListener('click', function () { setPhoto(''); });

  // --- Extra photos -------------------------------------------------------
  var extraPhotosGrid = document.getElementById('extraPhotosGrid');
  var f_photos = document.getElementById('f_photos');
  var extraPhotoStatus = document.getElementById('extraPhotoStatus');
  var addExtraPhotoBtn = document.getElementById('addExtraPhotoBtn');

  function renderExtraPhotos() {
    extraPhotosGrid.innerHTML = '';
    extraPhotos.forEach(function (url, i) {
      var wrap = document.createElement('div');
      wrap.style.cssText = 'position:relative';
      var img = document.createElement('img');
      img.src = url;
      img.alt = '';
      img.className = 'w-full aspect-square object-cover rounded-lg border-2 border-ink';
      var rm = document.createElement('button');
      rm.type = 'button';
      rm.textContent = '×';
      rm.setAttribute('aria-label', 'Remove this photo');
      rm.style.cssText = 'position:absolute;top:-.4rem;right:-.4rem;width:1.5rem;height:1.5rem;border-radius:999px;background:var(--coral);border:2px solid var(--ink);font-weight:700;line-height:1';
      rm.addEventListener('click', function () { extraPhotos.splice(i, 1); renderExtraPhotos(); });
      wrap.appendChild(img);
      wrap.appendChild(rm);
      extraPhotosGrid.appendChild(wrap);
    });
    f_photos.value = JSON.stringify(extraPhotos);
    addExtraPhotoBtn.style.display = extraPhotos.length >= MAX_EXTRA_PHOTOS ? 'none' : '';
  }

  document.getElementById('extraPhotoFile').addEventListener('change', function (e) {
    var file = e.target.files[0];
    e.target.value = '';
    if (!file || extraPhotos.length >= MAX_EXTRA_PHOTOS) return;
    extraPhotoStatus.style.color = '';
    extraPhotoStatus.textContent = 'Uploading…';
    uploadAdminImage(file, function (url, err) {
      extraPhotoStatus.textContent = '';
      if (!url) {
        extraPhotoStatus.style.color = 'var(--coral-ink)';
        extraPhotoStatus.textContent = err || 'Upload failed — try again.';
        return;
      }
      extraPhotos.push(url);
      renderExtraPhotos();
    });
  });

  function showForm(item) {
    form.reset();
    setFormStatus('');
    editingId = item.id;
    f_edition.value = item.edition || '';
    f_status.value = item.status || 'pending';
    document.getElementById('f_name').value = item.name || '';
    document.getElementById('f_pronouns').value = item.pronouns || '';
    document.getElementById('f_bio').value = item.bio || '';
    document.getElementById('f_role').value = item.current_role || '';
    document.getElementById('f_location').value = item.location || '';
    document.getElementById('f_quote').value = item.quote || '';
    document.getElementById('f_story').value = item.story || '';
    setPhoto(item.photo_url || '');
    var links = safeParse(item.links_json, []);
    document.getElementById('f_instagram').value = (links.find(function (l) { return l.label === 'Instagram'; }) || {}).url || '';
    document.getElementById('f_linkedin').value = (links.find(function (l) { return l.label === 'LinkedIn'; }) || {}).url || '';
    document.getElementById('f_website').value = (links.find(function (l) { return l.label === 'Website'; }) || {}).url || '';
    extraPhotos = safeParse(item.photos_json, []).slice(0, MAX_EXTRA_PHOTOS);
    renderExtraPhotos();

    formCard.hidden = false;
    formCard.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function hideForm() {
    formCard.hidden = true;
    form.reset();
    editingId = null;
    extraPhotos = [];
    setFormStatus('');
  }

  function formatDate(value) {
    if (!value) return '—';
    var d = new Date(value);
    if (isNaN(d.getTime())) return '—';
    return d.toLocaleDateString();
  }

  function statusColor(status) {
    if (status === 'published') return 'var(--mint)';
    if (status === 'rejected') return 'var(--coral-ink)';
    return 'var(--paper-2)';
  }

  // Renders the same shape as the real public page's fixed-fields layout
  // (src/dots/alumni-profile.njk's legacy-fields branch) so staff can see
  // roughly what a submission will look like before it's ever built into
  // a static page. An entry created through the since-retired
  // drag-and-drop builder may still have a richer blocks_json -- this
  // preview only shows the flat fields, which is exactly what any new
  // edit through this form saves going forward.
  function renderPreview(item) {
    var html = '<h1 class="h-hero">' + esc(item.name) + (item.pronouns ? ' <span class="text-muted" style="font-size:.55em">(' + esc(item.pronouns) + ')</span>' : '') + '</h1>';
    if (item.photo_url) html += '<img src="' + esc(item.photo_url) + '" alt="" style="width:100%;max-height:22rem;object-fit:cover;border-radius:1rem;border:2px solid var(--ink);margin:1rem 0">';
    if (item.current_role) html += '<p class="mt-2 text-lg font-semibold">' + esc(item.current_role) + '</p>';
    if (item.location) html += '<p class="text-sm text-muted">' + esc(item.location) + '</p>';
    html += '<p class="mt-4 text-lg text-muted leading-relaxed">' + esc(item.bio) + '</p>';
    if (item.quote) html += '<blockquote class="card p-4 mt-4" style="border-left:4px solid var(--coral-ink)">“' + esc(item.quote) + '”</blockquote>';
    var links = safeParse(item.links_json, []);
    if (links.length) {
      html += '<div class="flex flex-wrap gap-3 mt-4">';
      links.forEach(function (l) { html += '<span class="btn" style="pointer-events:none">' + esc(l.label) + '</span>'; });
      html += '</div>';
    }
    if (item.story) html += '<div class="card p-6 mt-6"><h2 class="h-card mb-2">Their story</h2><p class="text-muted leading-relaxed" style="white-space:pre-line">' + esc(item.story) + '</p></div>';
    var photos = safeParse(item.photos_json, []);
    if (photos.length) {
      html += '<div class="mt-6"><h2 class="h-card mb-3">More photos</h2><div class="grid gap-3" style="grid-template-columns:repeat(auto-fill,minmax(8rem,1fr))">';
      photos.forEach(function (url) { html += '<img src="' + esc(url) + '" alt="" style="width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:.5rem;border:2px solid var(--ink)">'; });
      html += '</div></div>';
    }
    return html;
  }

  var previewOverlay = document.getElementById('previewOverlay');
  var previewBody = document.getElementById('previewBody');
  var previewActions = document.getElementById('previewActions');
  var previewCloseBtn = document.getElementById('previewCloseBtn');

  function openPreview(item) {
    previewBody.innerHTML = renderPreview(item);
    previewActions.innerHTML = '';
    if (item.status !== 'published') {
      var approveBtn = document.createElement('button');
      approveBtn.type = 'button';
      approveBtn.className = 'btn btn-accent';
      approveBtn.textContent = 'Approve';
      approveBtn.addEventListener('click', function () {
        setStatus(item.id, 'published', approveBtn);
        closePreview();
      });
      previewActions.appendChild(approveBtn);
    }
    var editFromPreviewBtn = document.createElement('button');
    editFromPreviewBtn.type = 'button';
    editFromPreviewBtn.className = 'btn';
    editFromPreviewBtn.textContent = 'Edit';
    editFromPreviewBtn.addEventListener('click', function () { closePreview(); showForm(item); });
    previewActions.appendChild(editFromPreviewBtn);

    previewOverlay.style.display = 'block';
  }

  function closePreview() {
    previewOverlay.style.display = 'none';
    previewBody.innerHTML = '';
  }

  previewCloseBtn.addEventListener('click', closePreview);
  previewOverlay.addEventListener('click', function (e) {
    if (e.target === previewOverlay) closePreview();
  });

  function render() {
    if (!items.length) {
      tbody.innerHTML = '<tr><td colspan="7" class="text-muted">No submissions yet.</td></tr>';
      return;
    }
    tbody.innerHTML = '';
    items.forEach(function (item) {
      var tr = document.createElement('tr');

      var tdPhoto = document.createElement('td');
      var img = document.createElement('img');
      img.src = item.photo_url;
      img.alt = '';
      img.style.cssText = 'width:2.5rem;height:2.5rem;border-radius:.5rem;object-fit:cover;border:1px solid rgba(25,23,18,.2)';
      tdPhoto.appendChild(img);
      tr.appendChild(tdPhoto);

      var tdName = document.createElement('td');
      tdName.textContent = item.name;
      tr.appendChild(tdName);

      var tdEdition = document.createElement('td');
      tdEdition.textContent = item.edition;
      tr.appendChild(tdEdition);

      var tdBio = document.createElement('td');
      tdBio.textContent = (item.bio || '').length > 80 ? item.bio.slice(0, 80) + '…' : item.bio;
      tdBio.className = 'text-sm text-muted';
      tr.appendChild(tdBio);

      var tdStatus = document.createElement('td');
      var tag = document.createElement('span');
      tag.className = 'tag';
      tag.textContent = item.status;
      tag.style.background = statusColor(item.status);
      tdStatus.appendChild(tag);
      tr.appendChild(tdStatus);

      var tdSubmitted = document.createElement('td');
      tdSubmitted.textContent = formatDate(item.submitted_at);
      tr.appendChild(tdSubmitted);

      var tdActions = document.createElement('td');
      tdActions.style.whiteSpace = 'nowrap';

      var previewBtn = document.createElement('button');
      previewBtn.type = 'button';
      previewBtn.className = 'btn !py-1.5 !px-3 text-xs';
      previewBtn.textContent = 'Preview';
      previewBtn.addEventListener('click', function () { openPreview(item); });
      tdActions.appendChild(previewBtn);

      if (item.status !== 'published') {
        var approveBtn = document.createElement('button');
        approveBtn.type = 'button';
        approveBtn.className = 'btn btn-accent !py-1.5 !px-3 text-xs ml-2';
        approveBtn.textContent = 'Approve';
        approveBtn.addEventListener('click', function () { setStatus(item.id, 'published', approveBtn); });
        tdActions.appendChild(approveBtn);
      }

      var editBtn = document.createElement('button');
      editBtn.type = 'button';
      editBtn.className = 'btn !py-1.5 !px-3 text-xs ml-2';
      editBtn.textContent = 'Edit';
      editBtn.addEventListener('click', function () { showForm(item); });
      tdActions.appendChild(editBtn);

      var delBtn = document.createElement('button');
      delBtn.type = 'button';
      delBtn.className = 'btn btn-coral !py-1.5 !px-3 text-xs ml-2';
      delBtn.textContent = 'Delete';
      delBtn.addEventListener('click', function () { deleteItem(item.id, item.name, delBtn); });
      tdActions.appendChild(delBtn);

      tr.appendChild(tdActions);
      tbody.appendChild(tr);
    });
  }

  function load() {
    setTableStatus('');
    adminFetch('/api/admin/dots-alumni').then(function (r) {
      if (!r.ok) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-muted">Could not load submissions.</td></tr>';
        setTableStatus(r.data && r.data.error ? r.data.error : 'Failed to load submissions.', true);
        return;
      }
      items = r.data.items || [];
      render();
    });
  }

  function setStatus(id, status, btn) {
    if (btn) btn.disabled = true;
    setTableStatus('');
    adminFetch('/api/admin/dots-alumni/' + id, { method: 'PUT', body: JSON.stringify({ status: status }) }).then(function (r) {
      if (!r.ok) {
        if (btn) btn.disabled = false;
        setTableStatus(r.data && r.data.error ? r.data.error : 'Failed to update.', true);
        return;
      }
      load();
    });
  }

  function deleteItem(id, name, btn) {
    confirmDialog('Delete "' + name + '"? This cannot be undone.', 'Delete').then(function (ok) {
      if (!ok) return;
      btn.disabled = true;
      setTableStatus('');
      adminFetch('/api/admin/dots-alumni/' + id, { method: 'DELETE' }).then(function (r) {
        if (!r.ok) {
          btn.disabled = false;
          setTableStatus(r.data && r.data.error ? r.data.error : 'Failed to delete.', true);
          return;
        }
        load();
      });
    });
  }

  cancelBtn.addEventListener('click', hideForm);

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (!editingId) return;

    var name = document.getElementById('f_name').value.trim();
    var bio = document.getElementById('f_bio').value.trim();
    if (!name || !bio) {
      setFormStatus('Name and bio are both required.', true);
      return;
    }

    var links = [];
    var ig = document.getElementById('f_instagram').value.trim();
    var li = document.getElementById('f_linkedin').value.trim();
    var web = document.getElementById('f_website').value.trim();
    if (ig) links.push({ label: 'Instagram', url: ig });
    if (li) links.push({ label: 'LinkedIn', url: li });
    if (web) links.push({ label: 'Website', url: web });

    var body = {
      edition: f_edition.value.trim(),
      status: f_status.value,
      name: name,
      pronouns: document.getElementById('f_pronouns').value.trim() || null,
      current_role: document.getElementById('f_role').value.trim() || null,
      location: document.getElementById('f_location').value.trim() || null,
      quote: document.getElementById('f_quote').value.trim() || null,
      bio: bio,
      story: document.getElementById('f_story').value.trim() || null,
      photoUrl: f_photo_url.value || '',
      photos_json: JSON.stringify(extraPhotos),
      links_json: JSON.stringify(links),
      // The drag-and-drop page builder that used to populate this column
      // is retired -- any edit through this form is flat-fields-only from
      // here on, so an old entry's stale block order can't linger and
      // keep rendering on the public page after staff have just edited
      // its plain fields (see the "unified" branch in src/dots/alumni-profile.njk).
      blocks_json: null,
    };

    saveBtn.disabled = true;
    setFormStatus('Saving…', false);

    adminFetch('/api/admin/dots-alumni/' + editingId, { method: 'PUT', body: JSON.stringify(body) }).then(function (r) {
      saveBtn.disabled = false;
      if (!r.ok) {
        setFormStatus(r.data && r.data.error ? r.data.error : 'Something went wrong.', true);
        return;
      }
      hideForm();
      setTableStatus('Saved.');
      load();
    });
  });

  document.addEventListener('admin:ready', function () {
    load();
  });
})();
</script>
