---
layout: admin-base.njk
title: "DOTS"
permalink: /admin/dots/
---
<div class="flex flex-wrap items-center justify-between gap-4 mb-6">
  <div>
    <p class="eyebrow" style="color:var(--coral-ink)">Admin</p>
    <h1 class="h-sec mt-1">DOTS</h1>
    <p class="text-sm text-muted mt-1">Everything for the DOTS alumni gallery in one place — submissions, participant-requested changes, and access codes.</p>
  </div>
</div>

<div class="flex flex-wrap gap-2 mb-6" id="dotsTabs" role="tablist">
  <button type="button" class="dots-tab" data-tab="alumni" role="tab">Alumni</button>
  <button type="button" class="dots-tab" data-tab="edits" role="tab">Edit requests <span id="editsCountBadge" class="tag" style="background:var(--coral);margin-left:.35rem" hidden>0</span></button>
  <button type="button" class="dots-tab" data-tab="codes" role="tab">Access codes</button>
</div>

<div id="panel-alumni" class="dots-panel" hidden>
<p class="text-sm text-muted mb-6">Submissions come in from the public form at /dots/alumni/ — approve one to put it live. The whole page — name, photo, bio, everything — is one reorderable block list here, same as what participants see.</p>

<div id="formCard" class="card p-6 mb-8" hidden>
  <h2 class="h-card mb-4">Edit entry</h2>
  <form id="alumniForm" class="flex flex-col gap-3">
    <div class="grid sm:grid-cols-2 gap-4 mb-2">
      <div>
        <label class="form-label" for="f_edition">Edition</label>
        <input class="input" type="text" id="f_edition" name="edition" required>
        <p class="text-xs text-muted mt-1">Which DOTS cohort they took part in — not currently shown publicly, kept for your own records.</p>
      </div>
      <div>
        <label class="form-label" for="f_status">Status</label>
        <select class="input" id="f_status" name="status">
          <option value="pending">Pending</option>
          <option value="published">Published</option>
          <option value="rejected">Rejected</option>
        </select>
      </div>
    </div>

    <div class="rounded-xl border-2 p-4 mb-1" style="background:var(--paper-2);border-color:var(--ink)">
      <label class="form-label" for="f_slug">Page address</label>
      <div class="flex items-center gap-1 flex-wrap mt-1">
        <span class="text-xs text-muted mono">elysium.ngo/dots/alumni/</span>
        <input class="input" style="width:auto;flex:1;min-width:7rem;padding-top:.4rem;padding-bottom:.4rem" type="text" id="f_slug" maxlength="60" autocomplete="off">
        <span class="text-xs text-muted mono">/</span>
      </div>
    </div>

    <p class="text-xs text-muted mb-1">The whole page, one section at a time — drag to reorder anything. Name, photo, and bio are required and can't be removed entirely, only edited and repositioned. Everything else is optional.</p>
    <div id="blocksList" class="flex flex-col gap-3 mb-2"></div>

    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
      <button type="button" class="rounded-xl border-2 border-ink p-3 text-left transition hover:-translate-y-0.5" style="background:#fff" data-add="quote">
        <span class="block font-semibold text-sm">+ Quote</span>
        <span class="block text-xs text-muted mt-0.5">A line of advice or a memory</span>
      </button>
      <button type="button" class="rounded-xl border-2 border-ink p-3 text-left transition hover:-translate-y-0.5" style="background:#fff" data-add="subtitle">
        <span class="block font-semibold text-sm">+ What &amp; where</span>
        <span class="block text-xs text-muted mt-0.5">What they're up to, where they're based</span>
      </button>
      <button type="button" class="rounded-xl border-2 border-ink p-3 text-left transition hover:-translate-y-0.5" style="background:#fff" data-add="links">
        <span class="block font-semibold text-sm">+ Links</span>
        <span class="block text-xs text-muted mt-0.5">Instagram, LinkedIn, website</span>
      </button>
      <button type="button" class="rounded-xl border-2 border-ink p-3 text-left transition hover:-translate-y-0.5" style="background:#fff" data-add="heading">
        <span class="block font-semibold text-sm">+ Heading</span>
        <span class="block text-xs text-muted mt-0.5">A short section title</span>
      </button>
      <button type="button" class="rounded-xl border-2 border-ink p-3 text-left transition hover:-translate-y-0.5" style="background:#fff" data-add="paragraph">
        <span class="block font-semibold text-sm">+ Text</span>
        <span class="block text-xs text-muted mt-0.5">A paragraph of writing</span>
      </button>
      <button type="button" class="rounded-xl border-2 border-ink p-3 text-left transition hover:-translate-y-0.5" style="background:#fff" data-add="image">
        <span class="block font-semibold text-sm">+ Image</span>
        <span class="block text-xs text-muted mt-0.5">One photo, with a caption</span>
      </button>
      <button type="button" class="rounded-xl border-2 border-ink p-3 text-left transition hover:-translate-y-0.5" style="background:#fff" data-add="gallery">
        <span class="block font-semibold text-sm">+ Gallery</span>
        <span class="block text-xs text-muted mt-0.5">A grid of several photos</span>
      </button>
      <button type="button" class="rounded-xl border-2 border-ink p-3 text-left transition hover:-translate-y-0.5" style="background:#fff" data-add="button">
        <span class="block font-semibold text-sm">+ Button</span>
        <span class="block text-xs text-muted mt-0.5">A clickable link, e.g. to their website</span>
      </button>
      <button type="button" class="rounded-xl border-2 border-ink p-3 text-left transition hover:-translate-y-0.5" style="background:#fff" data-add="spacer">
        <span class="block font-semibold text-sm">+ Spacer</span>
        <span class="block text-xs text-muted mt-0.5">Blank space between sections</span>
      </button>
    </div>

    <p id="formStatus" role="status" aria-live="polite" class="text-sm"></p>
    <div class="flex items-center gap-3 mt-1">
      <button type="submit" id="saveBtn" class="btn btn-accent">Save changes</button>
      <button type="button" id="cancelBtn" class="btn">Cancel</button>
    </div>
  </form>
</div>

<div class="card overflow-x-auto">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Photo</th>
        <th>Name</th>
        <th>Edition</th>
        <th>Bio</th>
        <th>Status</th>
        <th>Submitted</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="alumniTbody">
      <tr><td colspan="7" class="text-muted">Loading…</td></tr>
    </tbody>
  </table>
</div>
<p id="tableStatus" role="status" aria-live="polite" class="mt-3 text-sm"></p>

<div id="previewOverlay" style="display:none; position:fixed; inset:0; background:rgba(25,23,18,.6); z-index:100; overflow-y:auto;">
  <div style="max-width:56rem; margin:2.5rem auto; padding:0 1rem 3rem;">
    <div class="flex justify-end mb-3">
      <button type="button" id="previewCloseBtn" class="btn">{% icon "close", "w-4 h-4" %} Close preview</button>
    </div>
    <div class="rounded-2xl border-2 border-ink overflow-hidden" style="background:#fff">
      <div id="previewBody" style="max-width:52rem; margin:0 auto; padding:2.5rem 2rem 3rem;"></div>
    </div>
    <div class="flex items-center gap-3 mt-4 justify-center" id="previewActions"></div>
  </div>
</div>

<div id="cropModalOverlay" style="position:fixed;inset:0;background:rgba(25,23,18,.85);z-index:300;display:none;align-items:center;justify-content:center;padding:1rem">
  <div style="background:#fff;border:2px solid var(--ink);border-radius:1rem;box-shadow:8px 8px 0 var(--ink);max-width:26rem;width:100%;padding:1.5rem;max-height:92vh;overflow-y:auto">
    <h3 class="h-card mb-1">Move and scale</h3>
    <p class="text-xs text-muted mb-3">Drag to reposition, pinch or use the slider to zoom — or skip straight to automatic face detection.</p>
    <div id="cropFrame" style="position:relative;width:100%;aspect-ratio:1/1;overflow:hidden;border-radius:1rem;background:#191712;cursor:grab;touch-action:none">
      <canvas id="cropCanvas" style="position:absolute;top:0;left:0;width:100%;height:100%"></canvas>
      <div style="position:absolute;inset:0;pointer-events:none;border-radius:50%;box-shadow:0 0 0 9999px rgba(25,23,18,.72);outline:2px solid rgba(255,255,255,.9)"></div>
    </div>
    <div class="flex items-center gap-3 mt-4">
      <span class="text-xs text-muted mono" aria-hidden="true">–</span>
      <input type="range" id="cropZoom" min="1" max="3" step="0.01" value="1" style="flex:1" aria-label="Zoom">
      <span class="text-xs text-muted mono" aria-hidden="true">+</span>
    </div>
    <div class="flex flex-wrap gap-2 mt-4">
      <button type="button" id="cropUseRecommendedBtn" class="btn btn-accent">✨ Use recommended (automatic face detection)</button>
      <button type="button" id="cropSaveBtn" class="btn">Save this crop</button>
      <button type="button" id="cropCancelBtn" class="btn btn-coral">Cancel</button>
    </div>
    <p id="cropStatus" role="status" aria-live="polite" class="text-xs mt-2 text-muted"></p>
  </div>
</div>

<script>
(function () {
  var items = [];
  var editingId = null;
  var blocks = [];
  var REQUIRED_TYPES = { name: true, photo: true, bio: true };

  var formCard = document.getElementById('formCard');
  var form = document.getElementById('alumniForm');
  var saveBtn = document.getElementById('saveBtn');
  var cancelBtn = document.getElementById('cancelBtn');
  var formStatus = document.getElementById('formStatus');
  var tableStatus = document.getElementById('tableStatus');
  var tbody = document.getElementById('alumniTbody');

  var f_edition = document.getElementById('f_edition');
  var f_status = document.getElementById('f_status');

  function setFormStatus(msg, isError) {
    formStatus.textContent = msg || '';
    formStatus.style.color = isError ? 'var(--coral-ink)' : '';
  }

  function setTableStatus(msg, isError) {
    tableStatus.textContent = msg || '';
    tableStatus.style.color = isError ? 'var(--coral-ink)' : '';
  }

  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]; }); }
  function safeParse(str, fallback) { try { return JSON.parse(str || 'null') || fallback; } catch (e) { return fallback; } }

  // --- Block builder (same widget shapes as the public form/back end;
  // see functions/_lib/dotsBlocks.js) -- name/photo/bio are required
  // block types, always present, not removable but freely reorderable,
  // same as the participant-facing form. Staff uploads go through the
  // generic admin upload endpoint since staff don't have a participant
  // access code. ---------------------------------------------------------
  var blocksList = document.getElementById('blocksList');

  function uid() { return 'b' + Math.random().toString(36).slice(2, 10); }

  // Pointer-Events-based reordering (mouse + touch) -- see the identical
  // helper in src/dots/alumni-submit.njk for why this replaced the old
  // HTML5 Drag and Drop API implementation (it never fired on touch
  // devices at all).
  function makeHandleDraggable(handle, card) {
    // pointerdown attaches move/up listeners to `document`, not `handle` --
    // relying on setPointerCapture alone to keep receiving events once the
    // cursor leaves the handle's own small hit area isn't reliable in real
    // use. Listening on the document guarantees pointermove keeps firing
    // regardless of what's physically under the cursor.
    handle.style.touchAction = 'none';
    handle.style.webkitTouchCallout = 'none';
    handle.style.cursor = 'grab';
    var dragging = false;
    var activePointerId = null;
    var baseY = 0;

    function applyTransform(clientY) {
      card.style.transform = 'translateY(' + (clientY - baseY) + 'px)';
    }

    function onMove(e) {
      if (!dragging || e.pointerId !== activePointerId) return;
      applyTransform(e.clientY);

      var gap = parseFloat(getComputedStyle(blocksList).rowGap) || 12;
      var cardRect = card.getBoundingClientRect();
      var cardMid = cardRect.top + cardRect.height / 2;
      var myIndex = Array.prototype.indexOf.call(blocksList.children, card);
      var siblings = Array.prototype.slice.call(blocksList.children).filter(function (s) { return s !== card; });

      for (var i = 0; i < siblings.length; i++) {
        var sib = siblings[i];
        var sibIndex = Array.prototype.indexOf.call(blocksList.children, sib);
        var r = sib.getBoundingClientRect();
        var sibMid = r.top + r.height / 2;
        if (sibIndex < myIndex && cardMid < sibMid) {
          blocksList.insertBefore(sib, card.nextSibling);
          baseY -= (r.height + gap);
          applyTransform(e.clientY);
          break;
        } else if (sibIndex > myIndex && cardMid > sibMid) {
          blocksList.insertBefore(sib, card);
          baseY += (r.height + gap);
          applyTransform(e.clientY);
          break;
        }
      }
    }

    function finish(e) {
      if (!dragging || (e && e.pointerId !== activePointerId)) return;
      dragging = false;
      activePointerId = null;
      card.style.transform = '';
      card.style.position = '';
      card.style.zIndex = '';
      card.classList.remove('block-dragging');
      handle.style.cursor = 'grab';
      document.removeEventListener('pointermove', onMove);
      document.removeEventListener('pointerup', finish);
      document.removeEventListener('pointercancel', finish);
      var newBlocks = Array.prototype.slice.call(blocksList.children).map(function (el) {
        return blocks.find(function (b) { return b.id === el.dataset.blockId; });
      }).filter(Boolean);
      if (newBlocks.length === blocks.length) blocks = newBlocks;
    }

    handle.addEventListener('pointerdown', function (e) {
      dragging = true;
      activePointerId = e.pointerId;
      baseY = e.clientY;
      card.style.position = 'relative';
      card.style.zIndex = '50';
      card.classList.add('block-dragging');
      handle.style.cursor = 'grabbing';
      document.addEventListener('pointermove', onMove);
      document.addEventListener('pointerup', finish);
      document.addEventListener('pointercancel', finish);
      e.preventDefault();
    });
  }

  function newBlock(type) {
    if (type === 'name') return { id: uid(), type: type, text: '', pronouns: '' };
    if (type === 'photo') return { id: uid(), type: type, url: '' };
    if (type === 'bio') return { id: uid(), type: type, text: '' };
    if (type === 'quote') return { id: uid(), type: type, text: '' };
    if (type === 'subtitle') return { id: uid(), type: type, role: '', location: '' };
    if (type === 'links') return { id: uid(), type: type, instagram: '', linkedin: '', website: '' };
    if (type === 'heading') return { id: uid(), type: type, text: '' };
    if (type === 'paragraph') return { id: uid(), type: type, text: '' };
    if (type === 'image') return { id: uid(), type: type, url: '', caption: '' };
    if (type === 'gallery') return { id: uid(), type: type, images: [] };
    if (type === 'button') return { id: uid(), type: type, label: '', href: '' };
    if (type === 'spacer') return { id: uid(), type: type, height: 40 };
    return null;
  }

  function uploadAdminImage(file, onDone) {
    var fd = new FormData();
    fd.append('file', file);
    adminFetch('/api/admin/upload', { method: 'POST', body: fd }).then(function (r) {
      onDone(r.ok ? r.data.url : null, r.ok ? null : (r.data && r.data.error));
    });
  }

  // --- Crop / reposition modal (mirrors src/dots/alumni-submit.njk's --
  // same reasoning: "recommended" just keeps the already-uploaded
  // original, since every photo display already runs it through
  // Cloudflare's automatic face-aware crop; "Save this crop" renders the
  // current pan/zoom and uploads that as a new file instead.) -----------
  (function () {
    var overlay = document.getElementById('cropModalOverlay');
    var frame = document.getElementById('cropFrame');
    var canvas = document.getElementById('cropCanvas');
    var ctx = canvas.getContext('2d');
    var zoomSlider = document.getElementById('cropZoom');
    var useRecommendedBtn = document.getElementById('cropUseRecommendedBtn');
    var saveBtn = document.getElementById('cropSaveBtn');
    var cancelBtn = document.getElementById('cropCancelBtn');
    var cropStatus = document.getElementById('cropStatus');

    var img = null, coverScale = 1, scale = 1, offsetX = 0, offsetY = 0;
    var activeOriginalUrl = null, activeOnDone = null;
    var OUT_W = 960, OUT_H = 960;

    // See src/dots/alumni-submit.njk's identical crop modal for the
    // reasoning behind pinch-tracking two simultaneous pointers -- kept
    // in sync here since this codebase duplicates the modal rather than
    // sharing a module between the participant and staff editors.
    var pointers = {};
    var panFrom = null;
    var pinchFrom = null;

    function frameSize() {
      var rect = frame.getBoundingClientRect();
      return { w: rect.width, h: rect.height };
    }

    function minScale() { return coverScale; }
    function maxScale() { return coverScale * 3; }

    function clampOffsets() {
      var fs = frameSize();
      var iw = img.naturalWidth * scale, ih = img.naturalHeight * scale;
      offsetX = Math.min(0, Math.max(fs.w - iw, offsetX));
      offsetY = Math.min(0, Math.max(fs.h - ih, offsetY));
    }

    function draw() {
      var fs = frameSize();
      var dpr = window.devicePixelRatio || 1;
      canvas.width = fs.w * dpr;
      canvas.height = fs.h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, fs.w, fs.h);
      if (!img) return;
      ctx.drawImage(img, offsetX, offsetY, img.naturalWidth * scale, img.naturalHeight * scale);
    }

    function pointerDist(ids) {
      var a = pointers[ids[0]], b = pointers[ids[1]];
      return Math.hypot(a.x - b.x, a.y - b.y);
    }
    function pointerMid(ids) {
      var a = pointers[ids[0]], b = pointers[ids[1]];
      return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
    }

    function setZoomFromScale() {
      zoomSlider.value = String(scale / coverScale);
    }

    frame.addEventListener('pointerdown', function (e) {
      if (!img) return;
      frame.setPointerCapture(e.pointerId);
      pointers[e.pointerId] = { x: e.clientX, y: e.clientY };
      var ids = Object.keys(pointers);
      if (ids.length === 1) {
        panFrom = { x: e.clientX, y: e.clientY, offsetX: offsetX, offsetY: offsetY };
        frame.style.cursor = 'grabbing';
      } else if (ids.length === 2) {
        panFrom = null;
        pinchFrom = { dist: pointerDist(ids), scale: scale };
      }
    });
    frame.addEventListener('pointermove', function (e) {
      if (!pointers[e.pointerId] || !img) return;
      pointers[e.pointerId] = { x: e.clientX, y: e.clientY };
      var ids = Object.keys(pointers);
      if (ids.length === 2 && pinchFrom) {
        var rect = frame.getBoundingClientRect();
        var mid = pointerMid(ids);
        var localX = mid.x - rect.left, localY = mid.y - rect.top;
        var newScale = Math.min(maxScale(), Math.max(minScale(), pinchFrom.scale * (pointerDist(ids) / pinchFrom.dist)));
        var ratio = newScale / scale;
        offsetX = localX - (localX - offsetX) * ratio;
        offsetY = localY - (localY - offsetY) * ratio;
        scale = newScale;
        setZoomFromScale();
        clampOffsets();
        draw();
      } else if (ids.length === 1 && panFrom) {
        offsetX = panFrom.offsetX + (e.clientX - panFrom.x);
        offsetY = panFrom.offsetY + (e.clientY - panFrom.y);
        clampOffsets();
        draw();
      }
    });
    function releasePointer(e) {
      delete pointers[e.pointerId];
      var ids = Object.keys(pointers);
      pinchFrom = null;
      if (ids.length === 1) {
        var p = pointers[ids[0]];
        panFrom = { x: p.x, y: p.y, offsetX: offsetX, offsetY: offsetY };
      } else {
        panFrom = null;
      }
      if (!ids.length) frame.style.cursor = 'grab';
    }
    ['pointerup', 'pointercancel', 'pointerleave'].forEach(function (evt) {
      frame.addEventListener(evt, releasePointer);
    });

    zoomSlider.addEventListener('input', function () {
      if (!img) return;
      var fs = frameSize();
      var cx = fs.w / 2, cy = fs.h / 2;
      var prevScale = scale;
      scale = coverScale * Number(zoomSlider.value);
      var ratio = scale / prevScale;
      offsetX = cx - (cx - offsetX) * ratio;
      offsetY = cy - (cy - offsetY) * ratio;
      clampOffsets();
      draw();
    });

    function loadImage(url) {
      cropStatus.textContent = '';
      cropStatus.style.color = '';
      img = null;
      var el = new Image();
      el.onload = function () {
        img = el;
        var fs = frameSize();
        coverScale = Math.max(fs.w / img.naturalWidth, fs.h / img.naturalHeight);
        scale = coverScale;
        zoomSlider.value = '1';
        offsetX = (fs.w - img.naturalWidth * scale) / 2;
        offsetY = (fs.h - img.naturalHeight * scale) / 2;
        draw();
      };
      el.onerror = function () {
        cropStatus.style.color = 'var(--coral-ink)';
        cropStatus.textContent = "Couldn't load that image for cropping — try again.";
      };
      el.src = url;
    }

    window.openCropModal = function (originalUrl, onDone) {
      activeOriginalUrl = originalUrl;
      activeOnDone = onDone;
      overlay.style.display = 'flex';
      loadImage(originalUrl);
    };

    function close() {
      overlay.style.display = 'none';
      img = null;
      activeOriginalUrl = null;
      activeOnDone = null;
    }

    cancelBtn.addEventListener('click', close);
    overlay.addEventListener('click', function (e) { if (e.target === overlay) close(); });

    useRecommendedBtn.addEventListener('click', function () {
      var onDone = activeOnDone;
      var url = activeOriginalUrl;
      close();
      if (onDone) onDone(url);
    });

    saveBtn.addEventListener('click', function () {
      if (!img) return;
      saveBtn.disabled = true;
      cropStatus.style.color = '';
      cropStatus.textContent = 'Saving your crop…';

      var out = document.createElement('canvas');
      out.width = OUT_W; out.height = OUT_H;
      var octx = out.getContext('2d');
      var fs = frameSize();
      var sx = OUT_W / fs.w, sy = OUT_H / fs.h;
      octx.drawImage(img, offsetX * sx, offsetY * sy, img.naturalWidth * scale * sx, img.naturalHeight * scale * sy);

      out.toBlob(function (blob) {
        if (!blob) {
          saveBtn.disabled = false;
          cropStatus.style.color = 'var(--coral-ink)';
          cropStatus.textContent = "Couldn't process that crop — try again.";
          return;
        }
        var file = new File([blob], 'cropped.jpg', { type: 'image/jpeg' });
        var onDone = activeOnDone;
        uploadAdminImage(file, function (url, err) {
          saveBtn.disabled = false;
          if (!url) {
            cropStatus.style.color = 'var(--coral-ink)';
            cropStatus.textContent = err || 'Upload failed — try again.';
            return;
          }
          close();
          if (onDone) onDone(url);
        });
      }, 'image/jpeg', 0.9);
    });
  })();

  function blockLabel(type) {
    return {
      name: 'Name', photo: 'Photo', bio: 'Bio', quote: 'Quote', subtitle: "What & where", links: 'Links',
      heading: 'Heading', paragraph: 'Text', image: 'Image', gallery: 'Gallery', button: 'Button', spacer: 'Spacer',
    }[type] || type;
  }

  function renderBlocks() {
    blocksList.innerHTML = '';
    blocks.forEach(function (block, index) {
      var required = !!REQUIRED_TYPES[block.type];
      var card = document.createElement('div');
      card.className = 'rounded-xl border-2 p-4';
      card.style.background = required ? 'var(--paper-2)' : '#fff';
      card.style.borderColor = 'var(--ink)';
      card.dataset.blockId = block.id;

      var head = document.createElement('div');
      head.className = 'flex items-center justify-between mb-3';
      var tag = document.createElement('span');
      tag.className = 'tag';
      tag.textContent = '⠿ ' + blockLabel(block.type);
      tag.style.userSelect = 'none';
