<script>
(function () {
  var items = [];
  var reviewingId = null;
  var reviewingItem = null;
  var proposedBlocks = [];
  var originalProposedBlocks = [];
  var originalProposedSlug = '';
  var REQUIRED_TYPES = { name: true, photo: true, bio: true };

  var tbody = document.getElementById('editsTbody');
  var tableStatus = document.getElementById('editsTableStatus');
  var reviewOverlay = document.getElementById('reviewOverlay');
  var changesSummary = document.getElementById('changesSummary');
  var deleteReviewCard = document.getElementById('deleteReviewCard');
  var editReviewGrid = document.getElementById('editReviewGrid');
  var reviewCurrent = document.getElementById('reviewCurrent');
  var proposedBlocksList = document.getElementById('proposedBlocksList');
  var resetProposedBtn = document.getElementById('resetProposedBtn');
  var reviewCloseBtn = document.getElementById('reviewCloseBtn');
  var approveBtn = document.getElementById('approveBtn');
  var rejectBtn = document.getElementById('rejectBtn');
  var reviewStatus = document.getElementById('reviewStatus');

  function setTableStatus(msg, isError) {
    tableStatus.textContent = msg || '';
    tableStatus.style.color = isError ? 'var(--coral-ink)' : '';
  }

  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]; }); }
  function safeParseArr(str) { try { return JSON.parse(str || 'null'); } catch (e) { return null; } }

  function isUnified(blocks) {
    return Array.isArray(blocks) && blocks.some(function (b) { return b.type === 'name'; });
  }

  // Renders one block list in order, matching src/dots/alumni-profile.njk's
  // unified branch exactly -- every identity block type (name/photo/bio/
  // quote/subtitle/links) plus the free-form content ones, so what staff
  // see here is what the public page will actually show, in whatever
  // order the blocks are in. Falls back to the pre-unification flat-field
  // layout only for legacy entries that never went through the block
  // builder at all.
  function renderBlockList(blocks) {
    var html = '';
    blocks.forEach(function (block) {
      if (block.type === 'name') {
        html += '<h2 class="h-card">' + esc(block.text) + (block.pronouns ? ' <span class="text-muted" style="font-size:.6em">(' + esc(block.pronouns) + ')</span>' : '') + '</h2>';
      } else if (block.type === 'photo') {
        if (block.url) html += '<img src="' + esc(block.url) + '" alt="" style="width:100%;max-height:16rem;object-fit:cover;border-radius:1rem;border:2px solid var(--ink);margin:.75rem 0">';
      } else if (block.type === 'bio') {
        html += '<p class="mt-2 text-muted leading-relaxed">' + esc(block.text) + '</p>';
      } else if (block.type === 'subtitle') {
        if (block.role) html += '<p class="font-semibold mt-2">' + esc(block.role) + '</p>';
        if (block.location) html += '<p class="text-sm text-muted">' + esc(block.location) + '</p>';
      } else if (block.type === 'quote') {
        html += '<blockquote class="card p-3 mt-3 text-sm" style="border-left:3px solid var(--coral-ink);font-style:italic">“' + esc(block.text) + '”</blockquote>';
      } else if (block.type === 'links') {
        html += '<div class="flex flex-wrap gap-2 mt-3">';
        if (block.instagram) html += '<span class="btn !py-1 !px-2.5 text-xs" style="pointer-events:none">Instagram</span>';
        if (block.linkedin) html += '<span class="btn !py-1 !px-2.5 text-xs" style="pointer-events:none">LinkedIn</span>';
        if (block.website) html += '<span class="btn !py-1 !px-2.5 text-xs" style="pointer-events:none">Website</span>';
        html += '</div>';
      } else if (block.type === 'heading') {
        html += '<h3 class="h-card mt-4">' + esc(block.text) + '</h3>';
      } else if (block.type === 'paragraph') {
        html += '<p class="text-muted leading-relaxed mt-2" style="white-space:pre-line">' + esc(block.text) + '</p>';
      } else if (block.type === 'image') {
        if (block.url) html += '<img src="' + esc(block.url) + '" alt="" style="width:100%;max-height:14rem;object-fit:cover;border-radius:.75rem;border:2px solid var(--ink);margin-top:1rem">';
        if (block.caption) html += '<p class="text-xs text-muted mt-1">' + esc(block.caption) + '</p>';
      } else if (block.type === 'gallery' && Array.isArray(block.images)) {
        html += '<div class="grid gap-2 mt-3" style="grid-template-columns:repeat(auto-fill,minmax(6rem,1fr))">';
        block.images.forEach(function (url) { html += '<img src="' + esc(url) + '" alt="" style="width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:.5rem;border:2px solid var(--ink)">'; });
        html += '</div>';
      } else if (block.type === 'button') {
        html += '<div class="mt-3"><span class="btn btn-accent !py-1.5 !px-3 text-xs" style="pointer-events:none">' + esc(block.label) + '</span>' +
          '<p class="text-xs text-muted mt-1">&rarr; ' + esc(block.href || '(no link set)') + '</p></div>';
      } else if (block.type === 'spacer') {
        html += '<div style="height:' + (Number(block.height) || 40) + 'px"></div>';
      }
    });
    return html;
  }

  function renderLegacyFallback(data) {
    var html = '';
    if (data.photo_url) html += '<img src="' + esc(data.photo_url) + '" alt="" style="width:100%;max-height:16rem;object-fit:cover;border-radius:1rem;border:2px solid var(--ink);margin-bottom:1.5rem">';
    html += '<h2 class="h-card">' + esc(data.name) + (data.pronouns ? ' <span class="text-muted" style="font-size:.6em">(' + esc(data.pronouns) + ')</span>' : '') + '</h2>';
    if (data.current_role) html += '<p class="font-semibold mt-1">' + esc(data.current_role) + '</p>';
    if (data.location) html += '<p class="text-sm text-muted">' + esc(data.location) + '</p>';
    html += '<p class="mt-3 text-muted leading-relaxed">' + esc(data.bio) + '</p>';
    if (data.quote) html += '<blockquote class="card p-3 mt-3 text-sm" style="border-left:3px solid var(--coral-ink);font-style:italic">“' + esc(data.quote) + '”</blockquote>';
    var links = safeParseArr(data.links_json) || [];
    if (links.length) {
      html += '<div class="flex flex-wrap gap-2 mt-4">';
      links.forEach(function (l) { html += '<span class="btn !py-1 !px-2.5 text-xs" style="pointer-events:none">' + esc(l.label) + '</span>'; });
      html += '</div>';
    }
    if (data.story) html += '<div class="card p-4 mt-6"><p class="text-xs font-bold uppercase tracking-wide mb-2 text-muted">Story</p><p class="text-sm text-muted leading-relaxed" style="white-space:pre-line">' + esc(data.story) + '</p></div>';
    var photos = safeParseArr(data.photos_json) || [];
    if (photos.length) {
      html += '<div class="mt-6"><p class="text-xs font-bold uppercase tracking-wide mb-2 text-muted">More photos</p><div class="grid gap-2" style="grid-template-columns:repeat(auto-fill,minmax(6rem,1fr))">';
      photos.forEach(function (url) { html += '<img src="' + esc(url) + '" alt="" style="width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:.5rem;border:2px solid var(--ink)">'; });
      html += '</div></div>';
    }
    return html;
  }

  // Renders the read-only "Before" pane -- from a flat-field data object
  // (current_* columns), same shape the row already comes in as.
  function renderCurrent(data) {
    var blocks = safeParseArr(data.blocks_json);
    if (isUnified(blocks)) return renderBlockList(blocks);
    return renderLegacyFallback(data);
  }

  // --- Editable "After" block list --------------------------------------
  function uid() { return 'b' + Math.random().toString(36).slice(2, 10); }

  function newBlock(type) {
    if (type === 'quote') return { id: uid(), type: type, text: '' };
    if (type === 'subtitle') return { id: uid(), type: type, role: '', location: '' };
    if (type === 'links') return { id: uid(), type: type, instagram: '', linkedin: '', website: '' };
    if (type === 'heading') return { id: uid(), type: type, text: '' };
    if (type === 'paragraph') return { id: uid(), type: type, text: '' };
    if (type === 'image') return { id: uid(), type: type, url: '', caption: '' };
    if (type === 'gallery') return { id: uid(), type: type, images: [] };
    if (type === 'button') return { id: uid(), type: type, label: '', href: '' };
    if (type === 'spacer') return { id: uid(), type: type, height: 40 };
    return null;
  }

  function uploadAdminImage(file, onDone) {
    var fd = new FormData();
    fd.append('file', file);
    adminFetch('/api/admin/upload', { method: 'POST', body: fd }).then(function (r) {
      onDone(r.ok ? r.data.url : null, r.ok ? null : (r.data && r.data.error));
    });
  }

  function blockLabel(type) {
    return {
      name: 'Name', photo: 'Photo', bio: 'Bio', quote: 'Quote', subtitle: "What & where", links: 'Links',
      heading: 'Heading', paragraph: 'Text', image: 'Image', gallery: 'Gallery', button: 'Button', spacer: 'Spacer',
    }[type] || type;
  }

  // Pointer-Events-based reordering (mouse + touch) -- see the identical
  // helper in src/dots/alumni-submit.njk for why this replaced the old
  // HTML5 Drag and Drop API implementation (it never fired on touch
  // devices at all).
  function makeHandleDraggable(handle, card) {
    // pointerdown attaches move/up listeners to `document`, not `handle` --
    // relying on setPointerCapture alone to keep receiving events once the
    // cursor leaves the handle's own small hit area isn't reliable in real
    // use. Listening on the document guarantees pointermove keeps firing
    // regardless of what's physically under the cursor.
    handle.style.touchAction = 'none';
    handle.style.webkitTouchCallout = 'none';
    handle.style.cursor = 'grab';
    var dragging = false;
    var activePointerId = null;
    var baseY = 0;

    function applyTransform(clientY) {
      card.style.transform = 'translateY(' + (clientY - baseY) + 'px)';
    }

    function onMove(e) {
      if (!dragging || e.pointerId !== activePointerId) return;
      applyTransform(e.clientY);

      var gap = parseFloat(getComputedStyle(proposedBlocksList).rowGap) || 12;
      var cardRect = card.getBoundingClientRect();
      var cardMid = cardRect.top + cardRect.height / 2;
      var myIndex = Array.prototype.indexOf.call(proposedBlocksList.children, card);
      var siblings = Array.prototype.slice.call(proposedBlocksList.children).filter(function (s) { return s !== card; });

      for (var i = 0; i < siblings.length; i++) {
        var sib = siblings[i];
        var sibIndex = Array.prototype.indexOf.call(proposedBlocksList.children, sib);
        var r = sib.getBoundingClientRect();
        var sibMid = r.top + r.height / 2;
        if (sibIndex < myIndex && cardMid < sibMid) {
          proposedBlocksList.insertBefore(sib, card.nextSibling);
          baseY -= (r.height + gap);
          applyTransform(e.clientY);
          break;
        } else if (sibIndex > myIndex && cardMid > sibMid) {
          proposedBlocksList.insertBefore(sib, card);
          baseY += (r.height + gap);
          applyTransform(e.clientY);
          break;
        }
      }
    }

    function finish(e) {
      if (!dragging || (e && e.pointerId !== activePointerId)) return;
      dragging = false;
      activePointerId = null;
      card.style.transform = '';
      card.style.position = '';
      card.style.zIndex = '';
      card.classList.remove('block-dragging');
      handle.style.cursor = 'grab';
      document.removeEventListener('pointermove', onMove);
      document.removeEventListener('pointerup', finish);
      document.removeEventListener('pointercancel', finish);
      var reordered = Array.prototype.slice.call(proposedBlocksList.children).map(function (el) {
        return proposedBlocks.find(function (b) { return b.id === el.dataset.blockId; });
      }).filter(Boolean);
      if (reordered.length === proposedBlocks.length) proposedBlocks = reordered;
    }

    handle.addEventListener('pointerdown', function (e) {
      dragging = true;
      activePointerId = e.pointerId;
      baseY = e.clientY;
      card.style.position = 'relative';
      card.style.zIndex = '50';
      card.classList.add('block-dragging');
      handle.style.cursor = 'grabbing';
      document.addEventListener('pointermove', onMove);
      document.addEventListener('pointerup', finish);
      document.addEventListener('pointercancel', finish);
      e.preventDefault();
    });
  }

  function renderProposedBlocks() {
    proposedBlocksList.innerHTML = '';
    proposedBlocks.forEach(function (block, index) {
      var required = !!REQUIRED_TYPES[block.type];
      var card = document.createElement('div');
      card.className = 'rounded-xl border-2 p-3';
      card.style.background = required ? 'var(--paper-2)' : '#fff';
      card.style.borderColor = 'var(--ink)';
      card.dataset.blockId = block.id;

      var head = document.createElement('div');
      head.className = 'flex items-center justify-between mb-2';
      var tag = document.createElement('span');
      tag.className = 'tag';
      tag.style.fontSize = '.62rem';
      tag.textContent = '⠿ ' + blockLabel(block.type);
      tag.style.userSelect = 'none';
      if (required) tag.style.background = 'var(--sun)';
      makeHandleDraggable(tag, card);
      head.appendChild(tag);

      var controls = document.createElement('div');
      controls.className = 'flex items-center gap-1';
      var upBtn = document.createElement('button');
      upBtn.type = 'button'; upBtn.className = 'btn !py-0.5 !px-1.5 text-xs'; upBtn.textContent = '↑'; upBtn.disabled = index === 0;
      upBtn.addEventListener('click', function () { if (index === 0) return; proposedBlocks.splice(index - 1, 0, proposedBlocks.splice(index, 1)[0]); renderProposedBlocks(); });
      var downBtn = document.createElement('button');
      downBtn.type = 'button'; downBtn.className = 'btn !py-0.5 !px-1.5 text-xs'; downBtn.textContent = '↓'; downBtn.disabled = index === proposedBlocks.length - 1;
      downBtn.addEventListener('click', function () { if (index === proposedBlocks.length - 1) return; proposedBlocks.splice(index + 1, 0, proposedBlocks.splice(index, 1)[0]); renderProposedBlocks(); });
      controls.appendChild(upBtn); controls.appendChild(downBtn);
      if (!required) {
        var removeBtn = document.createElement('button');
        removeBtn.type = 'button'; removeBtn.className = 'btn btn-coral !py-0.5 !px-1.5 text-xs'; removeBtn.textContent = 'Remove';
        removeBtn.addEventListener('click', function () { proposedBlocks.splice(index, 1); renderProposedBlocks(); });
        controls.appendChild(removeBtn);
      }
      head.appendChild(controls);
      card.appendChild(head);

      var body = document.createElement('div');
      body.className = 'flex flex-col gap-1.5';

      if (block.type === 'name') {
        var nameIn = document.createElement('input');
        nameIn.className = 'input text-sm'; nameIn.type = 'text'; nameIn.maxLength = 100; nameIn.placeholder = 'Name'; nameIn.value = block.text || '';
        nameIn.addEventListener('input', function () { block.text = nameIn.value; });
        var pronounsIn = document.createElement('input');
        pronounsIn.className = 'input text-sm'; pronounsIn.type = 'text'; pronounsIn.maxLength = 30; pronounsIn.placeholder = 'Pronouns (optional)'; pronounsIn.value = block.pronouns || '';
        pronounsIn.addEventListener('input', function () { block.pronouns = pronounsIn.value; });
        body.appendChild(nameIn); body.appendChild(pronounsIn);
      } else if (block.type === 'photo') {
        if (block.url) {
          var photoPrev = document.createElement('img');
          photoPrev.src = block.url; photoPrev.alt = '';
          photoPrev.style.cssText = 'max-height:6rem;border-radius:.5rem;border:2px solid var(--ink);object-fit:cover';
          body.appendChild(photoPrev);
          var adjustPhotoBtn = document.createElement('button');
          adjustPhotoBtn.type = 'button';
          adjustPhotoBtn.className = 'btn !py-1 !px-2 text-xs self-start';
          adjustPhotoBtn.textContent = 'Adjust photo';
          adjustPhotoBtn.addEventListener('click', function () {
            window.openCropModal(block.url, function (finalUrl) { block.url = finalUrl; renderProposedBlocks(); });
          });
          body.appendChild(adjustPhotoBtn);
        }
        var photoFileIn = document.createElement('input');
        photoFileIn.className = 'input text-sm'; photoFileIn.type = 'file'; photoFileIn.accept = 'image/jpeg,image/png,image/webp';
        var photoStatus = document.createElement('p');
        photoStatus.className = 'text-xs text-muted';
        photoFileIn.addEventListener('change', function () {
          if (!photoFileIn.files[0]) return;
          photoStatus.textContent = 'Uploading…';
          uploadAdminImage(photoFileIn.files[0], function (url, err) {
            if (!url) { photoStatus.style.color = 'var(--coral-ink)'; photoStatus.textContent = err || 'Upload failed.'; return; }
            photoStatus.textContent = '';
            window.openCropModal(url, function (finalUrl) { block.url = finalUrl; renderProposedBlocks(); });
          });
        });
        body.appendChild(photoFileIn); body.appendChild(photoStatus);
      } else if (block.type === 'bio') {
        var bioIn = document.createElement('textarea');
        bioIn.className = 'input text-sm'; bioIn.rows = 3; bioIn.maxLength = 600; bioIn.placeholder = 'Bio'; bioIn.value = block.text || '';
        bioIn.addEventListener('input', function () { block.text = bioIn.value; });
        body.appendChild(bioIn);
      } else if (block.type === 'quote') {
        var quoteIn = document.createElement('input');
        quoteIn.className = 'input text-sm'; quoteIn.type = 'text'; quoteIn.maxLength = 300; quoteIn.placeholder = 'Quote'; quoteIn.value = block.text || '';
        quoteIn.addEventListener('input', function () { block.text = quoteIn.value; });
        body.appendChild(quoteIn);
      } else if (block.type === 'subtitle') {
        var roleIn = document.createElement('input');
        roleIn.className = 'input text-sm'; roleIn.type = 'text'; roleIn.maxLength = 120; roleIn.placeholder = 'What they\'re up to'; roleIn.value = block.role || '';
        roleIn.addEventListener('input', function () { block.role = roleIn.value; });
        var locIn = document.createElement('input');
        locIn.className = 'input text-sm'; locIn.type = 'text'; locIn.maxLength = 80; locIn.placeholder = 'Where they are'; locIn.value = block.location || '';
        locIn.addEventListener('input', function () { block.location = locIn.value; });
        body.appendChild(roleIn); body.appendChild(locIn);
      } else if (block.type === 'links') {
        ['instagram', 'linkedin', 'website'].forEach(function (key) {
          var lIn = document.createElement('input');
          lIn.className = 'input text-sm'; lIn.type = 'text'; lIn.placeholder = key.charAt(0).toUpperCase() + key.slice(1); lIn.value = block[key] || '';
          lIn.addEventListener('input', function () { block[key] = lIn.value; });
          body.appendChild(lIn);
        });
      } else if (block.type === 'heading') {
        var hIn = document.createElement('input');
        hIn.className = 'input text-sm'; hIn.type = 'text'; hIn.maxLength = 200; hIn.placeholder = 'Heading'; hIn.value = block.text || '';
        hIn.addEventListener('input', function () { block.text = hIn.value; });
        body.appendChild(hIn);
      } else if (block.type === 'paragraph') {
        var pIn = document.createElement('textarea');
        pIn.className = 'input text-sm'; pIn.rows = 3; pIn.maxLength = 4000; pIn.placeholder = 'Text'; pIn.value = block.text || '';
        pIn.addEventListener('input', function () { block.text = pIn.value; });
        body.appendChild(pIn);
      } else if (block.type === 'image') {
        if (block.url) {
          var prevImg = document.createElement('img');
          prevImg.src = block.url; prevImg.alt = '';
          prevImg.style.cssText = 'max-height:6rem;border-radius:.5rem;border:2px solid var(--ink);object-fit:cover';
          body.appendChild(prevImg);
          var adjustImgBtn = document.createElement('button');
          adjustImgBtn.type = 'button';
          adjustImgBtn.className = 'btn !py-1 !px-2 text-xs self-start';
          adjustImgBtn.textContent = 'Adjust photo';
          adjustImgBtn.addEventListener('click', function () {
            window.openCropModal(block.url, function (finalUrl) { block.url = finalUrl; renderProposedBlocks(); });
          });
          body.appendChild(adjustImgBtn);
        }
        var fIn = document.createElement('input');
        fIn.className = 'input text-sm'; fIn.type = 'file'; fIn.accept = 'image/jpeg,image/png,image/webp';
        var upStatus = document.createElement('p');
        upStatus.className = 'text-xs text-muted';
        fIn.addEventListener('change', function () {
          if (!fIn.files[0]) return;
          upStatus.textContent = 'Uploading…';
          uploadAdminImage(fIn.files[0], function (url, err) {
            if (!url) { upStatus.style.color = 'var(--coral-ink)'; upStatus.textContent = err || 'Upload failed.'; return; }
            upStatus.textContent = '';
            window.openCropModal(url, function (finalUrl) { block.url = finalUrl; renderProposedBlocks(); });
          });
        });
        body.appendChild(fIn); body.appendChild(upStatus);
        var capIn = document.createElement('input');
        capIn.className = 'input text-sm'; capIn.type = 'text'; capIn.maxLength = 300; capIn.placeholder = 'Caption'; capIn.value = block.caption || '';
        capIn.addEventListener('input', function () { block.caption = capIn.value; });
        body.appendChild(capIn);
      } else if (block.type === 'gallery') {
        if (block.images && block.images.length) {
          var grid = document.createElement('div');
          grid.className = 'flex flex-wrap gap-1';
          block.images.forEach(function (url, imgIdx) {
            var wrap = document.createElement('div');
            wrap.style.position = 'relative';
            var gImg = document.createElement('img');
            gImg.src = url; gImg.alt = '';
            gImg.style.cssText = 'width:3rem;height:3rem;border-radius:.4rem;object-fit:cover;border:2px solid var(--ink)';
            wrap.appendChild(gImg);
            var rmBtn = document.createElement('button');
            rmBtn.type = 'button'; rmBtn.textContent = '×';
            rmBtn.style.cssText = 'position:absolute;top:-.3rem;right:-.3rem;width:1rem;height:1rem;border-radius:999px;background:var(--coral-ink);color:#fff;font-size:.6rem;line-height:1;border:none;cursor:pointer';
            rmBtn.addEventListener('click', function () { block.images.splice(imgIdx, 1); renderProposedBlocks(); });
            wrap.appendChild(rmBtn);
            grid.appendChild(wrap);
          });
          body.appendChild(grid);
        }
        var gIn = document.createElement('input');
        gIn.className = 'input text-sm'; gIn.type = 'file'; gIn.accept = 'image/jpeg,image/png,image/webp'; gIn.multiple = true;
        gIn.addEventListener('change', function () {
          var files = Array.prototype.slice.call(gIn.files).slice(0, 12 - (block.images || []).length);
          if (!files.length) return;
          var remaining = files.length;
          files.forEach(function (file) {
            uploadAdminImage(file, function (url) {
              if (url) { block.images = block.images || []; block.images.push(url); }
              remaining -= 1;
              if (remaining === 0) renderProposedBlocks();
            });
          });
        });
        body.appendChild(gIn);
      } else if (block.type === 'button') {
        var lblIn = document.createElement('input');
        lblIn.className = 'input text-sm'; lblIn.type = 'text'; lblIn.maxLength = 100; lblIn.placeholder = 'Label'; lblIn.value = block.label || '';
        lblIn.addEventListener('input', function () { block.label = lblIn.value; });
        var hrefIn = document.createElement('input');
        hrefIn.className = 'input text-sm'; hrefIn.type = 'text'; hrefIn.maxLength = 500; hrefIn.placeholder = 'Link'; hrefIn.value = block.href || '';
        hrefIn.addEventListener('input', function () { block.href = hrefIn.value; });
        body.appendChild(lblIn); body.appendChild(hrefIn);
      } else if (block.type === 'spacer') {
        var SPACER_SIZES = [{ label: 'Little', value: 20 }, { label: 'Middle', value: 48 }, { label: 'Big', value: 96 }];
        var closest = SPACER_SIZES.reduce(function (a, b) {
          return Math.abs(b.value - (block.height || 40)) < Math.abs(a.value - (block.height || 40)) ? b : a;
        });
        var spacerRow = document.createElement('div');
        spacerRow.className = 'flex flex-wrap gap-2';
        SPACER_SIZES.forEach(function (s) {
          var sBtn = document.createElement('button');
          sBtn.type = 'button';
          var active = s.value === closest.value;
          sBtn.className = 'btn !py-1.5 !px-3 text-xs' + (active ? ' btn-accent' : '');
          sBtn.textContent = s.label;
          sBtn.addEventListener('click', function () { block.height = s.value; renderProposedBlocks(); });
          spacerRow.appendChild(sBtn);
        });
        body.appendChild(spacerRow);
      }

      card.appendChild(body);
      proposedBlocksList.appendChild(card);
    });
  }

  document.querySelectorAll('#editReviewGrid [data-add]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var b = newBlock(btn.getAttribute('data-add'));
      if (b) { proposedBlocks.push(b); renderProposedBlocks(); }
    });
  });

  resetProposedBtn.addEventListener('click', function () {
    proposedBlocks = originalProposedBlocks.map(function (b) { return Object.assign({}, b); });
    document.getElementById('proposedSlug').value = originalProposedSlug;
    renderProposedBlocks();
  });

  // --- What-changed summary ----------------------------------------------
  var FIELD_LABELS = { name: 'Name', pronouns: 'Pronouns', bio: 'Bio', photo_url: 'Photo', current_role: "What they're up to", location: 'Location', quote: 'Quote' };

  function deriveCore(blocks) {
    var find = function (t) { return (blocks || []).find(function (b) { return b.type === t; }); };
    var n = find('name'), b = find('bio'), p = find('photo'), q = find('quote'), s = find('subtitle');
    return {
      name: (n && n.text) || '', pronouns: (n && n.pronouns) || '', bio: (b && b.text) || '',
      photo_url: (p && p.url) || '', current_role: (s && s.role) || '', location: (s && s.location) || '', quote: (q && q.text) || '',
    };
  }

  function renderChangesSummary(currentCore, proposedCore, blocksActuallyDiffer) {
    var rows = [];
    Object.keys(FIELD_LABELS).forEach(function (key) {
      var oldVal = currentCore[key] || '';
      var newVal = proposedCore[key] || '';
      if (oldVal !== newVal) {
        var oldDisplay = key === 'photo_url' ? (oldVal ? 'a photo' : 'no photo') : (oldVal || '(empty)');
        var newDisplay = key === 'photo_url' ? (newVal ? 'a new photo' : 'no photo') : (newVal || '(empty)');
        rows.push('<li><strong>' + esc(FIELD_LABELS[key]) + ':</strong> <span class="text-muted">' + esc(oldDisplay) + '</span> <span class="mx-1">→</span> <span style="color:var(--mint-ink);font-weight:600">' + esc(newDisplay) + '</span></li>');
      }
    });
    if (blocksActuallyDiffer) {
      rows.push('<li><strong>Page layout:</strong> <span style="color:var(--mint-ink);font-weight:600">sections were added, removed, or reordered</span> — see the editable panel on the right for exactly what changed.</li>');
    }
    if (!rows.length) {
      changesSummary.innerHTML = '<p class="eyebrow" style="color:var(--coral-ink)">What changed</p><p class="text-sm text-muted mt-2">Nothing in the core fields changed — only the page sections may differ. Compare the two panels below.</p>';
    } else {
      changesSummary.innerHTML = '<p class="eyebrow" style="color:var(--coral-ink)">What changed</p><ul class="mt-2 space-y-1 text-sm">' + rows.join('') + '</ul>';
    }
  }

  function formatDate(value) {
    if (!value) return '—';
    var d = new Date(value);
    if (isNaN(d.getTime())) return '—';
    return d.toLocaleDateString();
  }

  function openReview(item) {
    reviewingId = item.id;
    reviewingItem = item;
    var currentData = {
      name: item.current_name, pronouns: item.current_pronouns,
      current_role: item.current_current_role, location: item.current_location,
      quote: item.current_quote, bio: item.current_bio, story: item.current_story,
      photo_url: item.current_photo_url, photos_json: item.current_photos_json,
      links_json: item.current_links_json, blocks_json: item.current_blocks_json,
    };
    var proposed = {};
    try { proposed = JSON.parse(item.proposed_json); } catch (e) {}

    if (item.type === 'delete') {
      deleteReviewCard.hidden = false;
      editReviewGrid.hidden = true;
      changesSummary.hidden = true;
      approveBtn.textContent = 'Approve deletion';
      rejectBtn.textContent = 'Keep page live';
    } else {
      deleteReviewCard.hidden = true;
      editReviewGrid.hidden = false;
      changesSummary.hidden = false;
      approveBtn.textContent = 'Approve & publish';
      rejectBtn.textContent = 'Reject';

      reviewCurrent.innerHTML = renderCurrent(currentData);

      originalProposedSlug = proposed.slug || item.current_slug || '';
      document.getElementById('proposedSlug').value = originalProposedSlug;

      var proposedBlocksRaw = safeParseArr(proposed.blocks_json) || [];
      proposedBlocks = proposedBlocksRaw.map(function (b) { return Object.assign({}, b); });
      // A proposal submitted before photo became required can have no
      // photo block at all -- slot an empty one in so staff have
      // somewhere to add one before approving, instead of the block
      // simply never appearing in the review UI.
      if (proposedBlocks.length && !proposedBlocks.some(function (b) { return b.type === 'photo'; })) {
        var nameIdx = proposedBlocks.findIndex(function (b) { return b.type === 'name'; });
        proposedBlocks.splice(nameIdx + 1, 0, { id: 'b' + Math.random().toString(36).slice(2, 10), type: 'photo', url: '' });
      }
      originalProposedBlocks = proposedBlocks.map(function (b) { return Object.assign({}, b); });
      renderProposedBlocks();

      var currentBlocks = safeParseArr(currentData.blocks_json);
      var currentCore = isUnified(currentBlocks) ? deriveCore(currentBlocks) : {
        name: currentData.name || '', pronouns: currentData.pronouns || '', bio: currentData.bio || '',
        photo_url: currentData.photo_url || '', current_role: currentData.current_role || '', location: currentData.location || '', quote: currentData.quote || '',
      };
      var proposedCore = deriveCore(proposedBlocksRaw);
      var blocksDiffer = JSON.stringify(currentBlocks || []) !== JSON.stringify(proposedBlocksRaw || []);
      renderChangesSummary(currentCore, proposedCore, blocksDiffer);
    }

    reviewStatus.textContent = '';
    reviewOverlay.style.display = 'block';
  }

  function closeReview() {
    reviewOverlay.style.display = 'none';
    reviewCurrent.innerHTML = '';
    proposedBlocksList.innerHTML = '';
    proposedBlocks = [];
    originalProposedBlocks = [];
    reviewingId = null;
    reviewingItem = null;
  }

  reviewCloseBtn.addEventListener('click', closeReview);
  reviewOverlay.addEventListener('click', function (e) { if (e.target === reviewOverlay) closeReview(); });

  function decide(action) {
    if (!reviewingId) return;
    var isDelete = reviewingItem && reviewingItem.type === 'delete';

    if (action === 'approve' && !isDelete) {
      var hasName = proposedBlocks.some(function (b) { return b.type === 'name' && b.text && b.text.trim(); });
      var hasPhoto = proposedBlocks.some(function (b) { return b.type === 'photo' && b.url; });
      var hasBio = proposedBlocks.some(function (b) { return b.type === 'bio' && b.text && b.text.trim(); });
      if (!hasName || !hasPhoto || !hasBio) {
        reviewStatus.style.color = 'var(--coral-ink)';
        reviewStatus.textContent = 'Name, photo, and bio are all required before you can approve this.';
        return;
      }
    }

    approveBtn.disabled = true;
    rejectBtn.disabled = true;
    reviewStatus.textContent = 'Saving…';
    reviewStatus.style.color = '';
    var payload = { action: action };
    if (action === 'approve' && !isDelete) {
      payload.blocks = proposedBlocks;
      payload.slug = document.getElementById('proposedSlug').value.trim();
    }
    adminFetch('/api/admin/dots-edits/' + reviewingId, { method: 'PUT', body: JSON.stringify(payload) }).then(function (r) {
      approveBtn.disabled = false;
      rejectBtn.disabled = false;
      if (!r.ok) {
        reviewStatus.textContent = (r.data && r.data.error) || 'Something went wrong.';
        reviewStatus.style.color = 'var(--coral-ink)';
        return;
      }
      closeReview();
      if (action === 'approve') {
        setTableStatus(isDelete ? 'Entry deleted.' : 'Approved and published.');
      } else {
        setTableStatus(isDelete ? 'Kept live.' : 'Rejected.');
      }
      load();
    });
  }

  approveBtn.addEventListener('click', function () { decide('approve'); });
  rejectBtn.addEventListener('click', function () {
    var msg = reviewingItem && reviewingItem.type === 'delete'
      ? 'Keep this entry live? The removal request will be dismissed.'
      : 'Reject this proposal? The participant\'s live page stays unchanged.';
    confirmDialog(msg, reviewingItem && reviewingItem.type === 'delete' ? 'Keep it' : 'Reject').then(function (ok) {
      if (ok) decide('reject');
    });
  });

  function render() {
    if (!items.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="text-muted">No pending proposals.</td></tr>';
      return;
    }
    tbody.innerHTML = '';
    items.forEach(function (item) {
      var tr = document.createElement('tr');

      var tdPhoto = document.createElement('td');
      var img = document.createElement('img');
      img.src = item.current_photo_url || '';
      img.alt = '';
      img.style.cssText = 'width:2.5rem;height:2.5rem;border-radius:.5rem;object-fit:cover;border:1px solid rgba(25,23,18,.2)';
      tdPhoto.appendChild(img);
      tr.appendChild(tdPhoto);

      var tdName = document.createElement('td');
      tdName.textContent = item.current_name;
      tr.appendChild(tdName);

      var tdType = document.createElement('td');
      var typeTag = document.createElement('span');
      typeTag.className = 'tag';
      if (item.type === 'delete') {
        typeTag.textContent = 'Deletion request';
        typeTag.style.background = 'var(--coral)';
      } else {
        typeTag.textContent = 'Edit';
        typeTag.style.background = 'var(--paper-2)';
      }
      tdType.appendChild(typeTag);
      tr.appendChild(tdType);

      var tdSubmitted = document.createElement('td');
      tdSubmitted.textContent = formatDate(item.submitted_at);
      tr.appendChild(tdSubmitted);

      var tdActions = document.createElement('td');
      var reviewBtn = document.createElement('button');
      reviewBtn.type = 'button';
      reviewBtn.className = 'btn btn-accent !py-1.5 !px-3 text-xs';
      reviewBtn.textContent = 'Review';
      reviewBtn.addEventListener('click', function () { openReview(item); });
      tdActions.appendChild(reviewBtn);
      tr.appendChild(tdActions);

      tbody.appendChild(tr);
    });
  }

  function load() {
    setTableStatus('');
    adminFetch('/api/admin/dots-edits?status=pending').then(function (r) {
      if (!r.ok) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-muted">Could not load proposals.</td></tr>';
        setTableStatus((r.data && r.data.error) || 'Failed to load proposals.', true);
        return;
      }
      items = r.data.items || [];
      render();
      var badge = document.getElementById('editsCountBadge');
      if (badge) {
        badge.hidden = !items.length;
        badge.textContent = items.length;
      }
    });
  }

  document.addEventListener('admin:ready', function () {
    load();
  });
})();
</script>
<style>
  .block-dragging { opacity: .6; box-shadow: 0 8px 16px rgba(25,23,18,.25); transform: scale(1.01); }
</style>

</div>
<div id="panel-codes" class="dots-panel" hidden>
<p class="text-sm text-muted mb-6">Generate a code per real participant and share it with them directly — that's what unlocks the submission form at /dots/alumni/submit/. It's single-use for creating their entry, but stays theirs permanently after that — the same code lets them edit their page (or ask for it to be removed) any time.</p>

<div class="card p-6 mb-8">
  <h2 class="h-card mb-4">Generate a code</h2>
  <form id="genForm" class="flex flex-wrap items-end gap-4">
    <div>
      <label class="form-label" for="genEdition">Edition</label>
      <input class="input" type="text" id="genEdition" name="edition" value="1" required style="width:8rem">
    </div>
    <div class="flex-1 min-w-[12rem]">
      <label class="form-label" for="genLabel">Label <span class="text-muted font-normal">(staff note only, optional)</span></label>
      <input class="input" type="text" id="genLabel" name="label" placeholder="e.g. the participant's name">
    </div>
    <button type="submit" id="genBtn" class="btn btn-accent">Generate</button>
  </form>
  <p id="genStatus" role="status" aria-live="polite" class="text-sm mt-3"></p>
  <div id="newCodeCard" hidden class="mt-4 rounded-xl border-2 border-ink p-5" style="background:var(--mint)22">
    <p class="text-sm text-muted">New code — share this with the participant:</p>
    <p class="font-mono text-2xl font-bold mt-1" id="newCodeValue"></p>
    <div class="flex flex-wrap gap-2 mt-3">
      <button type="button" class="btn !py-1.5 !px-3 text-xs" id="copyCodeBtn">Copy code</button>
      <button type="button" class="btn !py-1.5 !px-3 text-xs" id="copyLinkBtn">Copy submission link</button>
    </div>
  </div>
</div>

<div class="card overflow-x-auto">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Code</th>
        <th>Edition</th>
        <th>Label</th>
        <th>Status</th>
        <th>Created</th>
        <th>Submission</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="codesTbody">
      <tr><td colspan="7" class="text-muted">Loading…</td></tr>
    </tbody>
  </table>
</div>
<p id="codesTableStatus" role="status" aria-live="polite" class="mt-3 text-sm"></p>

<script>
(function () {
  var items = [];
  var genForm = document.getElementById('genForm');
  var genBtn = document.getElementById('genBtn');
  var genStatus = document.getElementById('genStatus');
  var newCodeCard = document.getElementById('newCodeCard');
  var newCodeValue = document.getElementById('newCodeValue');
  var tableStatus = document.getElementById('codesTableStatus');
  var tbody = document.getElementById('codesTbody');

  function setGenStatus(msg, isError) {
    genStatus.textContent = msg || '';
    genStatus.style.color = isError ? 'var(--coral-ink)' : '';
  }

  function setTableStatus(msg, isError) {
    tableStatus.textContent = msg || '';
    tableStatus.style.color = isError ? 'var(--coral-ink)' : '';
  }

  function formatDate(value) {
    if (!value) return '—';
    var d = new Date(value);
    if (isNaN(d.getTime())) return '—';
    return d.toLocaleDateString();
  }

  function render() {
    if (!items.length) {
      tbody.innerHTML = '<tr><td colspan="7" class="text-muted">No codes yet.</td></tr>';
      return;
    }
    tbody.innerHTML = '';
    items.forEach(function (item) {
      var tr = document.createElement('tr');

      var tdCode = document.createElement('td');
      tdCode.textContent = item.code;
      tdCode.className = 'font-mono';
      tr.appendChild(tdCode);

      var tdEdition = document.createElement('td');
      tdEdition.textContent = item.edition;
      tr.appendChild(tdEdition);

      var tdLabel = document.createElement('td');
      tdLabel.textContent = item.label || '—';
      tr.appendChild(tdLabel);

      var tdStatus = document.createElement('td');
      var tag = document.createElement('span');
      tag.className = 'tag';
      tag.textContent = item.used_at ? 'Used' : 'Unused';
      tag.style.background = item.used_at ? 'var(--paper-2)' : 'var(--mint)';
      tdStatus.appendChild(tag);
      tr.appendChild(tdStatus);

      var tdCreated = document.createElement('td');
      tdCreated.textContent = formatDate(item.created_at);
      tr.appendChild(tdCreated);

      var tdSubmission = document.createElement('td');
      if (item.alumnus_name) {
        var a = document.createElement('a');
        a.href = '/admin/dots/#alumni';
        a.addEventListener('click', function (e) {
          var alumniTabBtn = document.querySelector('.dots-tab[data-tab="alumni"]');
          if (alumniTabBtn) { e.preventDefault(); alumniTabBtn.click(); }
        });
        a.textContent = item.alumnus_name + ' (' + item.alumnus_status + ')';
        a.className = 'underline';
        tdSubmission.appendChild(a);
      } else {
        tdSubmission.textContent = '—';
      }
      tr.appendChild(tdSubmission);

      var tdActions = document.createElement('td');
      tdActions.style.whiteSpace = 'nowrap';

      var copyBtn = document.createElement('button');
      copyBtn.type = 'button';
      copyBtn.className = 'btn !py-1.5 !px-3 text-xs';
      copyBtn.textContent = 'Copy link';
      copyBtn.addEventListener('click', function () {
        navigator.clipboard.writeText(location.origin + '/dots/alumni/submit/?code=' + item.code);
        copyBtn.textContent = 'Copied!';
        setTimeout(function () { copyBtn.textContent = 'Copy link'; }, 1500);
      });
      tdActions.appendChild(copyBtn);

      var regenBtn = document.createElement('button');
      regenBtn.type = 'button';
      regenBtn.className = 'btn !py-1.5 !px-3 text-xs ml-2';
      regenBtn.textContent = 'Regenerate';
      regenBtn.title = 'Replace this code with a new one -- the old one stops working immediately';
      regenBtn.addEventListener('click', function () { regenerateCode(item.id, item.code, regenBtn); });
      tdActions.appendChild(regenBtn);

      var delBtn = document.createElement('button');
      delBtn.type = 'button';
      delBtn.className = 'btn btn-coral !py-1.5 !px-3 text-xs ml-2';
      delBtn.textContent = 'Revoke';
      delBtn.addEventListener('click', function () { revokeCode(item.id, item.code, delBtn); });
      tdActions.appendChild(delBtn);
      tr.appendChild(tdActions);

      tbody.appendChild(tr);
    });
  }

  function load() {
    setTableStatus('');
    adminFetch('/api/admin/dots-codes').then(function (r) {
      if (!r.ok) {
        tbody.innerHTML = '<tr><td colspan="7" class="text-muted">Could not load codes.</td></tr>';
        setTableStatus(r.data && r.data.error ? r.data.error : 'Failed to load codes.', true);
        return;
      }
      items = r.data.items || [];
      render();
    });
  }

  function revokeCode(id, code, btn) {
    confirmDialog('Revoke code "' + code + '"? This cannot be undone.', 'Revoke').then(function (ok) {
      if (!ok) return;
      btn.disabled = true;
      setTableStatus('');
      adminFetch('/api/admin/dots-codes/' + id, { method: 'DELETE' }).then(function (r) {
        if (!r.ok) {
          btn.disabled = false;
          setTableStatus(r.data && r.data.error ? r.data.error : 'Failed to revoke.', true);
          return;
        }
        load();
      });
    });
  }

  // Regenerating swaps the code string on the SAME row (same participant
  // link, same used/unused history) -- the old code stops working the
  // moment this succeeds, so this is what staff use for "my code might
  // have leaked, give me a new one" without disturbing the participant's
  // actual page.
  function regenerateCode(id, oldCode, btn) {
    confirmDialog('Replace code "' + oldCode + '" with a new one? The old code will stop working immediately.', 'Regenerate').then(function (ok) {
      if (!ok) return;
      btn.disabled = true;
      setTableStatus('');
      adminFetch('/api/admin/dots-codes/' + id, { method: 'PUT' }).then(function (r) {
        btn.disabled = false;
        if (!r.ok) {
          setTableStatus(r.data && r.data.error ? r.data.error : 'Failed to regenerate.', true);
          return;
        }
        newCodeValue.textContent = r.data.code;
        newCodeCard.hidden = false;
        newCodeCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
        document.getElementById('copyCodeBtn').onclick = function () { navigator.clipboard.writeText(r.data.code); };
        document.getElementById('copyLinkBtn').onclick = function () {
          navigator.clipboard.writeText(location.origin + '/dots/alumni/submit/?code=' + r.data.code);
        };
        load();
      });
    });
  }

  genForm.addEventListener('submit', function (e) {
    e.preventDefault();
    var edition = document.getElementById('genEdition').value.trim();
    var label = document.getElementById('genLabel').value.trim();

    genBtn.disabled = true;
    setGenStatus('Generating…');
    newCodeCard.hidden = true;

    adminFetch('/api/admin/dots-codes', { method: 'POST', body: JSON.stringify({ edition: edition, label: label }) }).then(function (r) {
      genBtn.disabled = false;
      if (!r.ok) {
        setGenStatus(r.data && r.data.error ? r.data.error : 'Something went wrong.', true);
        return;
      }
      setGenStatus('');
      newCodeValue.textContent = r.data.code;
      newCodeCard.hidden = false;
      document.getElementById('copyCodeBtn').onclick = function () { navigator.clipboard.writeText(r.data.code); };
      document.getElementById('copyLinkBtn').onclick = function () {
        navigator.clipboard.writeText(location.origin + '/dots/alumni/submit/?code=' + r.data.code);
      };
      document.getElementById('genLabel').value = '';
      load();
    });
  });

  document.addEventListener('admin:ready', function () {
    load();
  });
})();
</script>

</div>

<style>
  .dots-tab { padding:.6rem 1.1rem; border:2px solid var(--ink); border-radius:.75rem; background:#fff; font-weight:700; font-size:.875rem; cursor:pointer; }
  .dots-tab.active { background:var(--ink); color:#fff; }
  .dots-tab .tag { color:#191712; }
</style>

<script>
(function () {
  var tabs = Array.prototype.slice.call(document.querySelectorAll('.dots-tab'));
  var panels = {
    alumni: document.getElementById('panel-alumni'),
    edits: document.getElementById('panel-edits'),
    codes: document.getElementById('panel-codes'),
  };
  function showTab(name) {
    if (!panels[name]) name = 'alumni';
    tabs.forEach(function (t) { t.classList.toggle('active', t.dataset.tab === name); });
    Object.keys(panels).forEach(function (k) { panels[k].hidden = k !== name; });
    if (window.history && history.replaceState) history.replaceState(null, '', '#' + name);
  }
  tabs.forEach(function (t) { t.addEventListener('click', function () { showTab(t.dataset.tab); }); });
  // All three tabs' own load() calls already fire together off the single
  // admin:ready event below (each panel just starts out hidden via CSS),
  // so switching tabs is instant -- nothing re-fetches on click.
  showTab((location.hash || '#alumni').slice(1));
})();
</script>
