---
layout: admin-base.njk
title: "DOTS Edits"
permalink: /admin/dots-edits/
---
<div class="flex flex-wrap items-center justify-between gap-4 mb-8">
  <div>
    <p class="eyebrow" style="color:var(--coral-ink)">Admin</p>
    <h1 class="h-sec mt-1">DOTS Edit proposals</h1>
    <p class="text-sm text-muted mt-1">Alumni reuse their access code to propose changes to their own page, or to ask for it to be removed. Nothing here happens until you approve it.</p>
  </div>
</div>

<div class="card overflow-x-auto">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Photo</th>
        <th>Name</th>
        <th>Type</th>
        <th>Submitted</th>
        <th></th>
      </tr>
    </thead>
    <tbody id="editsTbody">
      <tr><td colspan="5" class="text-muted">Loading…</td></tr>
    </tbody>
  </table>
</div>
<p id="tableStatus" role="status" aria-live="polite" class="mt-3 text-sm"></p>

<div id="reviewOverlay" style="display:none; position:fixed; inset:0; background:rgba(25,23,18,.6); z-index:100; overflow-y:auto;">
  <div style="max-width:72rem; margin:2.5rem auto; padding:0 1rem 3rem;">
    <div class="flex justify-end mb-3">
      <button type="button" id="reviewCloseBtn" class="btn">{% icon "close", "w-4 h-4" %} Close</button>
    </div>

    <div id="changesSummary" class="card p-5 mb-4"></div>

    <div id="deleteReviewCard" class="card p-6" hidden style="background:var(--coral)11">
      <p class="font-semibold" style="color:var(--coral-ink)">This person has asked to have their page removed entirely.</p>
      <p class="text-sm text-muted mt-2">Approving will permanently delete their entry from the site.</p>
    </div>

    <div id="editReviewGrid" class="grid md:grid-cols-2 gap-4">
      <div class="rounded-2xl border-2 border-ink overflow-hidden" style="background:#fff">
        <p class="text-xs font-bold uppercase tracking-wide p-3" style="background:var(--paper-2)">Before — currently live</p>
        <div id="reviewCurrent" style="padding:1.5rem;"></div>
      </div>
      <div class="rounded-2xl border-2 border-ink overflow-hidden" style="background:#fff">
        <p class="text-xs font-bold uppercase tracking-wide p-3 flex items-center justify-between gap-2" style="background:var(--mint)">
          <span>After — you can edit this before approving</span>
          <button type="button" id="resetProposedBtn" class="btn !py-1 !px-2 text-xs" style="background:#fff">Reset to their original</button>
        </p>
        <div style="padding:1.25rem;" class="flex flex-col gap-4">
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="form-label" for="p_name">Name *</label>
              <input class="input text-sm" type="text" id="p_name" maxlength="100">
            </div>
            <div>
              <label class="form-label" for="p_pronouns">Pronouns</label>
              <input class="input text-sm" type="text" id="p_pronouns" maxlength="30">
            </div>
          </div>

          <div>
            <p class="form-label">Photo</p>
            <input type="hidden" id="p_photo_url">
            <div id="p_photoEmpty">
              <label class="btn !py-1.5 !px-3 text-xs cursor-pointer inline-flex">📷 Add a photo<input type="file" id="p_photoFile" accept="image/jpeg,image/png,image/webp" class="sr-only"></label>
            </div>
            <div id="p_photoFilled" hidden class="flex items-center gap-3">
              <img id="p_photoPreview" src="" alt="" class="w-16 h-16 rounded-lg object-cover border-2 border-ink">
              <div class="flex gap-2">
                <label class="btn !py-1 !px-2 text-xs cursor-pointer inline-flex">Change<input type="file" id="p_photoFileChange" accept="image/jpeg,image/png,image/webp" class="sr-only"></label>
                <button type="button" id="p_photoRemoveBtn" class="btn btn-coral !py-1 !px-2 text-xs">Remove</button>
              </div>
            </div>
            <p id="p_photoStatus" role="status" aria-live="polite" class="text-xs mt-1 text-muted"></p>
          </div>

          <div>
            <label class="form-label" for="p_bio">Bio *</label>
            <textarea class="input text-sm" id="p_bio" rows="3" maxlength="600"></textarea>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="form-label" for="p_role">What they're up to</label>
              <input class="input text-sm" type="text" id="p_role" maxlength="120">
            </div>
            <div>
              <label class="form-label" for="p_location">Based in</label>
              <input class="input text-sm" type="text" id="p_location" maxlength="80">
            </div>
          </div>

          <div>
            <label class="form-label" for="p_quote">Quote</label>
            <input class="input text-sm" type="text" id="p_quote" maxlength="300">
          </div>

          <div>
            <label class="form-label" for="p_story">Story</label>
            <textarea class="input text-sm" id="p_story" rows="4" maxlength="4000"></textarea>
          </div>

          <div>
            <p class="form-label">Links</p>
            <div class="flex flex-col gap-2 mt-1">
              <input class="input text-sm" type="text" id="p_instagram" placeholder="Instagram" maxlength="300">
              <input class="input text-sm" type="text" id="p_linkedin" placeholder="LinkedIn" maxlength="300">
              <input class="input text-sm" type="text" id="p_website" placeholder="Website" maxlength="300">
            </div>
          </div>

          <div>
            <p class="form-label">More photos</p>
            <div id="p_extraPhotosGrid" class="grid grid-cols-4 gap-2 mb-2"></div>
            <label id="p_addExtraPhotoBtn" class="btn !py-1 !px-2 text-xs cursor-pointer inline-flex">+ Add a photo<input type="file" id="p_extraPhotoFile" accept="image/jpeg,image/png,image/webp" class="sr-only"></label>
            <p id="p_extraPhotoStatus" role="status" aria-live="polite" class="text-xs mt-1 text-muted"></p>
          </div>
        </div>
      </div>
    </div>

    <div class="flex items-center gap-3 mt-4 justify-center">
      <button type="button" id="approveBtn" class="btn btn-accent">Approve &amp; publish</button>
      <button type="button" id="rejectBtn" class="btn btn-coral">Reject</button>
    </div>
    <p id="reviewStatus" role="status" aria-live="polite" class="text-sm text-center mt-3"></p>
  </div>
</div>

<script>
(function () {
  var items = [];
  var reviewingId = null;
  var reviewingItem = null;
  var originalProposed = {};
  var extraPhotos = [];
  var MAX_EXTRA_PHOTOS = 6;

  var tbody = document.getElementById('editsTbody');
  var tableStatus = document.getElementById('tableStatus');
  var reviewOverlay = document.getElementById('reviewOverlay');
  var changesSummary = document.getElementById('changesSummary');
  var deleteReviewCard = document.getElementById('deleteReviewCard');
  var editReviewGrid = document.getElementById('editReviewGrid');
  var reviewCurrent = document.getElementById('reviewCurrent');
  var resetProposedBtn = document.getElementById('resetProposedBtn');
  var reviewCloseBtn = document.getElementById('reviewCloseBtn');
  var approveBtn = document.getElementById('approveBtn');
  var rejectBtn = document.getElementById('rejectBtn');
  var reviewStatus = document.getElementById('reviewStatus');

  function setTableStatus(msg, isError) {
    tableStatus.textContent = msg || '';
    tableStatus.style.color = isError ? 'var(--coral-ink)' : '';
  }

  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]; }); }
  function safeParseArr(str) { try { return JSON.parse(str || 'null'); } catch (e) { return null; } }

  function isUnified(blocks) {
    return Array.isArray(blocks) && blocks.some(function (b) { return b.type === 'name'; });
  }

  // Renders one block list in order, matching src/dots/alumni-profile.njk's
  // unified branch -- only ever needed for the read-only "Before" pane, for
  // a currently-live entry that was built through the since-retired
  // drag-and-drop page builder and hasn't been edited since. Any proposal
  // reviewed here saves flat fields only, so this can never appear on the
  // "After" side.
  function renderBlockList(blocks) {
    var html = '';
    blocks.forEach(function (block) {
      if (block.type === 'name') {
        html += '<h2 class="h-card">' + esc(block.text) + (block.pronouns ? ' <span class="text-muted" style="font-size:.6em">(' + esc(block.pronouns) + ')</span>' : '') + '</h2>';
      } else if (block.type === 'photo') {
        if (block.url) html += '<img src="' + esc(block.url) + '" alt="" style="width:100%;max-height:16rem;object-fit:cover;border-radius:1rem;border:2px solid var(--ink);margin:.75rem 0">';
      } else if (block.type === 'bio') {
        html += '<p class="mt-2 text-muted leading-relaxed">' + esc(block.text) + '</p>';
      } else if (block.type === 'subtitle') {
        if (block.role) html += '<p class="font-semibold mt-2">' + esc(block.role) + '</p>';
        if (block.location) html += '<p class="text-sm text-muted">' + esc(block.location) + '</p>';
      } else if (block.type === 'quote') {
        html += '<blockquote class="card p-3 mt-3 text-sm" style="border-left:3px solid var(--coral-ink);font-style:italic">“' + esc(block.text) + '”</blockquote>';
      } else if (block.type === 'links') {
        html += '<div class="flex flex-wrap gap-2 mt-3">';
        if (block.instagram) html += '<span class="btn !py-1 !px-2.5 text-xs" style="pointer-events:none">Instagram</span>';
        if (block.linkedin) html += '<span class="btn !py-1 !px-2.5 text-xs" style="pointer-events:none">LinkedIn</span>';
        if (block.website) html += '<span class="btn !py-1 !px-2.5 text-xs" style="pointer-events:none">Website</span>';
        html += '</div>';
      } else if (block.type === 'heading') {
        html += '<h3 class="h-card mt-4">' + esc(block.text) + '</h3>';
      } else if (block.type === 'paragraph') {
        html += '<p class="text-muted leading-relaxed mt-2" style="white-space:pre-line">' + esc(block.text) + '</p>';
      } else if (block.type === 'image') {
        if (block.url) html += '<img src="' + esc(block.url) + '" alt="" style="width:100%;max-height:14rem;object-fit:cover;border-radius:.75rem;border:2px solid var(--ink);margin-top:1rem">';
        if (block.caption) html += '<p class="text-xs text-muted mt-1">' + esc(block.caption) + '</p>';
      } else if (block.type === 'gallery' && Array.isArray(block.images)) {
        html += '<div class="grid gap-2 mt-3" style="grid-template-columns:repeat(auto-fill,minmax(6rem,1fr))">';
        block.images.forEach(function (url) { html += '<img src="' + esc(url) + '" alt="" style="width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:.5rem;border:2px solid var(--ink)">'; });
        html += '</div>';
      } else if (block.type === 'button') {
        html += '<div class="mt-3"><span class="btn btn-accent !py-1.5 !px-3 text-xs" style="pointer-events:none">' + esc(block.label) + '</span>' +
          '<p class="text-xs text-muted mt-1">&rarr; ' + esc(block.href || '(no link set)') + '</p></div>';
      } else if (block.type === 'spacer') {
        html += '<div style="height:' + (Number(block.height) || 40) + 'px"></div>';
      }
    });
    return html;
  }

  function renderLegacyFallback(data) {
    var html = '';
    if (data.photo_url) html += '<img src="' + esc(data.photo_url) + '" alt="" style="width:100%;max-height:16rem;object-fit:cover;border-radius:1rem;border:2px solid var(--ink);margin-bottom:1.5rem">';
    html += '<h2 class="h-card">' + esc(data.name) + (data.pronouns ? ' <span class="text-muted" style="font-size:.6em">(' + esc(data.pronouns) + ')</span>' : '') + '</h2>';
    if (data.current_role) html += '<p class="font-semibold mt-1">' + esc(data.current_role) + '</p>';
    if (data.location) html += '<p class="text-sm text-muted">' + esc(data.location) + '</p>';
    html += '<p class="mt-3 text-muted leading-relaxed">' + esc(data.bio) + '</p>';
    if (data.quote) html += '<blockquote class="card p-3 mt-3 text-sm" style="border-left:3px solid var(--coral-ink);font-style:italic">“' + esc(data.quote) + '”</blockquote>';
    var links = safeParseArr(data.links_json) || [];
    if (links.length) {
      html += '<div class="flex flex-wrap gap-2 mt-4">';
      links.forEach(function (l) { html += '<span class="btn !py-1 !px-2.5 text-xs" style="pointer-events:none">' + esc(l.label) + '</span>'; });
      html += '</div>';
    }
    if (data.story) html += '<div class="card p-4 mt-6"><p class="text-xs font-bold uppercase tracking-wide mb-2 text-muted">Story</p><p class="text-sm text-muted leading-relaxed" style="white-space:pre-line">' + esc(data.story) + '</p></div>';
    var photos = safeParseArr(data.photos_json) || [];
    if (photos.length) {
      html += '<div class="mt-6"><p class="text-xs font-bold uppercase tracking-wide mb-2 text-muted">More photos</p><div class="grid gap-2" style="grid-template-columns:repeat(auto-fill,minmax(6rem,1fr))">';
      photos.forEach(function (url) { html += '<img src="' + esc(url) + '" alt="" style="width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:.5rem;border:2px solid var(--ink)">'; });
      html += '</div></div>';
    }
    return html;
  }

  // Renders the read-only "Before" pane -- from a flat-field data object
  // (current_* columns), same shape the row already comes in as.
  function renderCurrent(data) {
    var blocks = safeParseArr(data.blocks_json);
    if (isUnified(blocks)) return renderBlockList(blocks);
    return renderLegacyFallback(data);
  }

  function uploadAdminImage(file, onDone) {
    var fd = new FormData();
    fd.append('file', file);
    adminFetch('/api/admin/upload', { method: 'POST', body: fd }).then(function (r) {
      onDone(r.ok ? r.data.url : null, r.ok ? null : (r.data && r.data.error));
    });
  }

  // --- Editable "After" fields --------------------------------------------
  var p_photo_url = document.getElementById('p_photo_url');
  var p_photoEmpty = document.getElementById('p_photoEmpty');
  var p_photoFilled = document.getElementById('p_photoFilled');
  var p_photoPreview = document.getElementById('p_photoPreview');
  var p_photoStatus = document.getElementById('p_photoStatus');

  function setProposedPhoto(url) {
    p_photo_url.value = url || '';
    if (url) {
      p_photoPreview.src = url;
      p_photoEmpty.hidden = true;
      p_photoFilled.hidden = false;
    } else {
      p_photoEmpty.hidden = false;
      p_photoFilled.hidden = true;
    }
  }

  function handleProposedPhotoFile(file) {
    if (!file) return;
    p_photoStatus.style.color = '';
    p_photoStatus.textContent = 'Uploading…';
    uploadAdminImage(file, function (url, err) {
      p_photoStatus.textContent = '';
      if (!url) {
        p_photoStatus.style.color = 'var(--coral-ink)';
        p_photoStatus.textContent = err || 'Upload failed — try again.';
        return;
      }
      setProposedPhoto(url);
    });
  }
  document.getElementById('p_photoFile').addEventListener('change', function (e) { handleProposedPhotoFile(e.target.files[0]); e.target.value = ''; });
  document.getElementById('p_photoFileChange').addEventListener('change', function (e) { handleProposedPhotoFile(e.target.files[0]); e.target.value = ''; });
  document.getElementById('p_photoRemoveBtn').addEventListener('click', function () { setProposedPhoto(''); });

  var p_extraPhotosGrid = document.getElementById('p_extraPhotosGrid');
  var p_extraPhotoStatus = document.getElementById('p_extraPhotoStatus');
  var p_addExtraPhotoBtn = document.getElementById('p_addExtraPhotoBtn');

  function renderProposedExtraPhotos() {
    p_extraPhotosGrid.innerHTML = '';
    extraPhotos.forEach(function (url, i) {
      var wrap = document.createElement('div');
      wrap.style.cssText = 'position:relative';
      var img = document.createElement('img');
      img.src = url; img.alt = '';
      img.className = 'w-full aspect-square object-cover rounded-lg border-2 border-ink';
      var rm = document.createElement('button');
      rm.type = 'button'; rm.textContent = '×';
      rm.setAttribute('aria-label', 'Remove this photo');
      rm.style.cssText = 'position:absolute;top:-.4rem;right:-.4rem;width:1.25rem;height:1.25rem;border-radius:999px;background:var(--coral);border:2px solid var(--ink);font-weight:700;line-height:1;font-size:.7rem';
      rm.addEventListener('click', function () { extraPhotos.splice(i, 1); renderProposedExtraPhotos(); });
      wrap.appendChild(img); wrap.appendChild(rm);
      p_extraPhotosGrid.appendChild(wrap);
    });
    p_addExtraPhotoBtn.style.display = extraPhotos.length >= MAX_EXTRA_PHOTOS ? 'none' : '';
  }
  document.getElementById('p_extraPhotoFile').addEventListener('change', function (e) {
    var file = e.target.files[0];
    e.target.value = '';
    if (!file || extraPhotos.length >= MAX_EXTRA_PHOTOS) return;
    p_extraPhotoStatus.style.color = '';
    p_extraPhotoStatus.textContent = 'Uploading…';
    uploadAdminImage(file, function (url, err) {
      p_extraPhotoStatus.textContent = '';
      if (!url) {
        p_extraPhotoStatus.style.color = 'var(--coral-ink)';
        p_extraPhotoStatus.textContent = err || 'Upload failed — try again.';
        return;
      }
      extraPhotos.push(url);
      renderProposedExtraPhotos();
    });
  });

  function fillProposedFields(p) {
    document.getElementById('p_name').value = p.name || '';
    document.getElementById('p_pronouns').value = p.pronouns || '';
    document.getElementById('p_bio').value = p.bio || '';
    document.getElementById('p_role').value = p.current_role || '';
    document.getElementById('p_location').value = p.location || '';
    document.getElementById('p_quote').value = p.quote || '';
    document.getElementById('p_story').value = p.story || '';
    setProposedPhoto(p.photo_url || '');
    var links = safeParseArr(p.links_json) || [];
    document.getElementById('p_instagram').value = (links.find(function (l) { return l.label === 'Instagram'; }) || {}).url || '';
    document.getElementById('p_linkedin').value = (links.find(function (l) { return l.label === 'LinkedIn'; }) || {}).url || '';
    document.getElementById('p_website').value = (links.find(function (l) { return l.label === 'Website'; }) || {}).url || '';
    extraPhotos = (safeParseArr(p.photos_json) || []).slice(0, MAX_EXTRA_PHOTOS);
    renderProposedExtraPhotos();
  }

  function readProposedFields() {
    var links = [];
    var ig = document.getElementById('p_instagram').value.trim();
    var li = document.getElementById('p_linkedin').value.trim();
    var web = document.getElementById('p_website').value.trim();
    if (ig) links.push({ label: 'Instagram', url: ig });
    if (li) links.push({ label: 'LinkedIn', url: li });
    if (web) links.push({ label: 'Website', url: web });
    return {
      name: document.getElementById('p_name').value.trim(),
      pronouns: document.getElementById('p_pronouns').value.trim(),
      bio: document.getElementById('p_bio').value.trim(),
      current_role: document.getElementById('p_role').value.trim(),
      location: document.getElementById('p_location').value.trim(),
      quote: document.getElementById('p_quote').value.trim(),
      story: document.getElementById('p_story').value.trim(),
      photo_url: p_photo_url.value || '',
      photos: extraPhotos.slice(),
      links: links,
    };
  }

  resetProposedBtn.addEventListener('click', function () {
    fillProposedFields(originalProposed);
  });

  // --- What-changed summary ----------------------------------------------
  var FIELD_LABELS = { name: 'Name', pronouns: 'Pronouns', bio: 'Bio', photo_url: 'Photo', current_role: "What they're up to", location: 'Location', quote: 'Quote', story: 'Story' };

  function deriveCoreFromBlocks(blocks) {
    var find = function (t) { return (blocks || []).find(function (b) { return b.type === t; }); };
    var n = find('name'), b = find('bio'), p = find('photo'), q = find('quote'), s = find('subtitle');
    return {
      name: (n && n.text) || '', pronouns: (n && n.pronouns) || '', bio: (b && b.text) || '',
      photo_url: (p && p.url) || '', current_role: (s && s.role) || '', location: (s && s.location) || '', quote: (q && q.text) || '', story: '',
    };
  }

  function renderChangesSummary(currentCore, proposedCore) {
    var rows = [];
    Object.keys(FIELD_LABELS).forEach(function (key) {
      var oldVal = currentCore[key] || '';
      var newVal = proposedCore[key] || '';
      if (oldVal !== newVal) {
        var oldDisplay = key === 'photo_url' ? (oldVal ? 'a photo' : 'no photo') : (oldVal || '(empty)');
        var newDisplay = key === 'photo_url' ? (newVal ? 'a new photo' : 'no photo') : (newVal || '(empty)');
        rows.push('<li><strong>' + esc(FIELD_LABELS[key]) + ':</strong> <span class="text-muted">' + esc(oldDisplay) + '</span> <span class="mx-1">→</span> <span style="color:var(--mint-ink);font-weight:600">' + esc(newDisplay) + '</span></li>');
      }
    });
    if (!rows.length) {
      changesSummary.innerHTML = '<p class="eyebrow" style="color:var(--coral-ink)">What changed</p><p class="text-sm text-muted mt-2">Nothing changed in the main fields — links or extra photos may still differ, compare the two panels below.</p>';
    } else {
      changesSummary.innerHTML = '<p class="eyebrow" style="color:var(--coral-ink)">What changed</p><ul class="mt-2 space-y-1 text-sm">' + rows.join('') + '</ul>';
    }
  }

  function formatDate(value) {
    if (!value) return '—';
    var d = new Date(value);
    if (isNaN(d.getTime())) return '—';
    return d.toLocaleDateString();
  }

  function openReview(item) {
    reviewingId = item.id;
    reviewingItem = item;
    var currentData = {
      name: item.current_name, pronouns: item.current_pronouns,
      current_role: item.current_current_role, location: item.current_location,
      quote: item.current_quote, bio: item.current_bio, story: item.current_story,
      photo_url: item.current_photo_url, photos_json: item.current_photos_json,
      links_json: item.current_links_json, blocks_json: item.current_blocks_json,
    };
    var proposed = {};
    try { proposed = JSON.parse(item.proposed_json); } catch (e) {}

    if (item.type === 'delete') {
      deleteReviewCard.hidden = false;
      editReviewGrid.hidden = true;
      changesSummary.hidden = true;
      approveBtn.textContent = 'Approve deletion';
      rejectBtn.textContent = 'Keep page live';
    } else {
      deleteReviewCard.hidden = true;
      editReviewGrid.hidden = false;
      changesSummary.hidden = false;
      approveBtn.textContent = 'Approve & publish';
      rejectBtn.textContent = 'Reject';

      reviewCurrent.innerHTML = renderCurrent(currentData);

      originalProposed = proposed;
      fillProposedFields(proposed);

      var currentBlocks = safeParseArr(currentData.blocks_json);
      var currentCore = isUnified(currentBlocks) ? deriveCoreFromBlocks(currentBlocks) : {
        name: currentData.name || '', pronouns: currentData.pronouns || '', bio: currentData.bio || '',
        photo_url: currentData.photo_url || '', current_role: currentData.current_role || '', location: currentData.location || '', quote: currentData.quote || '', story: currentData.story || '',
      };
      var proposedCore = {
        name: proposed.name || '', pronouns: proposed.pronouns || '', bio: proposed.bio || '',
        photo_url: proposed.photo_url || '', current_role: proposed.current_role || '', location: proposed.location || '', quote: proposed.quote || '', story: proposed.story || '',
      };
      renderChangesSummary(currentCore, proposedCore);
    }

    reviewStatus.textContent = '';
    reviewOverlay.style.display = 'block';
  }

  function closeReview() {
    reviewOverlay.style.display = 'none';
    reviewCurrent.innerHTML = '';
    extraPhotos = [];
    reviewingId = null;
    reviewingItem = null;
  }

  reviewCloseBtn.addEventListener('click', closeReview);
  reviewOverlay.addEventListener('click', function (e) { if (e.target === reviewOverlay) closeReview(); });

  function decide(action) {
    if (!reviewingId) return;
    var isDelete = reviewingItem && reviewingItem.type === 'delete';
    var fields = null;

    if (action === 'approve' && !isDelete) {
      fields = readProposedFields();
      if (!fields.name || !fields.bio) {
        reviewStatus.style.color = 'var(--coral-ink)';
        reviewStatus.textContent = 'Name and bio are both required before you can approve this.';
        return;
      }
    }

    approveBtn.disabled = true;
    rejectBtn.disabled = true;
    reviewStatus.textContent = 'Saving…';
    reviewStatus.style.color = '';
    var payload = { action: action };
    if (fields) payload.fields = fields;
    adminFetch('/api/admin/dots-edits/' + reviewingId, { method: 'PUT', body: JSON.stringify(payload) }).then(function (r) {
      approveBtn.disabled = false;
      rejectBtn.disabled = false;
      if (!r.ok) {
        reviewStatus.textContent = (r.data && r.data.error) || 'Something went wrong.';
        reviewStatus.style.color = 'var(--coral-ink)';
        return;
      }
      closeReview();
      if (action === 'approve') {
        setTableStatus(isDelete ? 'Entry deleted.' : 'Approved and published.');
      } else {
        setTableStatus(isDelete ? 'Kept live.' : 'Rejected.');
      }
      load();
    });
  }

  approveBtn.addEventListener('click', function () { decide('approve'); });
  rejectBtn.addEventListener('click', function () {
    var msg = reviewingItem && reviewingItem.type === 'delete'
      ? 'Keep this entry live? The removal request will be dismissed.'
      : 'Reject this proposal? The participant\'s live page stays unchanged.';
    confirmDialog(msg, reviewingItem && reviewingItem.type === 'delete' ? 'Keep it' : 'Reject').then(function (ok) {
      if (ok) decide('reject');
    });
  });

  function render() {
    if (!items.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="text-muted">No pending proposals.</td></tr>';
      return;
    }
    tbody.innerHTML = '';
    items.forEach(function (item) {
      var tr = document.createElement('tr');

      var tdPhoto = document.createElement('td');
      var img = document.createElement('img');
      img.src = item.current_photo_url || '';
      img.alt = '';
      img.style.cssText = 'width:2.5rem;height:2.5rem;border-radius:.5rem;object-fit:cover;border:1px solid rgba(25,23,18,.2)';
      tdPhoto.appendChild(img);
      tr.appendChild(tdPhoto);

      var tdName = document.createElement('td');
      tdName.textContent = item.current_name;
      tr.appendChild(tdName);

      var tdType = document.createElement('td');
      var typeTag = document.createElement('span');
      typeTag.className = 'tag';
      if (item.type === 'delete') {
        typeTag.textContent = 'Deletion request';
        typeTag.style.background = 'var(--coral)';
      } else {
        typeTag.textContent = 'Edit';
        typeTag.style.background = 'var(--paper-2)';
      }
      tdType.appendChild(typeTag);
      tr.appendChild(tdType);

      var tdSubmitted = document.createElement('td');
      tdSubmitted.textContent = formatDate(item.submitted_at);
      tr.appendChild(tdSubmitted);

      var tdActions = document.createElement('td');
      var reviewBtn = document.createElement('button');
      reviewBtn.type = 'button';
      reviewBtn.className = 'btn btn-accent !py-1.5 !px-3 text-xs';
      reviewBtn.textContent = 'Review';
      reviewBtn.addEventListener('click', function () { openReview(item); });
      tdActions.appendChild(reviewBtn);
      tr.appendChild(tdActions);

      tbody.appendChild(tr);
    });
  }

  function load() {
    setTableStatus('');
    adminFetch('/api/admin/dots-edits?status=pending').then(function (r) {
      if (!r.ok) {
        tbody.innerHTML = '<tr><td colspan="5" class="text-muted">Could not load proposals.</td></tr>';
        setTableStatus((r.data && r.data.error) || 'Failed to load proposals.', true);
        return;
      }
      items = r.data.items || [];
      render();
    });
  }

  document.addEventListener('admin:ready', function () {
    load();
  });
})();
</script>
