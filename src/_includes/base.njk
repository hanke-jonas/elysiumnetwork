<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% set pageDescription = description or site.default_description %}
{% set pageTitle = title or site.network_full %}
<meta name="description" content="{{ pageDescription }}">
<meta name="theme-color" content="#F6F1E4">
<title>{{ pageTitle }}</title>
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<link rel="icon" type="image/png" sizes="32x32" href="{{ site.favicon_32 }}">
<link rel="icon" type="image/png" sizes="48x48" href="{{ site.favicon_48 }}">
<link rel="apple-touch-icon" href="{{ site.apple_touch_icon }}">

<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.network_full }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ site.og_image }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ site.url }}{{ site.og_image }}">

{% set orgSchema = { "@context": "https://schema.org", "@type": "NGO", "name": site.network_full, "alternateName": site.network_name, "url": site.url, "logo": site.url + site.logo_small, "description": site.default_description, "foundingDate": site.founded_year | string, "email": site.contact_email, "sameAs": site.socialUrls.concat([site.hub]), "areaServed": site.branchCountries } %}
<script type="application/ld+json">{{ orgSchema | dump | safe }}</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Caveat:wght@600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
{% include "theme-style.njk" %}
{#
  Tailwind loads AFTER the custom component styles above (not before) so
  its utilities reliably win any same-specificity tie against a custom
  class on the same element — e.g. `class="btn hidden"` needs `.hidden`'s
  display:none to beat `.btn`'s display:inline-flex. Loading Tailwind first
  was exactly backwards: it made `.hidden` silently lose that tie (confirmed
  live on the homepage's theme-card modal, where an unset CTA button stayed
  visibly rendered — blank text, stale href — instead of actually hiding).
#}
<link rel="stylesheet" href="/assets/tailwind.css">
</head>
<body class="bg-paper text-ink">
<a href="#main-content" class="skip-link">Skip to main content</a>
<div class="grain"></div>

<div class="ticker-bar">
  <div class="ticker-row max-w-[1400px] mx-auto">
    {% for b in site.branches %}
    <div class="ticker-item">
      <span class="ticker-dot" style="background:{{ b.accent }}"></span>
      <span class="mono text-[11px] opacity-60 uppercase tracking-wider">{{ b.city }}</span>
    </div>
    {% endfor %}
    <div class="ticker-item">
      <span class="mono text-[11px] opacity-60 uppercase tracking-wider">4 countries, one network</span>
    </div>
  </div>
</div>

<div class="scroll-progress" id="scrollProgress"></div>

<header class="navbar" id="navbar">
  <div class="max-w-[1400px] mx-auto px-5 sm:px-8 h-[4.5rem] flex items-center justify-between gap-6">
    <a href="/" id="wordmarkLink" class="flex flex-col shrink-0 group">
      <span class="flex items-center gap-2.5">
        <img src="{{ site.logo_small }}" alt="Elysium+" width="128" height="128" class="h-10 w-10 object-contain">
        <span class="font-display text-xl font-extrabold tracking-tight hidden sm:inline">Elysium<span style="color:var(--coral)">+</span></span>
      </span>
      <span class="wordmark-stripe hidden sm:block" title="purple, white &amp; green — the suffragette colours, still ours"></span>
    </a>
    <nav class="hidden lg:flex items-center gap-8">
      <a href="/" class="nav-link{% if page.url == '/' %} active{% endif %}">Home</a>
      <div class="nav-item-drop relative">
        <button class="nav-link nav-drop-btn inline-flex items-center gap-1.5" aria-haspopup="true" aria-expanded="false">Network {% icon "chevron", "w-3.5 h-3.5" %}</button>
        <div class="nav-drop">
          {% for b in site.branches %}
          <a href="/{{ b.slug }}/">
            <span class="text-lg">{{ b.flag }}</span>
            <span class="flex-1 min-w-0">
              <span class="block font-semibold">{{ b.name }}</span>
              <span class="block text-[11px] opacity-60 mono">{{ b.city }}</span>
            </span>
            {% heartFill b.accent, "w-3.5 h-3.5 shrink-0" %}
          </a>
          {% endfor %}
        </div>
      </div>
      <div class="nav-item-drop relative">
        <button class="nav-link nav-drop-btn inline-flex items-center gap-1.5" aria-haspopup="true" aria-expanded="false">Get Involved {% icon "chevron", "w-3.5 h-3.5" %}</button>
        <div class="nav-drop">
          <a href="/calls/">{% icon "compass", "w-4 h-4 shrink-0" %}<span class="flex-1 min-w-0"><span class="block font-semibold">Active calls</span></span></a>
          <a href="/events/">{% icon "calendar", "w-4 h-4 shrink-0" %}<span class="flex-1 min-w-0"><span class="block font-semibold">Events</span></span></a>
          <a href="/resources/">{% icon "box", "w-4 h-4 shrink-0" %}<span class="flex-1 min-w-0"><span class="block font-semibold">Resources</span></span></a>
          <a href="/support/">{% icon "heart", "w-4 h-4 shrink-0" %}<span class="flex-1 min-w-0"><span class="block font-semibold">Support Us</span></span></a>
        </div>
      </div>
      <div class="nav-item-drop relative">
        <button class="nav-link nav-drop-btn inline-flex items-center gap-1.5" aria-haspopup="true" aria-expanded="false">About {% icon "chevron", "w-3.5 h-3.5" %}</button>
        <div class="nav-drop">
          <a href="/about/">{% icon "id", "w-4 h-4 shrink-0" %}<span class="flex-1 min-w-0"><span class="block font-semibold">About Us</span></span></a>
          <a href="/blog/">{% icon "monitor", "w-4 h-4 shrink-0" %}<span class="flex-1 min-w-0"><span class="block font-semibold">Blog</span></span></a>
          <a href="/standards/">{% icon "venus", "w-4 h-4 shrink-0" %}<span class="flex-1 min-w-0"><span class="block font-semibold">Values &amp; Standards</span></span></a>
        </div>
      </div>
    </nav>
    <div class="hidden lg:flex items-center gap-3">
      <button class="search-trigger" onclick="openSearch(this)" aria-label="Search the site">
        {% icon "search", "w-4 h-4" %}<span class="label">Search</span><span class="kbd">/</span>
      </button>
      <a href="/contact/" class="nav-link{% if page.url == '/contact/' %} active{% endif %}">Contact</a>
      <a href="/account/login/" id="accountLink" class="nav-link">Log in</a>
      <a href="{{ site.join_form }}" class="btn btn-accent">Join Us {% icon "arrow-ur", "w-4 h-4" %}</a>
    </div>
    <div class="lg:hidden flex items-center gap-2">
      <button class="inline-grid place-items-center w-11 h-11 rounded-lg border-2 border-ink" onclick="openSearch(this)" aria-label="Search the site">{% icon "search", "w-5 h-5" %}</button>
      <button class="inline-grid place-items-center w-11 h-11 rounded-lg border-2 border-ink" onclick="openMMenu(this)" aria-label="Open menu">{% icon "menu", "w-5 h-5" %}</button>
    </div>
  </div>
</header>

