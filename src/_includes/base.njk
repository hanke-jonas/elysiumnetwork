          {% for s in site.socials %}
          <a href="{{ s.url }}" target="_blank" rel="noopener" class="w-10 h-10 grid place-items-center rounded-lg border-2 border-paper/25 hover:border-blue hover:text-blue transition" aria-label="{{ s.label }}">{% icon s.icon, "w-5 h-5" %}</a>
          {% endfor %}
