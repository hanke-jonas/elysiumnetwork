<script>
  function tickClocks(){
    document.querySelectorAll('.clock-time').forEach(function(el){
      var tz = el.getAttribute('data-tz');
      try{ el.textContent = new Intl.DateTimeFormat('en-GB',{timeZone:tz,hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false}).format(new Date()); }catch(e){}
    });
  }
  tickClocks(); setInterval(tickClocks,1000);

  function trapFocus(container){
    // Re-queried on every Tab press rather than cached once: containers like
    // the search overlay replace their entire results list on each keystroke,
    // which would otherwise leave first/last pointing at detached nodes.
    function getFocusable(){
      return container.querySelectorAll('a[href], button:not([disabled]), input, textarea, select, [tabindex]:not([tabindex="-1"])');
    }
    function handler(e){
      if (e.key !== 'Tab') return;
      var focusable = getFocusable();
      if (!focusable.length) return;
      var first = focusable[0], last = focusable[focusable.length - 1];
      if (e.shiftKey){
        if (document.activeElement === first){ e.preventDefault(); last.focus(); }
      } else {
        if (document.activeElement === last){ e.preventDefault(); first.focus(); }
      }
    }
    container.addEventListener('keydown', handler);
    return function(){ container.removeEventListener('keydown', handler); };
  }

  var mmenuTrigger = null, mmenuUntrap = null;
  function openMMenu(trigger){
    // Never stack two aria-modal dialogs — the search overlay must fully
    // close first (it's defined earlier in the page but always exists by
    // the time this runs, since it only fires on a later user interaction).
    if (typeof closeSearch === 'function') {
      var searchOverlay = document.getElementById('searchOverlay');
      if (searchOverlay && searchOverlay.classList.contains('open')) closeSearch();
    }
    mmenuTrigger = trigger || document.activeElement;
    var el = document.getElementById('mmenu');
    el.classList.add('open'); document.body.style.overflow='hidden';
    mmenuUntrap = trapFocus(el);
    // Deferred one frame: focusing a button in the same tick its container
    // leaves visibility:hidden isn't reliably honoured, which would leave
    // the Tab trap below pointing at a container nothing is focused inside.
    requestAnimationFrame(function(){
      var closeBtn = el.querySelector('button[aria-label="Close menu"]');
      if (closeBtn) closeBtn.focus();
    });
  }
  function closeMMenu(){
    var el = document.getElementById('mmenu');
    el.classList.remove('open'); document.body.style.overflow='';
    if (mmenuUntrap){ mmenuUntrap(); mmenuUntrap = null; }
    if (mmenuTrigger && mmenuTrigger.focus) mmenuTrigger.focus();
    mmenuTrigger = null;
  }
  document.addEventListener('keydown',function(e){ if(e.key==='Escape') closeMMenu(); });

  (function(){
    // Generalized over every `.nav-item-drop` (Network, Get Involved,
    // About, ...) instead of a single hardcoded id — each gets its own
    // independent open/close state via its own trigger button.
    document.querySelectorAll('.nav-item-drop').forEach(function(wrap){
      var btn = wrap.querySelector('.nav-drop-btn');
      if (!btn) return;
      function closeDrop(){ wrap.classList.remove('open'); btn.setAttribute('aria-expanded','false'); }
      function openDrop(){ wrap.classList.add('open'); btn.setAttribute('aria-expanded','true'); }
      btn.addEventListener('click', function(e){
        e.stopPropagation();
        var wasOpen = wrap.classList.contains('open');
        // stopPropagation above means the document-level "click outside"
        // listener never sees this click, so without this, opening one
        // dropdown wouldn't close a different one that's already open.
        document.querySelectorAll('.nav-item-drop.open').forEach(function(openWrap){
          if (openWrap !== wrap) {
            openWrap.classList.remove('open');
            var openBtn = openWrap.querySelector('.nav-drop-btn');
            if (openBtn) openBtn.setAttribute('aria-expanded', 'false');
          }
        });
        if (wasOpen) closeDrop(); else openDrop();
      });
      document.addEventListener('click', function(e){ if (!wrap.contains(e.target)) closeDrop(); });
      document.addEventListener('keydown', function(e){ if (e.key === 'Escape') closeDrop(); });
      // The panel is also revealed purely via CSS :focus-within (so Tab alone
      // opens it), but aria-expanded was only ever flipped by the click
      // handler above — this keeps the announced state in sync with what
      // keyboard users actually see.
      wrap.addEventListener('focusin', function(){ btn.setAttribute('aria-expanded', 'true'); });
      wrap.addEventListener('focusout', function(e){
        if (!wrap.contains(e.relatedTarget)) btn.setAttribute('aria-expanded', wrap.classList.contains('open') ? 'true' : 'false');
      });
    });
  })();

  // Shared heart-spawn helper — the mousemove cursor trail below uses it
  // directly; exposed on window so other pages (e.g. the homepage's hero
  // illustration) can reuse the exact same visual for their own moments
  // instead of drawing a second heart asset.
  window.elysiumSpawnHeart = function(x, y){
    var colors = ['#7C93D6','#FF6B54','#FFC93C','#59B37B','#B478D9'];
    var el = document.createElementNS('http://www.w3.org/2000/svg','svg');
    el.setAttribute('viewBox','0 0 24 24');
    el.className.baseVal = 'heart-cursor';
    el.style.left = x+'px'; el.style.top = y+'px';
    el.style.setProperty('--r', (Math.random()*40-20)+'deg');
    var c = colors[Math.floor(Math.random()*colors.length)];
    el.innerHTML = '<path fill="'+c+'" stroke="#191712" stroke-width="1" d="M12 21.35 10.55 20.03C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>';
    document.body.appendChild(el);
    setTimeout(function(){ el.remove(); }, 750);
  };

  (function(){
    if (window.matchMedia('(pointer:coarse)').matches) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var last = 0;
    window.addEventListener('mousemove', function(e){
      var now = Date.now(); if (now - last < 60) return; last = now;
      window.elysiumSpawnHeart(e.clientX, e.clientY);
    }, {passive:true});
  })();

  // Shared toast for hidden interactions below (and reusable from other
  // pages via window.elysiumShowEggToast) — one element, one animation,
  // rather than a bespoke popup per easter egg.
  window.elysiumShowEggToast = function(html){
    var toast = document.getElementById('eggToast');
    if (!toast) return;
    toast.innerHTML = html;
    toast.classList.add('show');
    clearTimeout(toast._hideTimer);
    toast._hideTimer = setTimeout(function(){ toast.classList.remove('show'); }, 4000);
  };

  // A small hello for anyone curious enough to open devtools.
  console.log(
    '%cEQUAL ACCESS. NO EXCEPTIONS.%c\n"Feminism is for everybody." — bell hooks\nBuilt by a youth network, for a youth network. Something to fix? contact@elysium.ngo',
    'background:#B478D9;color:#191712;font-weight:800;padding:5px 10px;border-radius:3px;font-family:monospace;font-size:13px',
    'font-family:monospace;font-size:12px;color:#5B5748'
  );

  // Typed sequence "1848" — the Seneca Falls Convention, a founding meeting
  // of the modern women's rights movement. Ignored while typing in a real
  // form field, same guard the mmenu/search Escape handlers rely on.
  (function(){
    var buf = '';
    document.addEventListener('keydown', function(e){
      var tag = (e.target && e.target.tagName || '').toLowerCase();
      if (tag === 'input' || tag === 'textarea' || (e.target && e.target.isContentEditable)) return;
      if (e.key >= '0' && e.key <= '9' && e.key.length === 1) {
        buf = (buf + e.key).slice(-4);
        if (buf === '1848') {
          window.elysiumShowEggToast('<span class="stamp" style="border-color:var(--plum);color:var(--plum-ink);background:#fff">Seneca Falls · 1848 — a founding meeting of the modern women’s rights movement</span>');
          buf = '';
        }
      } else if (e.key !== 'Shift') {
        buf = '';
      }
    });
  })();

  var io=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target);}});},{threshold:0.12});
  document.querySelectorAll('.reveal').forEach(function(el){
    // Content already in the initial viewport was never "revealed" by
    // scrolling — it's the first thing the visitor sees, so waiting on the
    // observer's first callback plus the .55s fade just reads as a blank
    // flash on every single page load. Show it immediately instead; only
    // genuinely below-the-fold elements get the scroll-triggered fade-up.
    var rect = el.getBoundingClientRect();
    if (rect.top < window.innerHeight && rect.bottom > 0) {
      el.style.transition = 'none';
      el.classList.add('in');
      void el.offsetHeight;
      el.style.transition = '';
    } else {
      io.observe(el);
    }
  });

  (function(){
    var bar = document.getElementById('scrollProgress');
    if (!bar) return;
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function update(){
      var h = document.documentElement;
      var scrollable = h.scrollHeight - h.clientHeight;
      var pct = scrollable > 0 ? (h.scrollTop / scrollable) * 100 : 0;
      bar.style.width = pct + '%';
    }
    if (!reduceMotion) {
      window.addEventListener('scroll', update, {passive:true});
      window.addEventListener('resize', update, {passive:true});
      update();
    }
  })();

  (function(){
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var els = document.querySelectorAll('.count-up');
    if (!els.length) return;
    function animate(el){
      var text = el.textContent.trim();
      var match = text.match(/^(\d[\d,]*)(.*)$/);
      if (!match) return;
      var target = parseInt(match[1].replace(/,/g,''), 10);
      var suffix = match[2];
      var duration = 1300;
      var start = null;
      function step(ts){
        if (!start) start = ts;
        var progress = Math.min((ts - start) / duration, 1);
        var eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = Math.floor(eased * target) + suffix;
        if (progress < 1) requestAnimationFrame(step);
        else el.textContent = target + suffix;
      }
      requestAnimationFrame(step);
    }
    var countIo = new IntersectionObserver(function(entries){
      entries.forEach(function(entry){
        if (entry.isIntersecting) { animate(entry.target); countIo.unobserve(entry.target); }
      });
    }, {threshold:0.6});
    els.forEach(function(el){ countIo.observe(el); });
  })();

  (function(){
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.querySelectorAll('.magnetic').forEach(function(btn){
      btn.addEventListener('mousemove', function(e){
        var rect = btn.getBoundingClientRect();
        var x = (e.clientX - rect.left - rect.width / 2) * 0.2;
        var y = (e.clientY - rect.top - rect.height / 2) * 0.2;
        btn.style.transform = 'translate(' + (x - 2) + 'px,' + (y - 2) + 'px)';
      });
      btn.addEventListener('mouseleave', function(){ btn.style.transform = ''; });
    });
  })();

  var newsletterForm = document.getElementById('newsletterForm');
  if (newsletterForm) {
    newsletterForm.addEventListener('submit', function(e){
      e.preventDefault();
      var msg = document.getElementById('newsletterMsg');
      var email = document.getElementById('newsletterEmail').value.trim();
      var btn = newsletterForm.querySelector('button[type="submit"]');
      btn.disabled = true;
      msg.textContent = 'Subscribing…';
      fetch('/api/newsletter/subscribe', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({email: email})
      }).then(function(res){ return res.json().then(function(data){ return {ok: res.ok, data: data}; }); })
        .then(function(r){
          if (!r.ok) { msg.textContent = r.data.error || 'Something went wrong — please try again.'; return; }
          msg.textContent = r.data.alreadySubscribed ? "You're already subscribed." : 'Check your inbox to confirm your subscription.';
          newsletterForm.reset();
        })
        .catch(function(){ msg.textContent = 'Something went wrong — please try again.'; })
        .finally(function(){ btn.disabled = false; });
    });
  }

  fetch('/api/auth/me', {credentials:'include'}).then(function(r){ return r.json(); }).then(function(data){
    var desktop = document.getElementById('accountLink');
    var mobile = document.getElementById('accountLinkMobile');
    if (!data.signedIn) return;
    var href = data.type === 'staff' ? '/admin/' : '/account/';
    var text = data.type === 'staff' ? 'Admin' : 'My account';
    if (desktop) { desktop.href = href; desktop.textContent = text; }
    if (mobile) { mobile.href = href; mobile.textContent = text; }
  }).catch(function(){});
</script>
</body>
</html>
