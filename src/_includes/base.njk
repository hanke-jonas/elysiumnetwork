        <p class="eyebrow text-paper/60 mb-4">Network</p>
        <ul class="space-y-2.5">
          {% for b in site.branches %}
          <li><a href="/{{ b.slug }}/" class="text-paper/65 hover:text-paper transition inline-flex items-center gap-2"><span class="w-2 h-2 rounded-full" style="background:{{ b.accent }}"></span> {{ b.name }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div class="md:col-span-2">
        <p class="eyebrow text-paper/60 mb-4">Explore</p>
        <ul class="space-y-2.5">
          <li><a href="/about/" class="text-paper/65 hover:text-paper transition">About</a></li>
          <li><a href="/calls/" class="text-paper/65 hover:text-paper transition">Active calls</a></li>
          <li><a href="{{ site.hub }}" target="_blank" rel="noopener" class="text-paper/65 hover:text-paper transition inline-flex items-center gap-1.5">Opportunity portal <span class="text-[10px] font-bold uppercase tracking-wide px-1.5 py-0.5 rounded" style="background:var(--blue);color:#191712">beta</span></a></li>
          <li><a href="/support/" class="text-paper/65 hover:text-paper transition">Support Us</a></li>
          <li><a href="{{ site.join_form }}" class="text-paper/65 hover:text-paper transition">Join Us</a></li>
        </ul>
