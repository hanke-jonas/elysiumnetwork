    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-4">
        <a href="/" class="inline-flex items-center gap-2.5">
          <img src="{{ site.logo_small }}" alt="Elysium+" width="128" height="128" class="h-9 w-9 object-contain">
          <span class="font-display text-2xl font-extrabold tracking-tight">Elysium<span style="color:var(--coral)">+</span></span>
        </a>
        <p class="mt-4 max-w-sm text-paper/65 leading-relaxed">{{ site.tagline }}. A European youth network rooted in Ukraine, working across Poland, Italy and Germany.</p>
