<section class="relative bg-paper border-t-2 border-b-2 border-ink overflow-hidden">
  <div class="max-w-[1400px] mx-auto px-5 sm:px-8 py-16 sm:py-24 grid lg:grid-cols-12 gap-10 items-start">
    <div class="lg:col-span-4 order-2 lg:order-1">
      <p class="eyebrow" style="color:var(--coral-ink)">Live &amp; interactive</p>
      <h2 class="h-sec mt-3">One network, <mark class="m-blue">four countries</mark></h2>
      <p class="mt-5 text-muted leading-relaxed">Drag the globe to spin it, scroll to zoom. Click any of the four lit-up countries to spin there and open its page.</p>

      <div class="mt-7 space-y-2.5">
        {% for b in site.branches %}
        <a href="/{{ b.slug }}/" data-branch-link="{{ b.slug }}" class="flex items-center gap-3 rounded-xl border-2 border-ink bg-white px-4 py-3 hover:-translate-y-0.5 transition">
          <span class="text-xl leading-none">{{ b.flag }}</span>
          <span class="flex-1 min-w-0">
            <span class="block font-display font-bold leading-tight text-sm">{{ b.city }}</span>
            <span class="block mono text-[11px] opacity-60 leading-tight mt-0.5">{{ b.country }}</span>
          </span>
          <span class="clock-time-globe mono text-sm font-semibold" data-tz="{{ b.tz }}" style="color:{{ b.accent }}">--:--</span>
        </a>
        {% endfor %}
      </div>
    </div>

    <div class="lg:col-span-8 order-1 lg:order-2">
      <div class="relative rounded-2xl border-2 border-ink overflow-hidden" style="background:var(--paper-2)">
        <div id="globeHost" class="globe-host" style="touch-action:pan-y;cursor:grab;" aria-hidden="true"></div>
        <div id="globeTip" class="pointer-events-none absolute z-20 hidden">
          <div class="rounded-lg bg-ink text-paper shadow-2xl px-3.5 py-2.5 min-w-[150px]">
            <p id="gtip-name" class="font-display font-bold text-sm leading-tight"></p>
            <p id="gtip-hint" class="mono text-[11px] opacity-70 mt-1"></p>
          </div>
        </div>
        <div class="absolute top-4 left-4 eyebrow bg-paper border-2 border-ink px-2.5 py-1 rounded-full">Drag to rotate</div>
        <div id="globeConfirm" class="hidden absolute z-30 left-0 right-0 mx-auto bottom-6 card p-5 w-[min(90%,20rem)] text-center" role="dialog" aria-modal="true" aria-labelledby="gc-name">
          <span id="gc-flag" class="text-3xl leading-none"></span>
          <p id="gc-name" class="font-display text-lg font-bold mt-2"></p>
          <p class="text-sm text-muted mt-1">Open this branch's page?</p>
          <div class="mt-4 flex flex-wrap gap-2 justify-center">
            <button id="gc-open" class="btn btn-accent">Open page {% icon "arrow-ur", "w-4 h-4" %}</button>
            <button id="gc-cancel" class="btn">Stay here</button>
          </div>
        </div>
        <noscript><p class="p-8">Enable JavaScript to explore the interactive globe.</p></noscript>
      </div>
    </div>
  </div>
</section>

<style>
  /* Smaller, more proportionate footprint on phones — the 4:3 desktop ratio
     made the globe dominate the whole screen edge-to-edge on narrow viewports. */
  .globe-host{ width:100%; aspect-ratio:4/3; }
  @media (max-width: 640px){
    .globe-host{ aspect-ratio:1/1; max-height:min(70vw, 320px); }
  }
</style>

<script>
  (function(){ function t(){ document.querySelectorAll('.clock-time-globe').forEach(function(el){ var tz=el.getAttribute('data-tz'); try{ el.textContent=new Intl.DateTimeFormat('en-GB',{timeZone:tz,hour:'2-digit',minute:'2-digit',hour12:false}).format(new Date()); }catch(e){} }); } t(); setInterval(t,1000); })();
</script>

<script type="importmap">
{ "imports": {
  "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
  "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
} }
</script>
<script src="https://cdn.jsdelivr.net/npm/topojson-client@3/dist/topojson-client.min.js"></script>
<script type="module">
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

const BRANCHES = {{ site.branches | dump | safe }}.map(function(b){ return { id: b.iso_n3, name: b.name, city: b.city, slug: b.slug, accent: b.accent, flag: b.flag }; });
const EXCLUDED_IDS = Object.keys({{ site.globe_excluded | dump | safe }});

const host = document.getElementById('globeHost');
// Phones get a deliberately lighter build: no cloud layer, no specular map,
// no canvas-based texture masking (the heaviest/most failure-prone step —
// cross-origin image draw + pixel read + refill). Fewer moving parts, less
// GPU/memory pressure, smaller and simpler on the screen it matters most on.
const IS_MOBILE = window.matchMedia('(max-width: 640px)').matches;

function llToVec3(lon, lat, r) {
  const phi = (90 - lat) * Math.PI / 180;
  const theta = (lon + 180) * Math.PI / 180;
  return new THREE.Vector3(
    -r * Math.sin(phi) * Math.cos(theta),
     r * Math.cos(phi),
     r * Math.sin(phi) * Math.sin(theta)
  );
}

function ringCentroid(ring) {
  let sx = 0, sy = 0;
  for (let i = 0; i < ring.length; i++) { sx += ring[i][0]; sy += ring[i][1]; }
  return [sx / ring.length, sy / ring.length];
}
function featureCentroid(geometry) {
  if (geometry.type === 'Polygon') return ringCentroid(geometry.coordinates[0]);
  if (geometry.type === 'MultiPolygon') {
    let best = geometry.coordinates[0][0];
    for (let i = 1; i < geometry.coordinates.length; i++) {
      if (geometry.coordinates[i][0].length > best.length) best = geometry.coordinates[i][0];
    }
    return ringCentroid(best);
  }
  return [0, 0];
}

function dotTexture(color) {
  const c = document.createElement('canvas'); c.width = c.height = 64;
  const ctx = c.getContext('2d');
  ctx.beginPath(); ctx.arc(32,32,24,0,Math.PI*2);
  ctx.fillStyle = color; ctx.fill();
  ctx.lineWidth = 6; ctx.strokeStyle = '#191712'; ctx.stroke();
  return new THREE.CanvasTexture(c);
}

const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(42, 4/3, 0.1, 100);
camera.position.set(0, 0, 3.1);

// MSAA off deliberately, on every device: confirmed via direct gl.readPixels
// (not just screenshots, which can add their own compression artifacts)
// that this renderer/driver combination resolves multisampling into a
// visible seam across an otherwise perfectly flat run of ocean pixels,
// specifically along the sphere's equatorial ring of triangles. Turning
// antialias off removes that resolve step entirely; devicePixelRatio below
// already supersamples edges close enough that the loss isn't visible.
const renderer = new THREE.WebGLRenderer({ antialias: false, alpha: true });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, IS_MOBILE ? 1 : 2));
host.appendChild(renderer.domElement);


// Per-vertex lon/lat, matching llToVec3's own convention (inverse of it).
function vertexLonLat(x, y, z) {
  const radius = Math.sqrt(x * x + y * y + z * z) || 1;
  const phi = Math.acos(Math.max(-1, Math.min(1, y / radius)));
  const theta = Math.atan2(z, -x);
  const lon = (theta < 0 ? theta + 2 * Math.PI : theta) * 180 / Math.PI - 180;
  const lat = 90 - phi * 180 / Math.PI;
  return [lon, lat];
}

// Colours the sphere's fill with a per-vertex attribute sampled from a 2D
// map canvas, instead of the obvious approach of wrapping the canvas on as
// a texture. A UV-mapped equirectangular texture on a sphere reproducibly
// rendered a faint but distinct band exactly at the equator on this
// hardware/driver combination — confirmed (by process of elimination
// against every other texture/material/lighting/geometry/sampling
// parameter Three.js exposes, including supersampling and explicit
// smoothing of the source data) to be specific to texture sampling itself.
// Fill resolution is tied to sphere segment count rather than texture
// pixels, so it stays intentionally soft — crisp per-country boundaries
// come from the separate vector-line border pass below instead, which
// isn't resolution-limited.
function paintVertexColors(geometry, sourceCanvas) {
  const w = sourceCanvas.width, h = sourceCanvas.height;
  const data = sourceCanvas.getContext('2d').getImageData(0, 0, w, h).data;
  const pos = geometry.attributes.position;
  const colors = geometry.attributes.color || new THREE.BufferAttribute(new Float32Array(pos.count * 3), 3);
  const c = new THREE.Color();
  for (let i = 0; i < pos.count; i++) {
    const [lon, lat] = vertexLonLat(pos.getX(i), pos.getY(i), pos.getZ(i));
    const px = Math.min(w - 1, Math.max(0, Math.floor((lon + 180) / 360 * w)));
    const py = Math.min(h - 1, Math.max(0, Math.floor((90 - lat) / 180 * h)));
    const di = (py * w + px) * 4;
    c.setRGB(data[di] / 255, data[di + 1] / 255, data[di + 2] / 255, THREE.SRGBColorSpace);
    colors.setXYZ(i, c.r, c.g, c.b);
  }
  colors.needsUpdate = true;
  geometry.setAttribute('color', colors);
}

// Everything spinnable lives in one group, so focusing on a marker can rotate
// the whole world (globe + lines + markers) as a single rigid body.
const world = new THREE.Group();
scene.add(world);

const sphereGeo = new THREE.SphereGeometry(1, IS_MOBILE ? 48 : 96, IS_MOBILE ? 48 : 96);
// Solid ocean colour on every vertex until the real map data resolves.
{
  const posCount = sphereGeo.attributes.position.count;
  const initial = new Float32Array(posCount * 3);
  const oceanLinear = new THREE.Color().setRGB(0xAA / 255, 0xDA / 255, 0xFF / 255, THREE.SRGBColorSpace);
  for (let i = 0; i < posCount; i++) oceanLinear.toArray(initial, i * 3);
  sphereGeo.setAttribute('color', new THREE.BufferAttribute(initial, 3));
}
// Lambert (soft per-pixel lighting, no specular). Tried switching this to an
// unlit MeshBasicMaterial for a flatter, more map-like look — that actually
// unmasked a faint version of the same vertex-color artifact that this
// lighting gradient was incidentally hiding, so keeping Lambert here is
// deliberate, not an oversight. vertexColors reads the per-vertex attribute
// above/below instead of a texture map — see paintVertexColors() for why.
const ambientLight = new THREE.AmbientLight(0xffffff, .85);
scene.add(ambientLight);
const sun = new THREE.DirectionalLight(0xffffff, 1.1);
sun.position.set(3, 2, 4);
scene.add(sun);
const globeMat = new THREE.MeshLambertMaterial({ vertexColors: true });
const globe = new THREE.Mesh(sphereGeo, globeMat);
world.add(globe);

// Face Europe on first load instead of whatever longitude happens to sit at
// the sphere's raw lon=0 origin (the Americas, as built) — this is a
// European youth network, so that's what a first-time visitor should see
// before autoRotate carries it onward. Same "rotate world so this point
// faces the camera" math as focusOn() below, just run once at startup.
{
  const initialFacing = llToVec3(15, 50, 1).normalize();
  const cameraDir = camera.position.clone().normalize();
  world.quaternion.setFromUnitVectors(initialFacing, cameraDir);
}

// A flat "roadmap" style (light land, light water, thin borders) — like
// Google Maps' default view, not a satellite photo. Drawn as plain vector
// polygons straight from the same country data used for the outlines below,
// so there's no image to load and no pixel-reading involved anywhere: the
// previous satellite-photo pipeline needed a cross-origin image fetch plus
// a canvas pixel read just to mask two countries out, which was by far the
// heaviest and most failure-prone part of the whole component. This has
// neither, on any device.
const MAP_OCEAN = '#AADAFF', MAP_LAND = '#F2EFE9', MAP_BORDER = '#9CA3AF';

// world-atlas's Russia feature (id 643, fully excluded below) merges in the
// Crimean peninsula as one of its polygons rather than counting it under
// Ukraine (804) — checked directly against the fetched data. Since Crimea's
// polygon is a small, disconnected ring far from mainland Russia, isolating
// it by its own bounding box (rather than a hardcoded array index, which
// could shift if the CDN data changes) lets it be drawn as Ukrainian
// territory instead of silently vanishing into open ocean.
function findCrimeaPolygon(geo) {
  const russia = geo.features.find(function(f) { return String(f.id) === '643'; });
  if (!russia || !russia.geometry) return null;
  const polys = russia.geometry.type === 'MultiPolygon' ? russia.geometry.coordinates : (russia.geometry.type === 'Polygon' ? [russia.geometry.coordinates] : []);
  for (const poly of polys) {
    const ring = poly[0];
    const lons = ring.map(function(p) { return p[0]; }), lats = ring.map(function(p) { return p[1]; });
    const minLon = Math.min.apply(null, lons), maxLon = Math.max.apply(null, lons);
    const minLat = Math.min.apply(null, lats), maxLat = Math.max.apply(null, lats);
    if (minLon > 29 && maxLon < 39 && minLat > 43 && maxLat < 47) return poly;
  }
  return null;
}

function buildRoadmapCanvas(geo, branchIds, crimea) {
  const W = 2048, H = 1024;
  const c = document.createElement('canvas'); c.width = W; c.height = H;
  const ctx = c.getContext('2d');
  ctx.fillStyle = MAP_OCEAN; ctx.fillRect(0, 0, W, H);

  function toPx(lon, lat) { return [(lon + 180) / 360 * W, (90 - lat) / 180 * H]; }
  function addRings(path, polys) {
    polys.forEach(function(poly) {
      poly.forEach(function(ring) {
        ring.forEach(function(pt, i) {
          const [x, y] = toPx(pt[0], pt[1]);
          if (i === 0) path.moveTo(x, y); else path.lineTo(x, y);
        });
        path.closePath();
      });
    });
  }

  // Non-branch land is batched into one path and filled once — one draw call
  // instead of ~170, and no per-country stroke at all (only branch countries
  // get an outline, added below), since this canvas is just a colour lookup
  // now rather than a texture, so a crisp per-country border here wouldn't
  // even be visible at vertex-color resolution.
  const landPath = new Path2D();
  geo.features.forEach(function(f) {
    const id = String(f.id);
    if (EXCLUDED_IDS.indexOf(id) !== -1 || !f.geometry || branchIds[id]) return;
    const polys = f.geometry.type === 'Polygon' ? [f.geometry.coordinates] : (f.geometry.type === 'MultiPolygon' ? f.geometry.coordinates : []);
    addRings(landPath, polys);
  });
  ctx.fillStyle = MAP_LAND;
  ctx.fill(landPath);

  // Branch countries are drawn individually since each needs its own accent
  // fill and outline.
  geo.features.forEach(function(f) {
    const id = String(f.id);
    const branch = branchIds[id];
    if (EXCLUDED_IDS.indexOf(id) !== -1 || !f.geometry || !branch) return;
    const polys = f.geometry.type === 'Polygon' ? [f.geometry.coordinates] : (f.geometry.type === 'MultiPolygon' ? f.geometry.coordinates : []);
    if (id === '804' && crimea) polys.push(crimea);
    const path = new Path2D();
    addRings(path, polys);
    ctx.globalAlpha = 0.4;
    ctx.fillStyle = branch.accent;
    ctx.fill(path);
    ctx.globalAlpha = 1;
    ctx.strokeStyle = MAP_BORDER; ctx.lineWidth = 1.5;
    ctx.stroke(path);
  });

  return c;
}


const controls = new OrbitControls(camera, renderer.domElement);
// OrbitControls' constructor unconditionally sets touch-action:none on the
// canvas itself (a more specific element than #globeHost), which would
// permanently block page scrolling on touch devices. Override it back to
// pan-y here; the pointer handlers below toggle it to 'none' only while a
// drag on the canvas is actually in progress.
renderer.domElement.style.touchAction = 'pan-y';
controls.enablePan = false;
controls.minDistance = 1.7; controls.maxDistance = 4.5;
controls.autoRotate = true; controls.autoRotateSpeed = 0.6;
controls.enableDamping = true; controls.dampingFactor = .08;

function resize() {
  const w = host.clientWidth, h = host.clientHeight;
  if (!w || !h) return;
  camera.aspect = w / h; camera.updateProjectionMatrix();
  renderer.setSize(w, h);
}
new ResizeObserver(resize).observe(host);
resize();

// Scrolling the globe off-screen (there's a lot of page below it) shouldn't
// mean OrbitControls damping math and a full WebGL render keep running every
// frame forever — only tab visibility pauses rAF on its own, not this.
let inView = true;
new IntersectionObserver(function(entries){ inView = entries[0].isIntersecting; }, { threshold: 0 }).observe(host);

(function loop(){
  requestAnimationFrame(loop);
  if (!inView) return;
  controls.update();
  renderer.render(scene, camera);
})();

const markers = [];
let markersReady = false; // true once real positions are set (world-atlas resolved)
const branchIds = {};
BRANCHES.forEach(function(b){
  branchIds[b.id] = b;
  const mat = new THREE.SpriteMaterial({ map: dotTexture(b.accent), depthTest: true });
  const sp = new THREE.Sprite(mat);
  sp.scale.set(0.13, 0.13, 1);
  sp.userData = { kind: 'branch', id: b.id, name: b.name, slug: b.slug, flag: b.flag };
  world.add(sp);
  markers.push(sp);
});

// One fetch now drives everything — the colours, the outlines, and the
// marker positions — since there's no separate image-loading step left to
// decouple from. Much less that can go wrong than the old two-chain setup.
fetch('https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json')
  .then(r => r.json())
  .then(function(worldData){
    const geo = topojson.feature(worldData, worldData.objects.countries);
    const crimea = findCrimeaPolygon(geo);

    paintVertexColors(sphereGeo, buildRoadmapCanvas(geo, branchIds, crimea));

    // Crisp per-country borders, like Google Maps' political layer — drawn
    // as real vector lines rather than baked into the (comparatively low-
    // resolution, vertex-color-limited) fill, so every country reads
    // clearly regardless of fill softness. Batched into a single
    // LineSegments/BufferGeometry (one draw call for ~170 countries)
    // instead of one object per ring.
    const borderPts = [];
    const borderStep = IS_MOBILE ? 2 : 1; // thin out points on phones
    geo.features.forEach(function(f){
      const id = String(f.id);
      if (EXCLUDED_IDS.indexOf(id) !== -1 || !f.geometry) return;
      const polys = f.geometry.type === 'Polygon' ? [f.geometry.coordinates] : (f.geometry.type === 'MultiPolygon' ? f.geometry.coordinates : []);
      if (id === '804' && crimea) polys.push(crimea);
      polys.forEach(function(poly){
        poly.forEach(function(ring){
          for (let k = 0; k < ring.length - borderStep; k += borderStep) {
            borderPts.push(llToVec3(ring[k][0], ring[k][1], 1.006));
            borderPts.push(llToVec3(ring[k + borderStep][0], ring[k + borderStep][1], 1.006));
          }
        });
      });
    });
    const borderMat = new THREE.LineBasicMaterial({ color: 0x6b7280, transparent: true, opacity: 0.55 });
    world.add(new THREE.LineSegments(new THREE.BufferGeometry().setFromPoints(borderPts), borderMat));

    geo.features.forEach(function(f){
      const id = String(f.id);
      if (EXCLUDED_IDS.indexOf(id) !== -1 || !f.geometry) return; // Russia & Belarus: no outline either

      const branch = branchIds[id];
      if (!branch) return;

      const polys = f.geometry.type === 'Polygon' ? [f.geometry.coordinates] : (f.geometry.type === 'MultiPolygon' ? f.geometry.coordinates : []);
      if (id === '804' && crimea) polys.push(crimea);

      // Bold accent outline, drawn twice at slightly different radii for a
      // thicker line than a single 1px WebGL line would give, so home
      // countries pop clearly on the map.
      const outline = new THREE.LineBasicMaterial({ color: new THREE.Color(branch.accent), transparent: true, opacity: 1 });
      [1.015, 1.018].forEach(function(r){
        polys.forEach(function(poly){
          poly.forEach(function(ring){
            const pts = ring.map(function(c){ return llToVec3(c[0], c[1], r); });
            world.add(new THREE.LineLoop(new THREE.BufferGeometry().setFromPoints(pts), outline));
          });
        });
      });

      const centroid = featureCentroid(f.geometry);
      const sp = markers.find(m => m.userData.id === id);
      if (sp) sp.position.copy(llToVec3(centroid[0], centroid[1], 1.05));
    });
    markersReady = true;
  })
  .catch(function(err){
    console.error('Elysium+ globe: failed to load country data — markers stay at their default position and clicking them will not focus correctly.', err);
    host.insertAdjacentHTML('afterend', '<div class="absolute inset-0 grid place-items-center text-center p-6 pointer-events-none z-10"><p class="text-sm text-muted max-w-xs bg-white border-2 border-ink rounded-xl px-4 py-3 shadow-[4px_4px_0_var(--ink)]">Interactive globe unavailable right now — browse branches in the list instead.</p></div>');
  });

const ray = new THREE.Raycaster();
const ptr = new THREE.Vector2();
let downPos = null, downTime = 0, downPointerId = null;
// Tracks concurrent touches so a pinch's first-finger release doesn't reset
// touch-action while the second finger is still down.
let activePointers = 0;

function ndc(ev) {
  const r = renderer.domElement.getBoundingClientRect();
  ptr.x = ((ev.clientX - r.left) / r.width) * 2 - 1;
  ptr.y = -((ev.clientY - r.top) / r.height) * 2 + 1;
}

renderer.domElement.addEventListener('pointerdown', function(e){
  activePointers++;
  downPos = [e.clientX, e.clientY];
  downTime = Date.now();
  downPointerId = e.pointerId;
  renderer.domElement.style.touchAction = 'none';
});
renderer.domElement.addEventListener('pointercancel', function(e){
  activePointers = Math.max(0, activePointers - 1);
  if (e.pointerId === downPointerId) { downPos = null; downTime = 0; downPointerId = null; }
  if (activePointers === 0) renderer.domElement.style.touchAction = 'pan-y';
});

renderer.domElement.addEventListener('pointermove', function(e){
  ndc(e);
  ray.setFromCamera(ptr, camera);
  // Markers all sit at the origin until markersReady — without this guard a
  // hover near the globe's center during that window shows a tooltip for a
  // marker that clicking would silently do nothing for.
  const hit = markersReady ? ray.intersectObjects(markers)[0] : null;
  const tip = document.getElementById('globeTip');
  if (hit) {
    renderer.domElement.style.cursor = 'pointer';
    document.getElementById('gtip-name').textContent = '📍 ' + hit.object.userData.name;
    document.getElementById('gtip-hint').textContent = 'Click to focus';
    tip.classList.remove('hidden');
    tip.style.left = Math.min(e.clientX - host.getBoundingClientRect().left + 14, host.clientWidth - 170) + 'px';
    tip.style.top = Math.max(e.clientY - host.getBoundingClientRect().top - 40, 8) + 'px';
  } else {
    renderer.domElement.style.cursor = 'grab';
    tip.classList.add('hidden');
  }
});

// Spin the whole world so the clicked marker faces the camera, then ask
// before navigating away — rather than redirecting immediately on click.
let spinAnim = null;
function focusOn(marker) {
  controls.autoRotate = false;
  document.getElementById('globeTip').classList.add('hidden');
  document.getElementById('globeConfirm').classList.add('hidden');

  const worldDir = marker.getWorldPosition(new THREE.Vector3()).normalize();
  // The camera keeps drifting due to autoRotate/user drag, so "face the
  // camera" has to be computed from where the camera actually is right now
  // — a fixed axis here was the bug: it only matched right at page load,
  // and drifted further off (looking "random") the longer autoRotate ran
  // before the click.
  const faceCamera = camera.position.clone().normalize();
  const qDelta = new THREE.Quaternion().setFromUnitVectors(worldDir, faceCamera);
  const qFrom = world.quaternion.clone();
  const qTo = qDelta.multiply(qFrom);

  if (spinAnim) cancelAnimationFrame(spinAnim);
  const start = performance.now(), duration = 700;
  function step(now) {
    const t = Math.min(1, (now - start) / duration);
    const eased = 1 - Math.pow(1 - t, 3);
    world.quaternion.slerpQuaternions(qFrom, qTo, eased);
    if (t < 1) { spinAnim = requestAnimationFrame(step); }
    else { spinAnim = null; showConfirm(marker.userData); }
  }
  spinAnim = requestAnimationFrame(step);
}

// Centralised so every dismiss path (Stay here, Escape, outside click) always
// resumes autoRotate — previously only focusOn() ever turned it off, and
// nothing ever turned it back on, permanently freezing the globe after the
// first marker/chip click of a page view.
function dismissConfirm() {
  const panel = document.getElementById('globeConfirm');
  if (panel.classList.contains('hidden')) return;
  panel.classList.add('hidden');
  controls.autoRotate = true;
}

function showConfirm(data) {
  document.getElementById('gc-flag').textContent = data.flag || '';
  document.getElementById('gc-name').textContent = data.name;
  const panel = document.getElementById('globeConfirm');
  panel.classList.remove('hidden');
  const openBtn = document.getElementById('gc-open');
  openBtn.onclick = function(){ window.location.href = '/' + data.slug + '/'; };
  document.getElementById('gc-cancel').onclick = dismissConfirm;
  openBtn.focus({ preventScroll: true });
}

// Let Escape or a click/tap outside the confirm card dismiss it too, instead
// of the "Stay here" button being the only way out.
document.addEventListener('keydown', function(e){
  if (e.key === 'Escape') dismissConfirm();
});
document.addEventListener('pointerdown', function(e){
  const panel = document.getElementById('globeConfirm');
  if (panel.classList.contains('hidden')) return;
  if (!panel.contains(e.target)) dismissConfirm();
});

renderer.domElement.addEventListener('pointerup', function(e){
  activePointers = Math.max(0, activePointers - 1);
  if (activePointers === 0) renderer.domElement.style.touchAction = 'pan-y';
  if (!downPos || e.pointerId !== downPointerId) return;
  const moved = Math.hypot(e.clientX - downPos[0], e.clientY - downPos[1]);
  const quick = Date.now() - downTime < 500;
  downPos = null;
  downPointerId = null;
  if (moved > 6 || !quick) return;
  ndc(e);
  ray.setFromCamera(ptr, camera);
  const hit = ray.intersectObjects(markers)[0];
  // Markers sit at the origin until the country data resolves; clicking
  // that fast (rare, but possible right after the page loads) would spin
  // toward a meaningless zero-length direction instead of doing nothing.
  if (hit && markersReady) focusOn(hit.object);
});

// Sidebar country chips trigger the same spin-then-confirm flow as clicking
// the globe directly, instead of navigating immediately. Real href stays in
// place for keyboard use, middle-click, and no-JS fallback.
document.querySelectorAll('[data-branch-link]').forEach(function(el){
  el.addEventListener('click', function(e){
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
    // A real mouse click always has detail >= 1 (click count); a link
    // "clicked" via Enter/Space from the keyboard fires with detail === 0.
    // Without this, keyboard users could never actually reach a branch page
    // from this sidebar — Enter would silently just spin the globe instead.
    if (e.detail === 0) return;
    if (!markersReady) return; // let the real link navigate instead
    const slug = el.getAttribute('data-branch-link');
    const marker = markers.find(function(m){ return m.userData.slug === slug; });
    if (!marker) return;
    e.preventDefault();
    focusOn(marker);
    host.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
});
</script>
