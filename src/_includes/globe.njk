<section class="relative bg-paper border-t-2 border-b-2 border-ink overflow-hidden">
  <div class="max-w-[1400px] mx-auto px-5 sm:px-8 py-16 sm:py-24 grid lg:grid-cols-12 gap-10 items-start">
    <div class="lg:col-span-4 order-2 lg:order-1">
      <p class="eyebrow" style="color:var(--coral-ink)">Live &amp; interactive</p>
      <h2 class="h-sec mt-3">One network, <mark class="m-blue">four countries</mark></h2>
      <p class="mt-5 text-muted leading-relaxed">Drag the globe to spin it, scroll to zoom. Click any of the four lit-up countries to spin there and open its page — or click Russia, marked in red, to see what its invasion has done to our home region.</p>

      <div class="mt-7 space-y-2.5">
        {% for b in site.branches %}
        <a href="/{{ b.slug }}/" data-branch-link="{{ b.slug }}" class="flex items-center gap-3 rounded-xl border-2 border-ink bg-white px-4 py-3 hover:-translate-y-0.5 transition">
          <span class="text-xl leading-none">{{ b.flag }}</span>
          <span class="flex-1 min-w-0">
            <span class="block font-display font-bold leading-tight text-sm">{{ b.city }}</span>
            <span class="block mono text-[11px] opacity-60 leading-tight mt-0.5">{{ b.country }}</span>
          </span>
          <span class="clock-time-globe mono text-sm font-semibold" data-tz="{{ b.tz }}" style="color:{{ b.accent }}">--:--</span>
        </a>
        {% endfor %}
      </div>
    </div>

    <div class="lg:col-span-8 order-1 lg:order-2">
      <div class="relative rounded-2xl border-2 border-ink overflow-hidden" style="background:var(--ink)">
        <div id="globeHost" class="globe-host" style="touch-action:pan-y;cursor:grab;" aria-hidden="true"></div>
        <div id="globeTip" class="pointer-events-none absolute z-20 hidden">
          <div class="rounded-lg bg-ink text-paper shadow-2xl px-3.5 py-2.5 min-w-[150px]">
            <p id="gtip-name" class="font-display font-bold text-sm leading-tight"></p>
            <p id="gtip-hint" class="mono text-[11px] opacity-70 mt-1"></p>
          </div>
        </div>
        <div class="absolute top-4 left-4 eyebrow bg-paper border-2 border-ink px-2.5 py-1 rounded-full">Drag to rotate</div>
        <div class="absolute top-4 right-4 z-20 flex flex-col items-end gap-2">
          <button type="button" id="globeSpinToggle" class="eyebrow bg-paper border-2 border-ink px-2.5 py-1 rounded-full inline-flex items-center gap-1.5" aria-pressed="false">{% icon "spark", "w-3 h-3" %} Spin globe</button>
          <div id="globeSpeedRow" class="hidden items-center gap-2 bg-paper border-2 border-ink px-3 py-1.5 rounded-full">
            <label for="globeSpeed" class="mono text-[10px] opacity-70 uppercase tracking-wider">Speed</label>
            <input type="range" id="globeSpeed" min="1" max="6" step="0.5" value="2" class="w-16 sm:w-20 accent-ink">
          </div>
        </div>
        <div class="absolute bottom-4 right-4 z-20 flex flex-col gap-1.5">
          <button type="button" id="globeZoomIn" aria-label="Zoom in" class="w-8 h-8 grid place-items-center bg-paper border-2 border-ink rounded-full font-bold leading-none hover:-translate-y-0.5 transition">{% icon "plus", "w-4 h-4" %}</button>
          <button type="button" id="globeZoomOut" aria-label="Zoom out" class="w-8 h-8 grid place-items-center bg-paper border-2 border-ink rounded-full font-bold leading-none hover:-translate-y-0.5 transition">−</button>
        </div>
        <div id="globeConfirm" class="hidden absolute z-30 left-0 right-0 mx-auto bottom-6 card p-5 w-[min(90%,20rem)] text-center" role="dialog" aria-modal="true" aria-labelledby="gc-name">
          <span id="gc-flag" class="text-3xl leading-none"></span>
          <p id="gc-name" class="font-display text-lg font-bold mt-2"></p>
          <p class="text-sm text-muted mt-1">Open this page?</p>
          <div class="mt-4 flex flex-wrap gap-2 justify-center">
            <button id="gc-open" class="btn btn-accent">Open page {% icon "arrow-ur", "w-4 h-4" %}</button>
            <button id="gc-cancel" class="btn">Stay here</button>
          </div>
        </div>
        <noscript><p class="p-8">Enable JavaScript to explore the interactive globe.</p></noscript>
      </div>
    </div>
  </div>
</section>

<style>
  /* Smaller, more proportionate footprint on phones — the 4:3 desktop ratio
     made the globe dominate the whole screen edge-to-edge on narrow viewports. */
  .globe-host{ width:100%; aspect-ratio:4/3; }
  @media (max-width: 640px){
    .globe-host{ aspect-ratio:1/1; max-height:min(70vw, 320px); }
  }
</style>

<script>
  (function(){ function t(){ document.querySelectorAll('.clock-time-globe').forEach(function(el){ var tz=el.getAttribute('data-tz'); try{ el.textContent=new Intl.DateTimeFormat('en-GB',{timeZone:tz,hour:'2-digit',minute:'2-digit',hour12:false}).format(new Date()); }catch(e){} }); } t(); setInterval(t,1000); })();
</script>

<script type="importmap">
{ "imports": {
  "three": "https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js",
  "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.160.0/examples/jsm/"
} }
</script>
<script src="https://cdn.jsdelivr.net/npm/topojson-client@3/dist/topojson-client.min.js"></script>
<script type="module">
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

const BRANCHES = {{ site.branches | dump | safe }}.map(function(b){ return { id: b.iso_n3, name: b.name, city: b.city, slug: b.slug, accent: b.accent, flag: b.flag }; });
const EXCLUDED_IDS = Object.keys({{ site.globe_excluded | dump | safe }});

const host = document.getElementById('globeHost');
// Phones get a deliberately lighter build: no cloud layer, no specular map,
// no canvas-based texture masking (the heaviest/most failure-prone step —
// cross-origin image draw + pixel read + refill). Fewer moving parts, less
// GPU/memory pressure, smaller and simpler on the screen it matters most on.
const IS_MOBILE = window.matchMedia('(max-width: 640px)').matches;

function llToVec3(lon, lat, r) {
  const phi = (90 - lat) * Math.PI / 180;
  const theta = (lon + 180) * Math.PI / 180;
  return new THREE.Vector3(
    -r * Math.sin(phi) * Math.cos(theta),
     r * Math.cos(phi),
     r * Math.sin(phi) * Math.sin(theta)
  );
}

function ringCentroid(ring) {
  let sx = 0, sy = 0;
  for (let i = 0; i < ring.length; i++) { sx += ring[i][0]; sy += ring[i][1]; }
  return [sx / ring.length, sy / ring.length];
}
function featureCentroid(geometry) {
  if (geometry.type === 'Polygon') return ringCentroid(geometry.coordinates[0]);
  if (geometry.type === 'MultiPolygon') {
    let best = geometry.coordinates[0][0];
    for (let i = 1; i < geometry.coordinates.length; i++) {
      if (geometry.coordinates[i][0].length > best.length) best = geometry.coordinates[i][0];
    }
    return ringCentroid(best);
  }
  return [0, 0];
}

function dotTexture(color) {
  const c = document.createElement('canvas'); c.width = c.height = 64;
  const ctx = c.getContext('2d');
  ctx.beginPath(); ctx.arc(32,32,24,0,Math.PI*2);
  ctx.fillStyle = color; ctx.fill();
  ctx.lineWidth = 6; ctx.strokeStyle = '#191712'; ctx.stroke();
  return new THREE.CanvasTexture(c);
}

// A warning-triangle marker (not a plain coloured dot like the branch
// countries) — this is the one country on the globe with an actual
// designation attached to it, and the marker should read as a hazard
// symbol at a glance, not just another "pick me" dot.
function warningTexture(color) {
  const c = document.createElement('canvas'); c.width = c.height = 64;
  const ctx = c.getContext('2d');
  ctx.beginPath();
  ctx.moveTo(32, 4);
  ctx.lineTo(60, 56);
  ctx.lineTo(4, 56);
  ctx.closePath();
  ctx.fillStyle = color; ctx.fill();
  ctx.lineWidth = 5; ctx.strokeStyle = '#191712'; ctx.lineJoin = 'round'; ctx.stroke();
  ctx.fillStyle = '#191712';
  ctx.fillRect(28.5, 22, 7, 18);
  ctx.beginPath(); ctx.arc(32, 47, 4, 0, Math.PI*2); ctx.fill();
  return new THREE.CanvasTexture(c);
}

const scene = new THREE.Scene();
const camera = new THREE.PerspectiveCamera(42, 4/3, 0.1, 100);
camera.position.set(0, 0, 3.1);

// MSAA off deliberately, on every device: confirmed via direct gl.readPixels
// (not just screenshots, which can add their own compression artifacts)
// that this renderer/driver combination resolves multisampling into a
// visible seam across an otherwise perfectly flat run of ocean pixels,
// specifically along the sphere's equatorial ring of triangles. Turning
// antialias off removes that resolve step entirely; devicePixelRatio below
// already supersamples edges close enough that the loss isn't visible.
const renderer = new THREE.WebGLRenderer({ antialias: false, alpha: true });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, IS_MOBILE ? 1 : 2));
host.appendChild(renderer.domElement);


// A previous version of this file painted per-vertex colours from a 2D map
// canvas instead of wrapping it on as a texture, because a UV-mapped
// equirectangular texture reproducibly rendered a faint band at the equator
// on the hardware/driver combination tested at the time (with antialiasing
// still on). This version wraps real photographic Earth textures again,
// deliberately, with the two changes that differ from that earlier attempt:
// antialiasing is off at the renderer level (below — it independently fixed
// a related seam on the flat-colour version) and every texture is set to
// ClampToEdgeWrapping so nothing samples across the antimeridian wrap. If
// the equator artifact reappears despite that, the fix is to revert this
// block to vertex-colour painting (see git history) — not to keep tuning
// texture parameters indefinitely.
const textureLoader = new THREE.TextureLoader();
textureLoader.crossOrigin = 'anonymous';
const TEX_BASE = 'https://cdn.jsdelivr.net/gh/mrdoob/three.js@r160/examples/textures/planets/';
function loadEarthTexture(file, isColor) {
  const tex = textureLoader.load(TEX_BASE + file);
  tex.wrapS = THREE.ClampToEdgeWrapping;
  tex.wrapT = THREE.ClampToEdgeWrapping;
  if (isColor) tex.colorSpace = THREE.SRGBColorSpace;
  return tex;
}

// Everything spinnable lives in one group, so focusing on a marker can rotate
// the whole world (globe + lines + markers) as a single rigid body.
const world = new THREE.Group();
scene.add(world);

const sphereGeo = new THREE.SphereGeometry(1, IS_MOBILE ? 48 : 96, IS_MOBILE ? 48 : 96);
const ambientLight = new THREE.AmbientLight(0xffffff, .85);
scene.add(ambientLight);
const sun = new THREE.DirectionalLight(0xffffff, 1.1);
sun.position.set(3, 2, 4);
scene.add(sun);
// Phong (not Lambert) specifically because it's the material that supports
// specularMap — without it oceans and land would reflect light identically,
// which is most of what makes a lit photo-textured sphere look flat/plastic
// instead of like water.
const globeMat = new THREE.MeshPhongMaterial({
  map: loadEarthTexture('earth_atmos_2048.jpg', true),
  specularMap: loadEarthTexture('earth_specular_2048.jpg', false),
  normalMap: loadEarthTexture('earth_normal_2048.jpg', false),
  normalScale: new THREE.Vector2(0.6, 0.6),
  specular: new THREE.Color(0x333333),
  shininess: 12,
});
const globe = new THREE.Mesh(sphereGeo, globeMat);
world.add(globe);

// Translucent cloud shell, independently and slowly rotated in the render
// loop below — the one thing that reads as "alive" on an otherwise static
// photo texture.
const cloudsMat = new THREE.MeshLambertMaterial({
  map: loadEarthTexture('earth_clouds_1024.png', false),
  transparent: true,
  opacity: 0.5,
  depthWrite: false,
});
const clouds = new THREE.Mesh(new THREE.SphereGeometry(1.01, IS_MOBILE ? 32 : 64, IS_MOBILE ? 32 : 64), cloudsMat);
world.add(clouds);

// Branch countries no longer get their accent fill baked into the globe's
// own colour (that colour now comes from the photo texture, not a canvas).
// Instead a second, very slightly larger transparent sphere carries just
// the four accent-tinted country shapes, sitting visually on top of the
// real texture — filled in once the country data resolves, below.
const highlightMat = new THREE.MeshBasicMaterial({ transparent: true, depthWrite: false });
const highlightMesh = new THREE.Mesh(new THREE.SphereGeometry(1.002, IS_MOBILE ? 48 : 96, IS_MOBILE ? 48 : 96), highlightMat);
world.add(highlightMesh);

// Star field + atmosphere glow — the two things that make a globe read as
// "floating in space" like reference sites (e.g. earth3dmap.com), without
// touching an image texture at all. Those references get their look from a
// photographic equirectangular texture, which is exactly the approach
// already tried and ruled out above (paintVertexColors' comment) after
// exhaustive elimination testing against a confirmed equator-seam artifact
// on this renderer. Stars are plain points, the glow is a procedural
// Fresnel shader — neither samples a UV-mapped texture, so neither can
// reproduce that bug.
{
  const starCount = IS_MOBILE ? 600 : 1600;
  const starPos = new Float32Array(starCount * 3);
  for (let i = 0; i < starCount; i++) {
    // Rejection-sample points outside the globe's own radius so none of
    // them render inside/behind it, on a shell far enough out (4–9) to sit
    // clearly behind the globe at every allowed camera zoom (max 4.5).
    let x, y, z, d;
    do {
      x = (Math.random() * 2 - 1); y = (Math.random() * 2 - 1); z = (Math.random() * 2 - 1);
      d = Math.sqrt(x * x + y * y + z * z);
    } while (d === 0 || d > 1);
    const r = 4 + Math.random() * 5;
    starPos[i * 3] = (x / d) * r;
    starPos[i * 3 + 1] = (y / d) * r;
    starPos[i * 3 + 2] = (z / d) * r;
  }
  const starGeo = new THREE.BufferGeometry();
  starGeo.setAttribute('position', new THREE.BufferAttribute(starPos, 3));
  const starMat = new THREE.PointsMaterial({ color: 0xffffff, size: 0.02, sizeAttenuation: true, transparent: true, opacity: 0.8 });
  scene.add(new THREE.Points(starGeo, starMat));

  const glowGeo = new THREE.SphereGeometry(1.12, IS_MOBILE ? 32 : 48, IS_MOBILE ? 32 : 48);
  const glowMat = new THREE.ShaderMaterial({
    uniforms: { glowColor: { value: new THREE.Color(0x7C93D6) } },
    vertexShader: `
      varying vec3 vNormal;
      void main() {
        vNormal = normalize(normalMatrix * normal);
        gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
      }
    `,
    fragmentShader: `
      varying vec3 vNormal;
      uniform vec3 glowColor;
      void main() {
        float intensity = pow(0.68 - dot(vNormal, vec3(0.0, 0.0, 1.0)), 3.0);
        gl_FragColor = vec4(glowColor, intensity);
      }
    `,
    side: THREE.BackSide,
    blending: THREE.AdditiveBlending,
    transparent: true,
    depthWrite: false,
  });
  scene.add(new THREE.Mesh(glowGeo, glowMat));
}

// Face Europe on first load instead of whatever longitude happens to sit at
// the sphere's raw lon=0 origin (the Americas, as built) — this is a
// European youth network, so that's what a first-time visitor should see.
// Same "rotate world so this point faces the camera" math as focusOn()
// below, but that alone only constrains ONE point (Europe) to face the
// camera — it leaves the sphere free to spin around that point-to-camera
// axis at an arbitrary angle, which in practice left the globe's own north
// pole tilted well off to one side rather than pointing up on screen (most
// noticeable now that the globe sits static by default instead of auto-
// rotating). A second correction rotation, around the camera-facing axis
// only, brings the pole back to vertical without disturbing which point
// faces the camera.
{
  const cameraDir = camera.position.clone().normalize();
  const initialFacing = llToVec3(15, 50, 1).normalize();
  const q1 = new THREE.Quaternion().setFromUnitVectors(initialFacing, cameraDir);

  const poleAfterQ1 = new THREE.Vector3(0, 1, 0).applyQuaternion(q1);
  const poleOnScreen = poleAfterQ1.clone().sub(cameraDir.clone().multiplyScalar(poleAfterQ1.dot(cameraDir)));
  const desiredUp = camera.up.clone();
  const desiredUpOnScreen = desiredUp.clone().sub(cameraDir.clone().multiplyScalar(desiredUp.dot(cameraDir)));
  const q2 = new THREE.Quaternion().setFromUnitVectors(poleOnScreen.normalize(), desiredUpOnScreen.normalize());

  world.quaternion.copy(q2.multiply(q1));
}

const MAP_BORDER = '#B7AA8C';
// Russia is excluded from the generic "every other country" border pass
// (see EXCLUDED_IDS/globe_excluded in site.js) but gets its own explicit
// treatment below instead of no treatment at all — a red fill, a red
// outline, and a marker of its own that behaves exactly like a branch
// marker (hover tooltip, click-to-focus, then a confirm dialog) but leads
// to /against-the-war/ instead of a branch page.
const RUSSIA_ID = '643';
const WARN_RED = '#C0392B';

// world-atlas's Russia feature (id 643, fully excluded below) merges in the
// Crimean peninsula as one of its polygons rather than counting it under
// Ukraine (804) — checked directly against the fetched data. Since Crimea's
// polygon is a small, disconnected ring far from mainland Russia, isolating
// it by its own bounding box (rather than a hardcoded array index, which
// could shift if the CDN data changes) lets it be drawn as Ukrainian
// territory instead of silently vanishing into open ocean.
function findCrimeaPolygon(geo) {
  const russia = geo.features.find(function(f) { return String(f.id) === '643'; });
  if (!russia || !russia.geometry) return null;
  const polys = russia.geometry.type === 'MultiPolygon' ? russia.geometry.coordinates : (russia.geometry.type === 'Polygon' ? [russia.geometry.coordinates] : []);
  for (const poly of polys) {
    const ring = poly[0];
    const lons = ring.map(function(p) { return p[0]; }), lats = ring.map(function(p) { return p[1]; });
    const minLon = Math.min.apply(null, lons), maxLon = Math.max.apply(null, lons);
    const minLat = Math.min.apply(null, lats), maxLat = Math.max.apply(null, lats);
    if (minLon > 29 && maxLon < 39 && minLat > 43 && maxLat < 47) return poly;
  }
  return null;
}

// Just the four branch countries, accent-tinted, on an otherwise fully
// transparent canvas — everywhere else the real photo texture underneath
// shows through untouched. Applied as the map on highlightMesh above.
function buildBranchHighlightCanvas(geo, branchIds, crimea) {
  const W = 2048, H = 1024;
  const c = document.createElement('canvas'); c.width = W; c.height = H;
  const ctx = c.getContext('2d');

  function toPx(lon, lat) { return [(lon + 180) / 360 * W, (90 - lat) / 180 * H]; }
  // Russia's ring(s) cross the antimeridian (Chukotka sits past lon 180),
  // where consecutive ring points jump from lon≈180 to lon≈-180 — a small
  // step in reality, but on this flat equirectangular canvas that's a jump
  // from x≈W to x≈0. A plain lineTo between them draws a long spurious
  // line straight across the whole canvas, and filling that path colours
  // most of the map, not just Russia. Starting a new subpath instead of
  // lineTo whenever a ring's longitude jumps by more than 180° in one step
  // splits the ring at the seam into separate closed pieces, each tracing
  // only real coastline points.
  function addRings(path, polys) {
    polys.forEach(function(poly) {
      poly.forEach(function(ring) {
        let prevLon = null;
        ring.forEach(function(pt, i) {
          const [x, y] = toPx(pt[0], pt[1]);
          const crossesSeam = prevLon !== null && Math.abs(pt[0] - prevLon) > 180;
          if (i === 0 || crossesSeam) path.moveTo(x, y); else path.lineTo(x, y);
          prevLon = pt[0];
        });
        path.closePath();
      });
    });
  }

  geo.features.forEach(function(f) {
    const id = String(f.id);
    const branch = branchIds[id];
    if (EXCLUDED_IDS.indexOf(id) !== -1 || !f.geometry || !branch) return;
    const polys = f.geometry.type === 'Polygon' ? [f.geometry.coordinates] : (f.geometry.type === 'MultiPolygon' ? f.geometry.coordinates : []);
    if (id === '804' && crimea) polys.push(crimea);
    const path = new Path2D();
    addRings(path, polys);
    ctx.globalAlpha = 0.45;
    ctx.fillStyle = branch.accent;
    ctx.fill(path);
    ctx.globalAlpha = 1;
  });

  const russia = geo.features.find(function(f) { return String(f.id) === RUSSIA_ID; });
  if (russia && russia.geometry) {
    // Crimea is Ukrainian territory under illegal Russian occupation, not
    // Russian territory — world-atlas's own data merges it into Russia's
    // polygon set (see findCrimeaPolygon above), so it has to be explicitly
    // filtered back out here or it silently renders as part of Russia's red
    // fill, exactly what this page argues against.
    const polys = (russia.geometry.type === 'Polygon' ? [russia.geometry.coordinates] : (russia.geometry.type === 'MultiPolygon' ? russia.geometry.coordinates : []))
      .filter(function(poly) { return poly !== crimea; });
    const path = new Path2D();
    addRings(path, polys);
    ctx.globalAlpha = 0.4;
    ctx.fillStyle = WARN_RED;
    ctx.fill(path);
    ctx.globalAlpha = 1;
  }

  return c;
}


const controls = new OrbitControls(camera, renderer.domElement);
// OrbitControls' constructor unconditionally sets touch-action:none on the
// canvas itself (a more specific element than #globeHost), which would
// permanently block page scrolling on touch devices. Override it back to
// pan-y here; the pointer handlers below toggle it to 'none' only while a
// drag on the canvas is actually in progress.
renderer.domElement.style.touchAction = 'pan-y';
controls.enablePan = false;
// 1.7 kept visitors further out than the sphere's own detail could reward —
// nothing gets sharper up close since this is one fixed-resolution texture,
// not tiled map data, but a closer minimum still lets a country fill the
// frame for a better look at its coastline/border shape.
controls.minDistance = 1.15; controls.maxDistance = 4.5;
// Off by default and centred on Europe until a visitor explicitly asks for
// motion — a globe that keeps drifting away from the region this network is
// actually about was more confusing than helpful. #globeSpinToggle below is
// the only thing that turns this on; dismissConfirm() restores whatever the
// visitor last chose rather than forcing it back on.
let rotationEnabled = false;
controls.autoRotate = rotationEnabled; controls.autoRotateSpeed = 2;
const spinToggle = document.getElementById('globeSpinToggle');
const speedRow = document.getElementById('globeSpeedRow');
const speedSlider = document.getElementById('globeSpeed');
function setRotation(on) {
  rotationEnabled = on;
  controls.autoRotate = on;
  spinToggle.setAttribute('aria-pressed', String(on));
  spinToggle.textContent = on ? '⏸ Stop spinning' : '▶ Spin globe';
  speedRow.classList.toggle('hidden', !on);
  speedRow.classList.toggle('flex', on);
}
spinToggle.addEventListener('click', function(){ setRotation(!rotationEnabled); });
// Easter egg: spin it up fast enough (5 clicks inside 2.5s) and the globe
// says so — kept on the network's own toggle rather than anywhere near
// Russia's marker, since a serious documentation feature isn't the place
// for a wink. Same shared toast/heart-burst globals as the hero-heart egg
// in index.njk; guarded at click-time since base.njk's script defining them
// runs after this page's own inline scripts, not before (see that file's
// comment for why setup-time checks fail here).
let spinClicks = 0, spinClicksAt = 0;
spinToggle.addEventListener('click', function(){
  const now = Date.now();
  spinClicks = (now - spinClicksAt < 2500) ? spinClicks + 1 : 1;
  spinClicksAt = now;
  if (spinClicks === 5 && window.elysiumShowEggToast) {
    window.elysiumShowEggToast('🌍 Round and round — four countries, one network.');
    if (window.elysiumSpawnHeart && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const r = host.getBoundingClientRect();
      for (let i = 0; i < 6; i++) {
        setTimeout(function(){ window.elysiumSpawnHeart(r.left + r.width/2, r.top + r.height/2); }, i * 90);
      }
    }
    spinClicks = 0;
  }
});
speedSlider.addEventListener('input', function(){ controls.autoRotateSpeed = parseFloat(speedSlider.value); });

const zoomInBtn = document.getElementById('globeZoomIn');
const zoomOutBtn = document.getElementById('globeZoomOut');
function zoomBy(factor) {
  const dir = camera.position.clone().sub(controls.target);
  const dist = Math.min(controls.maxDistance, Math.max(controls.minDistance, dir.length() * factor));
  camera.position.copy(controls.target).add(dir.normalize().multiplyScalar(dist));
  controls.update();
}
zoomInBtn.addEventListener('click', function(){ zoomBy(0.8); });
zoomOutBtn.addEventListener('click', function(){ zoomBy(1.25); });

controls.enableDamping = true; controls.dampingFactor = .08;

function resize() {
  const w = host.clientWidth, h = host.clientHeight;
  if (!w || !h) return;
  camera.aspect = w / h; camera.updateProjectionMatrix();
  renderer.setSize(w, h);
}
new ResizeObserver(resize).observe(host);
resize();

// Scrolling the globe off-screen (there's a lot of page below it) shouldn't
// mean OrbitControls damping math and a full WebGL render keep running every
// frame forever — only tab visibility pauses rAF on its own, not this.
let inView = true;
new IntersectionObserver(function(entries){ inView = entries[0].isIntersecting; }, { threshold: 0 }).observe(host);
let warnOutline = null; // Russia's outline material, pulsed below once set

(function loop(){
  requestAnimationFrame(loop);
  if (!inView) return;
  controls.update();
  clouds.rotation.y += 0.0006;
  if (warnOutline) {
    // A slow alarm-style pulse (opacity breathing between ~0.45 and 1) —
    // reads as "this one needs attention" without the flashing being fast
    // enough to feel gimmicky or, worse, seizure-inducing.
    warnOutline.opacity = 0.725 + 0.275 * Math.sin(performance.now() / 650);
  }
  renderer.render(scene, camera);
})();

const markers = [];
let markersReady = false; // true once real positions are set (world-atlas resolved)
const branchIds = {};
BRANCHES.forEach(function(b){
  branchIds[b.id] = b;
  const mat = new THREE.SpriteMaterial({ map: dotTexture(b.accent), depthTest: true });
  const sp = new THREE.Sprite(mat);
  sp.scale.set(0.09, 0.09, 1);
  sp.userData = { kind: 'branch', id: b.id, name: b.name, slug: b.slug, flag: b.flag };
  world.add(sp);
  markers.push(sp);
});

// No visible marker icon on Russia — the red fill and outline already say
// "this one's different" clearly on their own, and the sidebar copy already
// tells visitors to "click Russia, marked in red," not "click the icon."
// Still needs *something* there for hover/click to hit, so this is a fully
// transparent sprite at the same centroid: opacity 0 keeps it invisible to
// the eye while remaining exactly as clickable as a visible marker would be
// (Three.js raycasting hit-tests a sprite's geometry, not its rendered
// opacity), sized larger than the old icon to make up for having no visual
// target to aim at.
{
  const warnMat = new THREE.SpriteMaterial({ map: dotTexture(WARN_RED), transparent: true, opacity: 0, depthTest: true });
  const warnSp = new THREE.Sprite(warnMat);
  warnSp.scale.set(0.22, 0.22, 1);
  warnSp.userData = { kind: 'warning', id: RUSSIA_ID, name: 'Russia — state sponsor of terrorism', slug: 'against-the-war', flag: '⚠️' };
  world.add(warnSp);
  markers.push(warnSp);
}

// One fetch now drives everything — the colours, the outlines, and the
// marker positions — since there's no separate image-loading step left to
// decouple from. Much less that can go wrong than the old two-chain setup.
// 50m has noticeably finer coastlines/borders than 110m (same open Natural
// Earth data, just a more detailed cut of it) — kept to desktop only since
// it's ~7x heavier to fetch and parse, in line with phones already getting
// the deliberately lighter build elsewhere in this file.
fetch(IS_MOBILE
  ? 'https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json'
  : 'https://cdn.jsdelivr.net/npm/world-atlas@2/countries-50m.json')
  .then(r => r.json())
  .then(function(worldData){
    const geo = topojson.feature(worldData, worldData.objects.countries);
    const crimea = findCrimeaPolygon(geo);

    const highlightTex = new THREE.CanvasTexture(buildBranchHighlightCanvas(geo, branchIds, crimea));
    highlightTex.colorSpace = THREE.SRGBColorSpace;
    highlightMat.map = highlightTex;
    highlightMat.needsUpdate = true;

    // A thin border line on every one of ~170 countries was designed for
    // the old flat vertex-colour "roadmap" style — layered on top of a real
    // photo texture it reads as visual clutter instead of a clean globe, so
    // it's gone. Only the countries actually meant to draw the eye (the
    // four branches, Russia) get an outline now, below.

    // Russia gets its own explicit red outline and marker (Belarus stays
    // excluded with no special treatment — only Russia was asked for here).
    {
      const russia = geo.features.find(function(f){ return String(f.id) === RUSSIA_ID; });
      if (russia && russia.geometry) {
        // Same Crimea exclusion as the fill above — it's Ukrainian
        // territory under occupation, not Russia's, so it gets no red
        // outline and doesn't pull Russia's marker toward it.
        const polys = (russia.geometry.type === 'Polygon' ? [russia.geometry.coordinates] : (russia.geometry.type === 'MultiPolygon' ? russia.geometry.coordinates : []))
          .filter(function(poly) { return poly !== crimea; });
        warnOutline = new THREE.LineBasicMaterial({ color: new THREE.Color(WARN_RED), transparent: true, opacity: 1 });
        [1.015, 1.018].forEach(function(r){
          polys.forEach(function(poly){
            poly.forEach(function(ring){
              const pts = ring.map(function(c){ return llToVec3(c[0], c[1], r); });
              world.add(new THREE.LineLoop(new THREE.BufferGeometry().setFromPoints(pts), warnOutline));
            });
          });
        });
        const centroid = featureCentroid({ type: 'MultiPolygon', coordinates: polys });
        const rsp = markers.find(m => m.userData.id === RUSSIA_ID);
        if (rsp) rsp.position.copy(llToVec3(centroid[0], centroid[1], 1.05));
      }
    }

    geo.features.forEach(function(f){
      const id = String(f.id);
      if (EXCLUDED_IDS.indexOf(id) !== -1 || !f.geometry) return; // Russia & Belarus: no outline either

      const branch = branchIds[id];
      if (!branch) return;

      const polys = f.geometry.type === 'Polygon' ? [f.geometry.coordinates] : (f.geometry.type === 'MultiPolygon' ? f.geometry.coordinates : []);
      if (id === '804' && crimea) polys.push(crimea);

      // Bold accent outline, drawn twice at slightly different radii for a
      // thicker line than a single 1px WebGL line would give, so home
      // countries pop clearly on the map.
      const outline = new THREE.LineBasicMaterial({ color: new THREE.Color(branch.accent), transparent: true, opacity: 1 });
      [1.015, 1.018].forEach(function(r){
        polys.forEach(function(poly){
          poly.forEach(function(ring){
            const pts = ring.map(function(c){ return llToVec3(c[0], c[1], r); });
            world.add(new THREE.LineLoop(new THREE.BufferGeometry().setFromPoints(pts), outline));
          });
        });
      });

      const centroid = featureCentroid(f.geometry);
      const sp = markers.find(m => m.userData.id === id);
      if (sp) sp.position.copy(llToVec3(centroid[0], centroid[1], 1.05));
    });
    markersReady = true;
  })
  .catch(function(err){
    console.error('Elysium+ globe: failed to load country data — markers stay at their default position and clicking them will not focus correctly.', err);
    host.insertAdjacentHTML('afterend', '<div class="absolute inset-0 grid place-items-center text-center p-6 pointer-events-none z-10"><p class="text-sm text-muted max-w-xs bg-white border-2 border-ink rounded-xl px-4 py-3 shadow-[4px_4px_0_var(--ink)]">Interactive globe unavailable right now — browse branches in the list instead.</p></div>');
  });

const ray = new THREE.Raycaster();
const ptr = new THREE.Vector2();
let downPos = null, downTime = 0, downPointerId = null;
// Tracks concurrent touches so a pinch's first-finger release doesn't reset
// touch-action while the second finger is still down.
let activePointers = 0;

function ndc(ev) {
  const r = renderer.domElement.getBoundingClientRect();
  ptr.x = ((ev.clientX - r.left) / r.width) * 2 - 1;
  ptr.y = -((ev.clientY - r.top) / r.height) * 2 + 1;
}

renderer.domElement.addEventListener('pointerdown', function(e){
  activePointers++;
  downPos = [e.clientX, e.clientY];
  downTime = Date.now();
  downPointerId = e.pointerId;
  renderer.domElement.style.touchAction = 'none';
});
renderer.domElement.addEventListener('pointercancel', function(e){
  activePointers = Math.max(0, activePointers - 1);
  if (e.pointerId === downPointerId) { downPos = null; downTime = 0; downPointerId = null; }
  if (activePointers === 0) renderer.domElement.style.touchAction = 'pan-y';
});

renderer.domElement.addEventListener('pointermove', function(e){
  ndc(e);
  ray.setFromCamera(ptr, camera);
  // Markers all sit at the origin until markersReady — without this guard a
  // hover near the globe's center during that window shows a tooltip for a
  // marker that clicking would silently do nothing for.
  const hit = markersReady ? ray.intersectObjects(markers)[0] : null;
  const tip = document.getElementById('globeTip');
  if (hit) {
    renderer.domElement.style.cursor = 'pointer';
    document.getElementById('gtip-name').textContent = (hit.object.userData.flag || '📍') + ' ' + hit.object.userData.name;
    document.getElementById('gtip-hint').textContent = 'Click to focus';
    tip.classList.remove('hidden');
    tip.style.left = Math.min(e.clientX - host.getBoundingClientRect().left + 14, host.clientWidth - 170) + 'px';
    tip.style.top = Math.max(e.clientY - host.getBoundingClientRect().top - 40, 8) + 'px';
  } else {
    renderer.domElement.style.cursor = 'grab';
    tip.classList.add('hidden');
  }
});

// Spin the whole world so the clicked marker faces the camera, then ask
// before navigating away — rather than redirecting immediately on click.
let spinAnim = null;
function focusOn(marker) {
  controls.autoRotate = false;
  document.getElementById('globeTip').classList.add('hidden');
  document.getElementById('globeConfirm').classList.add('hidden');

  const worldDir = marker.getWorldPosition(new THREE.Vector3()).normalize();
  // The camera keeps drifting due to autoRotate/user drag, so "face the
  // camera" has to be computed from where the camera actually is right now
  // — a fixed axis here was the bug: it only matched right at page load,
  // and drifted further off (looking "random") the longer autoRotate ran
  // before the click.
  const faceCamera = camera.position.clone().normalize();
  const qDelta = new THREE.Quaternion().setFromUnitVectors(worldDir, faceCamera);
  const qFrom = world.quaternion.clone();
  const qTo = qDelta.multiply(qFrom);

  if (spinAnim) cancelAnimationFrame(spinAnim);
  const start = performance.now(), duration = 700;
  function step(now) {
    const t = Math.min(1, (now - start) / duration);
    const eased = 1 - Math.pow(1 - t, 3);
    world.quaternion.slerpQuaternions(qFrom, qTo, eased);
    if (t < 1) { spinAnim = requestAnimationFrame(step); }
    else { spinAnim = null; showConfirm(marker.userData); }
  }
  spinAnim = requestAnimationFrame(step);
}

// Centralised so every dismiss path (Stay here, Escape, outside click)
// always restores rotation to whatever the visitor last chose via
// #globeSpinToggle — not force it back on regardless of that choice.
function dismissConfirm() {
  const panel = document.getElementById('globeConfirm');
  if (panel.classList.contains('hidden')) return;
  panel.classList.add('hidden');
  controls.autoRotate = rotationEnabled;
}

function showConfirm(data) {
  document.getElementById('gc-flag').textContent = data.flag || '';
  document.getElementById('gc-name').textContent = data.name;
  const panel = document.getElementById('globeConfirm');
  panel.classList.remove('hidden');
  const openBtn = document.getElementById('gc-open');
  openBtn.onclick = function(){ window.location.href = '/' + data.slug + '/'; };
  document.getElementById('gc-cancel').onclick = dismissConfirm;
  openBtn.focus({ preventScroll: true });
}

// Let Escape or a click/tap outside the confirm card dismiss it too, instead
// of the "Stay here" button being the only way out.
document.addEventListener('keydown', function(e){
  if (e.key === 'Escape') dismissConfirm();
});
document.addEventListener('pointerdown', function(e){
  const panel = document.getElementById('globeConfirm');
  if (panel.classList.contains('hidden')) return;
  if (!panel.contains(e.target)) dismissConfirm();
});

renderer.domElement.addEventListener('pointerup', function(e){
  activePointers = Math.max(0, activePointers - 1);
  if (activePointers === 0) renderer.domElement.style.touchAction = 'pan-y';
  if (!downPos || e.pointerId !== downPointerId) return;
  const moved = Math.hypot(e.clientX - downPos[0], e.clientY - downPos[1]);
  const quick = Date.now() - downTime < 500;
  downPos = null;
  downPointerId = null;
  if (moved > 6 || !quick) return;
  ndc(e);
  ray.setFromCamera(ptr, camera);
  const hit = ray.intersectObjects(markers)[0];
  // Markers sit at the origin until the country data resolves; clicking
  // that fast (rare, but possible right after the page loads) would spin
  // toward a meaningless zero-length direction instead of doing nothing.
  if (hit && markersReady) focusOn(hit.object);
});

// Sidebar country chips trigger the same spin-then-confirm flow as clicking
// the globe directly, instead of navigating immediately. Real href stays in
// place for keyboard use, middle-click, and no-JS fallback.
document.querySelectorAll('[data-branch-link]').forEach(function(el){
  el.addEventListener('click', function(e){
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
    // A real mouse click always has detail >= 1 (click count); a link
    // "clicked" via Enter/Space from the keyboard fires with detail === 0.
    // Without this, keyboard users could never actually reach a branch page
    // from this sidebar — Enter would silently just spin the globe instead.
    if (e.detail === 0) return;
    if (!markersReady) return; // let the real link navigate instead
    const slug = el.getAttribute('data-branch-link');
    const marker = markers.find(function(m){ return m.userData.slug === slug; });
    if (!marker) return;
    e.preventDefault();
    focusOn(marker);
    host.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });
});
</script>
