<div class="cookie-banner hidden" id="cookieBanner" role="dialog" aria-label="Cookie preferences" aria-describedby="cookieBannerText">
  <div class="cookie-panel">
    <p id="cookieBannerText" class="text-sm leading-relaxed">
      We use Cloudflare's privacy-friendly analytics to see which pages are useful — no cookies, no cross-site tracking, no personal profile built on you. Your choice here is saved so we don't ask again, and will apply automatically if that ever changes.
      <a href="/privacy/" class="underline font-semibold">Privacy Policy</a>
    </p>
    <div class="cookie-actions">
      <button type="button" class="btn" onclick="setCookieConsent('declined')">Decline</button>
      <button type="button" class="btn btn-accent" onclick="setCookieConsent('accepted')">Accept</button>
    </div>
  </div>
</div>

<style>
  .cookie-banner{ position:fixed; left:1rem; right:1rem; bottom:1rem; z-index:80; max-width:36rem; margin:0 auto; }
  .cookie-banner.hidden{ display:none; }
  .cookie-panel{ background:#fff; border:2px solid var(--ink); border-radius:1rem; box-shadow:6px 6px 0 var(--ink); padding:1.25rem 1.5rem; }
  .cookie-actions{ display:flex; gap:.65rem; margin-top:1rem; justify-content:flex-end; }
  @media (max-width: 480px){ .cookie-actions{ justify-content:stretch; } .cookie-actions .btn{ flex:1; justify-content:center; } }
</style>

<script>
  var COOKIE_CONSENT_KEY = 'elysium-cookie-consent';

  function getCookieConsent(){
    try { return localStorage.getItem(COOKIE_CONSENT_KEY); } catch (e) { return null; }
  }
  function hasAnalyticsConsent(){
    return getCookieConsent() === 'accepted';
  }
  // Cloudflare Web Analytics — cookieless, no cross-site tracking, no
  // fingerprinting, so it doesn't need cookie-level consent under most
  // readings of GDPR. Gated through the same consent flag anyway, since
  // this site makes a stronger privacy promise than the legal minimum.
  function loadAnalyticsIfConsented(){
    if (!hasAnalyticsConsent()) return;
    if (document.querySelector('script[data-cf-beacon]')) return;
    var s = document.createElement('script');
    s.type = 'module';
    s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
    s.setAttribute('data-cf-beacon', JSON.stringify({ token: 'afff231f9edd4db4b7bc43857e504246' }));
    document.head.appendChild(s);
  }
  function openCookiePrefs(){
    document.getElementById('cookieBanner').classList.remove('hidden');
  }
  function closeCookieBanner(){
    document.getElementById('cookieBanner').classList.add('hidden');
  }
  function setCookieConsent(value){
    try { localStorage.setItem(COOKIE_CONSENT_KEY, value); } catch (e) {}
    closeCookieBanner();
    if (value === 'accepted') loadAnalyticsIfConsented();
  }

  if (!getCookieConsent()) openCookiePrefs();
  else loadAnalyticsIfConsented();
</script>
