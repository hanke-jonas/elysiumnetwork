<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title or "Admin" }} — Elysium+ Network</title>
<link rel="icon" type="image/png" sizes="32x32" href="{{ site.favicon_32 }}">
<link rel="stylesheet" href="/assets/tailwind.css?v={{ cssVersion }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
{% include "theme-style.njk" %}
<style>
  .admin-nav-link{ font-size:.88rem; font-weight:600; padding:.5rem .7rem; border-radius:.5rem; color:var(--ink); white-space:nowrap; }
  .admin-nav-link:hover{ background:var(--paper-2); }
  .admin-nav-link.active{ background:var(--ink); color:var(--paper); }
  .admin-nav-drop{ position:absolute; top:calc(100% + .5rem); left:0; min-width:13rem; background:#fff; border:2px solid var(--ink); box-shadow:4px 4px 0 var(--ink); border-radius:.7rem; padding:.4rem; opacity:0; visibility:hidden; transform:translateY(4px); transition:opacity .15s, transform .15s, visibility .15s; z-index:20; }
  .admin-nav-item-drop:hover .admin-nav-drop, .admin-nav-item-drop:focus-within .admin-nav-drop, .admin-nav-item-drop.open .admin-nav-drop{ opacity:1; visibility:visible; transform:translateY(0); }
  .admin-nav-drop a{ display:flex; align-items:center; gap:.55rem; padding:.5rem .6rem; border-radius:.5rem; font-size:.85rem; font-weight:600; color:var(--ink); white-space:nowrap; }
  .admin-nav-drop a:hover{ background:var(--paper-2); }
  .admin-nav-drop a.active{ background:var(--ink); color:var(--paper); }
  .admin-table{ width:100%; border-collapse:collapse; font-size:.9rem; }
  .admin-table th{ text-align:left; font-family:"JetBrains Mono",monospace; text-transform:uppercase; letter-spacing:.06em; font-size:.68rem; font-weight:600; color:var(--muted); padding:.5rem .75rem; border-bottom:2px solid var(--ink); }
  .admin-table td{ padding:.65rem .75rem; border-bottom:1px solid var(--line); vertical-align:top; }
  .admin-table tr:last-child td{ border-bottom:none; }
  .stat-bar{ height:.85rem; border:2px solid var(--ink); border-radius:999px; background:var(--paper-2); overflow:hidden; }
  .stat-bar-fill{ height:100%; width:0%; transition:width .4s ease; }
</style>
</head>
<body class="bg-paper text-ink">
<div id="adminGate" class="min-h-screen grid place-items-center px-5">
  <p class="mono text-sm text-muted" id="adminGateMsg">Checking session…</p>
</div>
<div id="adminApp" class="min-h-screen flex flex-col" hidden>
  <header class="navbar">
    <div class="max-w-[1200px] mx-auto px-5 sm:px-8 py-3 flex flex-wrap items-center justify-between gap-3">
      <a href="/admin/" class="flex items-center gap-2 shrink-0">
        <img src="{{ site.logo_small }}" alt="" width="128" height="128" class="h-8 w-8 object-contain">
        <span class="font-display text-lg font-extrabold">Elysium<span style="color:var(--coral)">+</span> <span class="text-muted font-semibold">Admin</span></span>
      </a>
      <nav class="flex items-center gap-1 flex-wrap">
        <a href="/admin/" class="admin-nav-link{% if page.url == '/admin/' %} active{% endif %}">Dashboard</a>
        <a href="/admin/media/" class="admin-nav-link{% if page.url == '/admin/media/' %} active{% endif %}">Media</a>
        <div class="admin-nav-item-drop relative">
          <button type="button" class="admin-nav-link admin-nav-drop-btn inline-flex items-center gap-1{% if page.url in ['/admin/branches/', '/admin/team/', '/admin/blog/', '/admin/resources/', '/admin/calls/', '/admin/events/', '/admin/faqs/'] %} active{% endif %}" aria-haspopup="true" aria-expanded="false">Content {% icon "chevron", "w-3.5 h-3.5" %}</button>
          <div class="admin-nav-drop">
            <a href="/admin/branches/" class="{% if page.url == '/admin/branches/' %}active{% endif %}">{% icon "globe", "w-4 h-4 shrink-0" %}Branches</a>
            <a href="/admin/team/" class="{% if page.url == '/admin/team/' %}active{% endif %}">{% icon "id", "w-4 h-4 shrink-0" %}Team</a>
            <a href="/admin/blog/" class="{% if page.url == '/admin/blog/' %}active{% endif %}">{% icon "monitor", "w-4 h-4 shrink-0" %}Blog</a>
            <a href="/admin/resources/" class="{% if page.url == '/admin/resources/' %}active{% endif %}">{% icon "box", "w-4 h-4 shrink-0" %}Resources</a>
            <a href="/admin/calls/" class="{% if page.url == '/admin/calls/' %}active{% endif %}">{% icon "compass", "w-4 h-4 shrink-0" %}Calls</a>
            <a href="/admin/events/" class="{% if page.url == '/admin/events/' %}active{% endif %}">{% icon "calendar", "w-4 h-4 shrink-0" %}Events</a>
            <a href="/admin/faqs/" class="{% if page.url == '/admin/faqs/' %}active{% endif %}">{% icon "question", "w-4 h-4 shrink-0" %}FAQs</a>
          </div>
        </div>
        <div class="admin-nav-item-drop relative">
          <button type="button" class="admin-nav-link admin-nav-drop-btn inline-flex items-center gap-1{% if page.url in ['/admin/subscribers/', '/admin/campaigns/'] %} active{% endif %}" aria-haspopup="true" aria-expanded="false">Audience {% icon "chevron", "w-3.5 h-3.5" %}</button>
          <div class="admin-nav-drop">
            <a href="/admin/subscribers/" class="{% if page.url == '/admin/subscribers/' %}active{% endif %}">{% icon "id", "w-4 h-4 shrink-0" %}Subscribers</a>
            <a href="/admin/campaigns/" class="{% if page.url == '/admin/campaigns/' %}active{% endif %}">{% icon "mail", "w-4 h-4 shrink-0" %}Newsletter</a>
          </div>
        </div>
        <a href="/admin/stats/" class="admin-nav-link{% if page.url == '/admin/stats/' %} active{% endif %}">Stats</a>
        <a href="/admin/staff/" id="staffNavLink" class="admin-nav-link{% if page.url == '/admin/staff/' %} active{% endif %}" hidden>Staff</a>
      </nav>
      <div class="flex items-center gap-3">
        <span id="adminWhoami" class="mono text-xs text-muted hidden sm:inline"></span>
        <button id="adminLogoutBtn" type="button" class="btn !py-2 !px-3 text-sm">Log out</button>
      </div>
    </div>
  </header>
  <main class="flex-1 max-w-[1200px] w-full mx-auto px-5 sm:px-8 py-10">
    {{ content | safe }}
  </main>
</div>
{% include "dialog.njk" %}
<script>
  // Shared fetch helper for every admin page: always sends the session
  // cookie, always parses JSON, and bounces to login on an expired/missing
  // session instead of making every page reimplement that check.
  window.adminFetch = function (url, opts) {
    opts = opts || {};
    opts.credentials = 'include';
    // A FormData body (file uploads) needs the browser to set its own
    // Content-Type with the correct multipart boundary — forcing
    // application/json here would silently break every upload.
    opts.headers = opts.body instanceof FormData
      ? (opts.headers || {})
      : Object.assign({ 'Content-Type': 'application/json' }, opts.headers || {});
    return fetch(url, opts).then(function (res) {
      if (res.status === 401) {
        location.href = '/admin/login/?next=' + encodeURIComponent(location.pathname);
        throw new Error('Not signed in');
      }
      return res.json().then(function (data) { return { ok: res.ok, status: res.status, data: data }; });
    });
  };

  (function () {
    fetch('/api/auth/me', { credentials: 'include' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.signedIn || data.type !== 'staff') {
          location.href = '/admin/login/?next=' + encodeURIComponent(location.pathname);
          return;
        }
        window.__staff = data.user;
        document.getElementById('adminWhoami').textContent = data.user.name + ' · ' + data.user.role;
        if (data.user.role === 'owner') document.getElementById('staffNavLink').hidden = false;
        // Not the `hidden` attribute: this element also carries Tailwind's
        // `grid` utility (display:grid), which has equal CSS specificity to
        // the browser's built-in [hidden]{display:none} rule and — since
        // Tailwind's stylesheet loads after the UA stylesheet — wins the
        // tie, so `hidden` alone silently never actually hides it. Confirmed
        // live: the gate stayed rendered at min-h-screen height with the
        // real dashboard pushed down below it, needing a scroll to reach.
        document.getElementById('adminGate').style.display = 'none';
        document.getElementById('adminApp').hidden = false;
        document.dispatchEvent(new CustomEvent('admin:ready', { detail: data.user }));
      })
      .catch(function () {
        document.getElementById('adminGateMsg').textContent = 'Could not reach the server — try reloading.';
      });

    document.getElementById('adminLogoutBtn').addEventListener('click', function () {
      fetch('/api/auth/logout', { method: 'POST', credentials: 'include' }).then(function () {
        location.href = '/admin/login/';
      });
    });
  })();

  // Click-to-toggle for the Content/Audience nav dropdowns (the CSS also
  // reveals them on hover/focus-within, same pattern as the main site nav).
  (function () {
    document.querySelectorAll('.admin-nav-item-drop').forEach(function (wrap) {
      var btn = wrap.querySelector('.admin-nav-drop-btn');
      if (!btn) return;
      function closeDrop() { wrap.classList.remove('open'); btn.setAttribute('aria-expanded', 'false'); }
      function openDrop() { wrap.classList.add('open'); btn.setAttribute('aria-expanded', 'true'); }
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        var wasOpen = wrap.classList.contains('open');
        document.querySelectorAll('.admin-nav-item-drop.open').forEach(function (openWrap) {
          if (openWrap !== wrap) openWrap.classList.remove('open');
        });
        if (wasOpen) closeDrop(); else openDrop();
      });
      document.addEventListener('click', function (e) { if (!wrap.contains(e.target)) closeDrop(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeDrop(); });
    });
  })();
</script>
</body>
</html>
