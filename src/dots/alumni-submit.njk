---
layout: base.njk
title: "Submit your DOTS profile — Elysium+ Network"
description: "Enter your personal access code to add your photo and story to the DOTS alumni gallery."
permalink: /dots/alumni/submit/
---
<section class="bg-paper">
  <div class="max-w-2xl mx-auto px-5 py-16" id="pageWrap">
    <nav class="mono text-xs text-muted mb-8 uppercase tracking-wider">
      <a href="/" class="hover:underline">Home</a> <span class="mx-1 opacity-40">/</span>
      <a href="/dots/alumni/" class="hover:underline">DOTS Alumni</a> <span class="mx-1 opacity-40">/</span>
      <span class="text-ink/90">Submit</span>
    </nav>
    <p class="eyebrow" style="color:var(--coral-ink)">Were you on DOTS?</p>
    <h1 class="h-hero mt-4" style="font-size:2.25rem" id="pageHeading">Add your page</h1>

    <div class="card p-8 mt-8 max-w-md" id="codeCard">
      <p class="text-muted leading-relaxed mb-5">Enter your personal access code. It's yours to keep — the same code creates your page the first time and lets you edit it any time after.</p>
      <form id="code-form" class="flex flex-col gap-4">
        <div>
          <label class="form-label" for="code">Access code</label>
          <input class="input font-mono uppercase" type="text" id="code" name="code" maxlength="8" required autocomplete="off">
        </div>
        <button type="submit" id="code-btn" class="btn btn-accent w-full justify-center">Continue</button>
        <p id="code-status" role="status" aria-live="polite" class="text-sm"></p>
      </form>
    </div>

    <div class="card p-8 mt-8" id="formCard" hidden>
      <p class="text-sm text-muted mb-6" id="editionLabel">This is your page. Fill in what you'd like — only your name and a short bio are needed, everything else is up to you.</p>
      <p class="text-sm mt-1 mb-5" id="pendingEditNotice" hidden style="color:var(--coral-ink)">You already have a change waiting for review — submitting again updates that same proposal rather than adding a new one.</p>

      <form id="alumni-form" class="flex flex-col gap-7">
        <input type="hidden" id="hiddenCode" name="code">

        <div>
          <label class="form-label" for="nameInput">Your name *</label>
          <input class="input" type="text" id="nameInput" name="name" maxlength="100" required placeholder="e.g. Alex Müller">
        </div>

        <div>
          <label class="form-label" for="pronounsInput">Your pronouns (optional)</label>
          <input class="input" type="text" id="pronounsInput" name="pronouns" maxlength="30" placeholder="e.g. she/her, he/him, they/them">
        </div>

        <div>
          <p class="form-label">Your photo (optional)</p>
          <p class="text-xs text-muted mb-2">Add a photo of yourself, or skip this — totally fine either way.</p>
          <input type="hidden" id="photoUrlInput" name="photo_url">
          <div id="photoEmpty">
            <label class="btn cursor-pointer inline-flex">📷 Add a photo<input type="file" id="photoFile" accept="image/jpeg,image/png,image/webp" class="sr-only"></label>
          </div>
          <div id="photoFilled" hidden class="flex items-center gap-3">
            <img id="photoPreview" src="" alt="" class="w-20 h-20 rounded-xl object-cover border-2 border-ink">
            <div class="flex gap-2">
              <label class="btn !py-1.5 !px-3 text-xs cursor-pointer inline-flex">Change<input type="file" id="photoFileChange" accept="image/jpeg,image/png,image/webp" class="sr-only"></label>
              <button type="button" id="photoRemoveBtn" class="btn btn-coral !py-1.5 !px-3 text-xs">Remove</button>
            </div>
          </div>
          <p id="photoStatus" role="status" aria-live="polite" class="text-xs mt-2 text-muted"></p>
        </div>

        <div>
          <label class="form-label" for="bioInput">A short bio *</label>
          <p class="text-xs text-muted mb-2">A few sentences about yourself — this is what shows on your gallery card.</p>
          <textarea class="input" id="bioInput" name="bio" rows="3" maxlength="600" required placeholder="A little about who you are…"></textarea>
        </div>

        <div>
          <label class="form-label" for="roleInput">What are you doing now? (optional)</label>
          <p class="text-xs text-muted mb-2">Studying, working, a project you're excited about — anything!</p>
          <input class="input" type="text" id="roleInput" name="current_role" maxlength="120" placeholder="e.g. Studying law in Berlin">
        </div>

        <div>
          <label class="form-label" for="locationInput">Where are you based? (optional)</label>
          <input class="input" type="text" id="locationInput" name="location" maxlength="80" placeholder="e.g. Leipzig, Germany">
        </div>

        <div>
          <label class="form-label" for="quoteInput">A favourite quote or piece of advice (optional)</label>
          <input class="input" type="text" id="quoteInput" name="quote" maxlength="300" placeholder="Something you'd want future participants to hear">
        </div>

        <div>
          <label class="form-label" for="storyInput">Your story (optional)</label>
          <p class="text-xs text-muted mb-2">Want to share more? This only shows on your own page, not the gallery.</p>
          <textarea class="input" id="storyInput" name="story" rows="5" maxlength="4000" placeholder="Tell us more, if you'd like…"></textarea>
        </div>

        <div>
          <p class="form-label">Your links (optional)</p>
          <div class="flex flex-col gap-2 mt-1">
            <input class="input" type="text" name="instagram" maxlength="300" placeholder="Instagram">
            <input class="input" type="text" name="linkedin" maxlength="300" placeholder="LinkedIn">
            <input class="input" type="text" name="website" maxlength="300" placeholder="Website">
          </div>
        </div>

        <div>
          <p class="form-label">More photos (optional)</p>
          <p class="text-xs text-muted mb-2">Add a few extra photos if you'd like — up to 6.</p>
          <input type="hidden" id="photosInput" name="photos">
          <div id="extraPhotosGrid" class="grid grid-cols-3 sm:grid-cols-4 gap-2 mb-2"></div>
          <label id="addExtraPhotoBtn" class="btn !py-1.5 !px-3 text-xs cursor-pointer inline-flex">+ Add a photo<input type="file" id="extraPhotoFile" accept="image/jpeg,image/png,image/webp" class="sr-only"></label>
          <p id="extraPhotoStatus" role="status" aria-live="polite" class="text-xs mt-2 text-muted"></p>
        </div>

        <!-- Honeypot: hidden from real visitors via CSS, invisible to screen
             readers via aria-hidden — a bot filling this out is the tell. -->
        <div style="position:absolute;left:-9999px;top:-9999px" aria-hidden="true">
          <label for="website_hp">Leave this field blank</label>
          <input type="text" id="website_hp" name="website_hp" tabindex="-1" autocomplete="off">
        </div>

        <label class="flex items-start gap-2.5 text-xs text-muted" style="cursor:pointer">
          <input type="checkbox" id="consentCheck" name="consent" required class="mt-0.5 shrink-0" style="width:1rem;height:1rem">
          <span>I agree that the name, photo, and any other details I add here will be reviewed by Elysium+ Network staff and published on this public page — and that I can come back and edit or remove it any time using this same access code. See our <a href="/privacy/" target="_blank" class="underline">privacy policy</a> for how we handle this.</span>
        </label>

        <button type="submit" id="submit-btn" class="btn btn-accent w-full justify-center">Submit</button>
      </form>
      <p id="status-msg" role="status" aria-live="polite" class="text-sm mt-4"></p>

      <div id="deleteSection" hidden class="mt-8 pt-6 text-center" style="border-top:1px solid var(--line)">
        <p id="deletePendingNotice" hidden class="text-sm" style="color:var(--coral-ink)">Your removal request is awaiting review — your page stays up until then.</p>
        <div id="deletePrompt">
          <p class="text-xs text-muted mb-2">Want your page taken down instead of edited?</p>
          <button type="button" id="requestDeleteBtn" class="btn btn-coral !py-1.5 !px-3 text-xs">Request removal</button>
        </div>
        <p id="delete-status" role="status" aria-live="polite" class="text-sm mt-2"></p>
      </div>
    </div>
  </div>
</section>
{% include "dialog.njk" %}

<div id="cropModalOverlay" style="position:fixed;inset:0;background:rgba(25,23,18,.85);z-index:300;display:none;align-items:center;justify-content:center;padding:1rem">
  <div style="background:#fff;border:2px solid var(--ink);border-radius:1rem;box-shadow:8px 8px 0 var(--ink);max-width:26rem;width:100%;padding:1.5rem;max-height:92vh;overflow-y:auto">
    <h3 class="h-card mb-1">Move and scale</h3>
    <p class="text-xs text-muted mb-3">Drag to reposition, pinch or use the slider to zoom — or skip straight to automatic face detection.</p>
    <div id="cropFrame" style="position:relative;width:100%;aspect-ratio:1/1;overflow:hidden;border-radius:1rem;background:#191712;cursor:grab;touch-action:none">
      <canvas id="cropCanvas" style="position:absolute;top:0;left:0;width:100%;height:100%"></canvas>
      <div style="position:absolute;inset:0;pointer-events:none;border-radius:50%;box-shadow:0 0 0 9999px rgba(25,23,18,.72);outline:2px solid rgba(255,255,255,.9)"></div>
    </div>
    <div class="flex items-center gap-3 mt-4">
      <span class="text-xs text-muted mono" aria-hidden="true">–</span>
      <input type="range" id="cropZoom" min="1" max="3" step="0.01" value="1" style="flex:1" aria-label="Zoom">
      <span class="text-xs text-muted mono" aria-hidden="true">+</span>
    </div>
    <div class="flex flex-wrap gap-2 mt-4">
      <button type="button" id="cropUseRecommendedBtn" class="btn btn-accent">✨ Use recommended (automatic face detection)</button>
      <button type="button" id="cropSaveBtn" class="btn">Save this crop</button>
      <button type="button" id="cropCancelBtn" class="btn btn-coral">Cancel</button>
    </div>
    <p id="cropStatus" role="status" aria-live="polite" class="text-xs mt-2 text-muted"></p>
  </div>
</div>

<script>
(function () {
  var mode = 'create';

  var pageHeading = document.getElementById('pageHeading');
  var codeCard = document.getElementById('codeCard');
  var codeForm = document.getElementById('code-form');
  var codeInput = document.getElementById('code');
  var codeBtn = document.getElementById('code-btn');
  var codeStatus = document.getElementById('code-status');
  var formCard = document.getElementById('formCard');
  var editionLabel = document.getElementById('editionLabel');
  var pendingEditNotice = document.getElementById('pendingEditNotice');
  var deleteSection = document.getElementById('deleteSection');
  var deletePendingNotice = document.getElementById('deletePendingNotice');
  var deletePrompt = document.getElementById('deletePrompt');
  var requestDeleteBtn = document.getElementById('requestDeleteBtn');
  var deleteStatus = document.getElementById('delete-status');
  var hiddenCode = document.getElementById('hiddenCode');
  var alumniForm = document.getElementById('alumni-form');

  function uploadImage(file, onDone) {
    var fd = new FormData();
    fd.append('code', hiddenCode.value);
    fd.append('file', file);
    return fetch('/api/dots-alumni/upload-block-image', { method: 'POST', body: fd })
      .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
      .then(function (r) { onDone(r.ok ? r.data.url : null, r.ok ? null : (r.data && r.data.error)); })
      .catch(function () { onDone(null, 'Network error.'); });
  }

  // --- Crop / reposition modal ------------------------------------------
  // Every uploaded photo goes to R2 as-is first (uploadImage above), then
  // this modal opens on that already-hosted URL so there's always a real
  // file to fall back to if the user cancels. Two ways out: "recommended"
  // just keeps that original URL untouched -- every photo display on the
  // site already runs it through Cloudflare's automatic face-aware crop
  // (functions/uploads/[[path]].js's ?face=1 transform, via the faceCrop
  // filter in templates), so "recommended" genuinely means "let the
  // system already built for this handle it," not a placeholder. "Save
  // this crop" renders the current pan/zoom to a fixed frame and uploads
  // THAT as a new, separate file -- the manual choice takes precedence
  // over automatic cropping from then on, since it's now the only image
  // faceCrop has to work with.
  (function () {
    var overlay = document.getElementById('cropModalOverlay');
    var frame = document.getElementById('cropFrame');
    var canvas = document.getElementById('cropCanvas');
    var ctx = canvas.getContext('2d');
    var zoomSlider = document.getElementById('cropZoom');
    var useRecommendedBtn = document.getElementById('cropUseRecommendedBtn');
    var saveBtn = document.getElementById('cropSaveBtn');
    var cancelBtn = document.getElementById('cropCancelBtn');
    var cropStatus = document.getElementById('cropStatus');

    var img = null, coverScale = 1, scale = 1, offsetX = 0, offsetY = 0;
    var activeOriginalUrl = null, activeOnDone = null;
    var OUT_W = 960, OUT_H = 960;

    // Pointer Events unify mouse + touch, so a plain single-pointer drag
    // already works on phones -- but WhatsApp's actual feel comes from
    // pinch-to-zoom, which needs BOTH active touches tracked at once.
    // `pointers` holds every currently-down pointer by id; one active
    // pointer means "pan", two means "pinch", and lifting one finger
    // during a pinch drops back to panning from wherever that remaining
    // finger already is (no jump).
    var pointers = {};
    var panFrom = null; // {x, y, offsetX, offsetY}
    var pinchFrom = null; // {dist, scale} while two pointers are down

    function frameSize() {
      var rect = frame.getBoundingClientRect();
      return { w: rect.width, h: rect.height };
    }

    function minScale() { return coverScale; }
    function maxScale() { return coverScale * 3; }

    function clampOffsets() {
      var fs = frameSize();
      var iw = img.naturalWidth * scale, ih = img.naturalHeight * scale;
      offsetX = Math.min(0, Math.max(fs.w - iw, offsetX));
      offsetY = Math.min(0, Math.max(fs.h - ih, offsetY));
    }

    function draw() {
      var fs = frameSize();
      var dpr = window.devicePixelRatio || 1;
      canvas.width = fs.w * dpr;
      canvas.height = fs.h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, fs.w, fs.h);
      if (!img) return;
      ctx.drawImage(img, offsetX, offsetY, img.naturalWidth * scale, img.naturalHeight * scale);
    }

    function pointerDist(ids) {
      var a = pointers[ids[0]], b = pointers[ids[1]];
      return Math.hypot(a.x - b.x, a.y - b.y);
    }
    function pointerMid(ids) {
      var a = pointers[ids[0]], b = pointers[ids[1]];
      return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
    }

    function setZoomFromScale() {
      zoomSlider.value = String(scale / coverScale);
    }

    frame.addEventListener('pointerdown', function (e) {
      if (!img) return;
      frame.setPointerCapture(e.pointerId);
      pointers[e.pointerId] = { x: e.clientX, y: e.clientY };
      var ids = Object.keys(pointers);
      if (ids.length === 1) {
        panFrom = { x: e.clientX, y: e.clientY, offsetX: offsetX, offsetY: offsetY };
        frame.style.cursor = 'grabbing';
      } else if (ids.length === 2) {
        panFrom = null;
        pinchFrom = { dist: pointerDist(ids), scale: scale };
      }
    });
    frame.addEventListener('pointermove', function (e) {
      if (!pointers[e.pointerId] || !img) return;
      pointers[e.pointerId] = { x: e.clientX, y: e.clientY };
      var ids = Object.keys(pointers);
      if (ids.length === 2 && pinchFrom) {
        var rect = frame.getBoundingClientRect();
        var mid = pointerMid(ids);
        var localX = mid.x - rect.left, localY = mid.y - rect.top;
        var newScale = Math.min(maxScale(), Math.max(minScale(), pinchFrom.scale * (pointerDist(ids) / pinchFrom.dist)));
        var ratio = newScale / scale;
        offsetX = localX - (localX - offsetX) * ratio;
        offsetY = localY - (localY - offsetY) * ratio;
        scale = newScale;
        setZoomFromScale();
        clampOffsets();
        draw();
      } else if (ids.length === 1 && panFrom) {
        offsetX = panFrom.offsetX + (e.clientX - panFrom.x);
        offsetY = panFrom.offsetY + (e.clientY - panFrom.y);
        clampOffsets();
        draw();
      }
    });
    function releasePointer(e) {
      delete pointers[e.pointerId];
      var ids = Object.keys(pointers);
      pinchFrom = null;
      if (ids.length === 1) {
        var p = pointers[ids[0]];
        panFrom = { x: p.x, y: p.y, offsetX: offsetX, offsetY: offsetY };
      } else {
        panFrom = null;
      }
      if (!ids.length) frame.style.cursor = 'grab';
    }
    ['pointerup', 'pointercancel', 'pointerleave'].forEach(function (evt) {
      frame.addEventListener(evt, releasePointer);
    });

    zoomSlider.addEventListener('input', function () {
      if (!img) return;
      var fs = frameSize();
      var cx = fs.w / 2, cy = fs.h / 2;
      var prevScale = scale;
      scale = coverScale * Number(zoomSlider.value);
      var ratio = scale / prevScale;
      offsetX = cx - (cx - offsetX) * ratio;
      offsetY = cy - (cy - offsetY) * ratio;
      clampOffsets();
      draw();
    });

    function loadImage(url) {
      cropStatus.textContent = '';
      cropStatus.style.color = '';
      img = null;
      var el = new Image();
      el.onload = function () {
        img = el;
        var fs = frameSize();
        coverScale = Math.max(fs.w / img.naturalWidth, fs.h / img.naturalHeight);
        scale = coverScale;
        zoomSlider.value = '1';
        offsetX = (fs.w - img.naturalWidth * scale) / 2;
        offsetY = (fs.h - img.naturalHeight * scale) / 2;
        draw();
      };
      el.onerror = function () {
        cropStatus.style.color = 'var(--coral-ink)';
        cropStatus.textContent = "Couldn't load that image for cropping — try again.";
      };
      el.src = url;
    }

    window.openCropModal = function (originalUrl, onDone) {
      activeOriginalUrl = originalUrl;
      activeOnDone = onDone;
      overlay.style.display = 'flex';
      loadImage(originalUrl);
    };

    function close() {
      overlay.style.display = 'none';
      img = null;
      activeOriginalUrl = null;
      activeOnDone = null;
    }

    cancelBtn.addEventListener('click', close);
    overlay.addEventListener('click', function (e) { if (e.target === overlay) close(); });

    useRecommendedBtn.addEventListener('click', function () {
      var onDone = activeOnDone;
      var url = activeOriginalUrl;
      close();
      if (onDone) onDone(url);
    });

    saveBtn.addEventListener('click', function () {
      if (!img) return;
      saveBtn.disabled = true;
      cropStatus.style.color = '';
      cropStatus.textContent = 'Saving your crop…';

      var out = document.createElement('canvas');
      out.width = OUT_W; out.height = OUT_H;
      var octx = out.getContext('2d');
      var fs = frameSize();
      var sx = OUT_W / fs.w, sy = OUT_H / fs.h;
      octx.drawImage(img, offsetX * sx, offsetY * sy, img.naturalWidth * scale * sx, img.naturalHeight * scale * sy);

      out.toBlob(function (blob) {
        if (!blob) {
          saveBtn.disabled = false;
          cropStatus.style.color = 'var(--coral-ink)';
          cropStatus.textContent = "Couldn't process that crop — try again.";
          return;
        }
        var file = new File([blob], 'cropped.jpg', { type: 'image/jpeg' });
        var onDone = activeOnDone;
        uploadImage(file, function (url, err) {
          saveBtn.disabled = false;
          if (!url) {
            cropStatus.style.color = 'var(--coral-ink)';
            cropStatus.textContent = err || 'Upload failed — try again.';
            return;
          }
          close();
          if (onDone) onDone(url);
        });
      }, 'image/jpeg', 0.9);
    });
  })();

  // --- Main photo -------------------------------------------------------
  var photoUrlInput = document.getElementById('photoUrlInput');
  var photoEmpty = document.getElementById('photoEmpty');
  var photoFilled = document.getElementById('photoFilled');
  var photoPreview = document.getElementById('photoPreview');
  var photoStatus = document.getElementById('photoStatus');

  function setPhoto(url) {
    photoUrlInput.value = url || '';
    if (url) {
      photoPreview.src = url;
      photoEmpty.hidden = true;
      photoFilled.hidden = false;
    } else {
      photoEmpty.hidden = false;
      photoFilled.hidden = true;
    }
  }

  function handlePhotoFile(file) {
    if (!file) return;
    photoStatus.style.color = '';
    photoStatus.textContent = 'Uploading…';
    uploadImage(file, function (url, err) {
      if (!url) {
        photoStatus.style.color = 'var(--coral-ink)';
        photoStatus.textContent = err || 'Upload failed — try again.';
        return;
      }
      photoStatus.textContent = '';
      window.openCropModal(url, function (finalUrl) { setPhoto(finalUrl); });
    });
  }

  document.getElementById('photoFile').addEventListener('change', function (e) { handlePhotoFile(e.target.files[0]); e.target.value = ''; });
  document.getElementById('photoFileChange').addEventListener('change', function (e) { handlePhotoFile(e.target.files[0]); e.target.value = ''; });
  document.getElementById('photoRemoveBtn').addEventListener('click', function () { setPhoto(''); });

  // --- Extra photos -------------------------------------------------------
  var MAX_EXTRA_PHOTOS = 6;
  var extraPhotos = [];
  var extraPhotosGrid = document.getElementById('extraPhotosGrid');
  var photosInput = document.getElementById('photosInput');
  var extraPhotoStatus = document.getElementById('extraPhotoStatus');
  var addExtraPhotoBtn = document.getElementById('addExtraPhotoBtn');

  function renderExtraPhotos() {
    extraPhotosGrid.innerHTML = '';
    extraPhotos.forEach(function (url, i) {
      var wrap = document.createElement('div');
      wrap.style.cssText = 'position:relative';
      var img = document.createElement('img');
      img.src = url;
      img.alt = '';
      img.className = 'w-full aspect-square object-cover rounded-lg border-2 border-ink';
      var rm = document.createElement('button');
      rm.type = 'button';
      rm.textContent = '×';
      rm.setAttribute('aria-label', 'Remove this photo');
      rm.style.cssText = 'position:absolute;top:-.4rem;right:-.4rem;width:1.5rem;height:1.5rem;border-radius:999px;background:var(--coral);border:2px solid var(--ink);font-weight:700;line-height:1';
      rm.addEventListener('click', function () { extraPhotos.splice(i, 1); renderExtraPhotos(); });
      wrap.appendChild(img);
      wrap.appendChild(rm);
      extraPhotosGrid.appendChild(wrap);
    });
    photosInput.value = JSON.stringify(extraPhotos);
    addExtraPhotoBtn.style.display = extraPhotos.length >= MAX_EXTRA_PHOTOS ? 'none' : '';
  }

  document.getElementById('extraPhotoFile').addEventListener('change', function (e) {
    var file = e.target.files[0];
    e.target.value = '';
    if (!file || extraPhotos.length >= MAX_EXTRA_PHOTOS) return;
    extraPhotoStatus.style.color = '';
    extraPhotoStatus.textContent = 'Uploading…';
    uploadImage(file, function (url, err) {
      extraPhotoStatus.textContent = '';
      if (!url) {
        extraPhotoStatus.style.color = 'var(--coral-ink)';
        extraPhotoStatus.textContent = err || 'Upload failed — try again.';
        return;
      }
      extraPhotos.push(url);
      renderExtraPhotos();
    });
  });

  // --- Prefill for editing -------------------------------------------------
  function fillForm(current) {
    document.getElementById('nameInput').value = current.name || '';
    document.getElementById('pronounsInput').value = current.pronouns || '';
    document.getElementById('bioInput').value = current.bio || '';
    document.getElementById('roleInput').value = current.currentRole || '';
    document.getElementById('locationInput').value = current.location || '';
    document.getElementById('quoteInput').value = current.quote || '';
    document.getElementById('storyInput').value = current.story || '';
    setPhoto(current.photoUrl || '');
    var links = current.links || [];
    links.forEach(function (l) {
      var field = l.label === 'Instagram' ? 'instagram' : l.label === 'LinkedIn' ? 'linkedin' : l.label === 'Website' ? 'website' : null;
      if (field) alumniForm.elements[field].value = l.url || '';
    });
    extraPhotos = (current.photos || []).slice(0, MAX_EXTRA_PHOTOS);
    renderExtraPhotos();
  }

  function checkCode(code) {
    codeBtn.disabled = true;
    codeStatus.style.color = 'unset';
    codeStatus.textContent = 'Checking…';

    fetch('/api/dots-alumni/check-code', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code: code }),
    }).then(function (res) { return res.json(); }).then(function (data) {
      codeBtn.disabled = false;
      if (!data.valid) {
        codeStatus.style.color = 'var(--coral-ink)';
        codeStatus.textContent = data.error || 'That code is not valid.';
        return;
      }
      hiddenCode.value = code;
      mode = data.mode || 'create';
      if (mode === 'edit') {
        pageHeading.textContent = 'Edit your page';
        editionLabel.textContent = 'Changes are reviewed before they go live, so your current page stays up until then.';
        document.getElementById('submit-btn').textContent = 'Propose changes';
        pendingEditNotice.hidden = !data.hasPendingEdit;
        if (data.current) fillForm(data.current);
        deleteSection.hidden = false;
        deletePendingNotice.hidden = !data.hasPendingDeletion;
        deletePrompt.hidden = !!data.hasPendingDeletion;
      }
      codeCard.hidden = true;
      formCard.hidden = false;
    }).catch(function () {
      codeBtn.disabled = false;
      codeStatus.style.color = 'var(--coral-ink)';
      codeStatus.textContent = 'Network error. Please try again.';
    });
  }

  codeForm.addEventListener('submit', function (e) {
    e.preventDefault();
    checkCode(codeInput.value.trim().toUpperCase());
  });

  // Convenience: a shared link like /dots/alumni/submit/?code=ABCD1234
  // jumps straight to checking the code.
  var prefill = new URLSearchParams(location.search).get('code');
  if (prefill) {
    codeInput.value = prefill.toUpperCase();
    checkCode(prefill.toUpperCase());
  }

  // --- Submission ------------------------------------------------------
  alumniForm.addEventListener('submit', function (e) {
    e.preventDefault();

    var form = e.target;
    var statusMsg = document.getElementById('status-msg');
    var submitBtn = document.getElementById('submit-btn');

    statusMsg.style.color = 'unset';
    statusMsg.textContent = mode === 'edit' ? 'Submitting your changes…' : 'Submitting…';
    submitBtn.disabled = true;

    var endpoint = mode === 'edit' ? '/api/dots-alumni/propose-edit' : '/api/dots-alumni/submit';

    fetch(endpoint, {
      method: 'POST',
      body: new FormData(form),
    }).then(function (res) {
      return res.json().then(function (data) { return { ok: res.ok, data: data }; });
    }).then(function (r) {
      submitBtn.disabled = false;
      if (!r.ok) {
        statusMsg.style.color = 'var(--coral-ink)';
        statusMsg.textContent = (r.data && r.data.error) || 'Something went wrong. Please try again.';
        return;
      }
      form.hidden = true;
      statusMsg.style.color = 'var(--mint-ink)';
      statusMsg.textContent = mode === 'edit'
        ? 'Thanks! Your changes are in for review — your live page stays as it is until they’re approved.'
        : 'Thanks! Your submission is in for review and will appear on the alumni page once approved.';
    }).catch(function () {
      submitBtn.disabled = false;
      statusMsg.style.color = 'var(--coral-ink)';
      statusMsg.textContent = 'Network error. Please try again.';
    });
  });

  requestDeleteBtn.addEventListener('click', function () {
    confirmDialog(
      'Ask staff to remove your page? This asks for review, same as an edit — your page stays live until they approve it.',
      'Request removal',
    ).then(function (ok) {
      if (!ok) return;
      requestDeleteBtn.disabled = true;
      deleteStatus.style.color = '';
      deleteStatus.textContent = 'Sending…';
      fetch('/api/dots-alumni/request-deletion', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code: hiddenCode.value }),
      }).then(function (res) {
        return res.json().then(function (data) { return { ok: res.ok, data: data }; });
      }).then(function (r) {
        requestDeleteBtn.disabled = false;
        if (!r.ok) {
          deleteStatus.style.color = 'var(--coral-ink)';
          deleteStatus.textContent = (r.data && r.data.error) || 'Something went wrong.';
          return;
        }
        deleteStatus.textContent = '';
        deletePendingNotice.hidden = false;
        deletePrompt.hidden = true;
      }).catch(function () {
        requestDeleteBtn.disabled = false;
        deleteStatus.style.color = 'var(--coral-ink)';
        deleteStatus.textContent = 'Network error. Please try again.';
      });
    });
  });
})();
</script>
