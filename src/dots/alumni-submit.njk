---
layout: base.njk
title: "Submit your DOTS profile — Elysium+ Network"
description: "Enter your personal access code to add your photo and story to the DOTS alumni gallery."
permalink: /dots/alumni/submit/
---
<section class="bg-paper">
  <div class="max-w-2xl mx-auto px-5 py-16" id="pageWrap">
    <nav class="mono text-xs text-muted mb-8 uppercase tracking-wider">
      <a href="/" class="hover:underline">Home</a> <span class="mx-1 opacity-40">/</span>
      <a href="/dots/alumni/" class="hover:underline">DOTS Alumni</a> <span class="mx-1 opacity-40">/</span>
      <span class="text-ink/90">Submit</span>
    </nav>
    <p class="eyebrow" style="color:var(--coral-ink)">Were you on DOTS?</p>
    <h1 class="h-hero mt-4" style="font-size:2.25rem" id="pageHeading">Add your page</h1>

    <div class="card p-8 mt-8 max-w-md" id="codeCard">
      <p class="text-muted leading-relaxed mb-5">Enter your personal access code. It's yours to keep — the same code creates your page the first time and lets you edit it any time after.</p>
      <form id="code-form" class="flex flex-col gap-4">
        <div>
          <label class="form-label" for="code">Access code</label>
          <input class="input font-mono uppercase" type="text" id="code" name="code" maxlength="8" required autocomplete="off">
        </div>
        <button type="submit" id="code-btn" class="btn btn-accent w-full justify-center">Continue</button>
        <p id="code-status" role="status" aria-live="polite" class="text-sm"></p>
      </form>
    </div>

    <div class="card p-8 mt-8" id="formCard" hidden>
      <p class="text-sm text-muted mb-5" id="editionLabel">Submissions are reviewed before they go live, so it may take a little while to appear.</p>
      <p class="text-sm mt-1 mb-5" id="pendingEditNotice" hidden style="color:var(--coral-ink)">You already have a change waiting for review — submitting again updates that same proposal rather than adding a new one.</p>

      <div class="flex items-start justify-between gap-3 mb-4">
        <p class="text-xs text-muted">This is your whole page, one section at a time — drag to reorder anything. Your name and bio are required (shown in every gallery listing), so those two can be edited and repositioned but not removed entirely. A photo is recommended but optional — everything else, including your photo, is fully optional and removable.</p>
        <button type="button" id="takeTourBtn" class="btn !py-1.5 !px-3 text-xs shrink-0">🎓 Take the tour</button>
      </div>

      <form id="alumni-form" class="flex flex-col gap-3">
        <input type="hidden" id="hiddenCode" name="code">
        <div id="blocksList" class="flex flex-col gap-3 mb-2"></div>

        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          <button type="button" class="rounded-xl border-2 border-ink p-3 text-left transition hover:-translate-y-0.5" style="background:#fff" data-add="quote">
            <span class="block font-semibold text-sm">+ Quote</span>
            <span class="block text-xs text-muted mt-0.5">A line of advice or a memory</span>
          </button>
          <button type="button" class="rounded-xl border-2 border-ink p-3 text-left transition hover:-translate-y-0.5" style="background:#fff" data-add="subtitle">
            <span class="block font-semibold text-sm">+ What &amp; where</span>
            <span class="block text-xs text-muted mt-0.5">What you're up to, where you're based</span>
          </button>
          <button type="button" class="rounded-xl border-2 border-ink p-3 text-left transition hover:-translate-y-0.5" style="background:#fff" data-add="links">
            <span class="block font-semibold text-sm">+ Links</span>
            <span class="block text-xs text-muted mt-0.5">Instagram, LinkedIn, your website</span>
          </button>
          <button type="button" class="rounded-xl border-2 border-ink p-3 text-left transition hover:-translate-y-0.5" style="background:#fff" data-add="heading">
            <span class="block font-semibold text-sm">+ Heading</span>
            <span class="block text-xs text-muted mt-0.5">A short section title</span>
          </button>
          <button type="button" class="rounded-xl border-2 border-ink p-3 text-left transition hover:-translate-y-0.5" style="background:#fff" data-add="paragraph">
            <span class="block font-semibold text-sm">+ Text</span>
            <span class="block text-xs text-muted mt-0.5">A paragraph of writing</span>
          </button>
          <button type="button" class="rounded-xl border-2 border-ink p-3 text-left transition hover:-translate-y-0.5" style="background:#fff" data-add="image">
            <span class="block font-semibold text-sm">+ Image</span>
            <span class="block text-xs text-muted mt-0.5">One photo, with a caption</span>
          </button>
          <button type="button" class="rounded-xl border-2 border-ink p-3 text-left transition hover:-translate-y-0.5" style="background:#fff" data-add="gallery">
            <span class="block font-semibold text-sm">+ Gallery</span>
            <span class="block text-xs text-muted mt-0.5">A grid of several photos</span>
          </button>
          <button type="button" class="rounded-xl border-2 border-ink p-3 text-left transition hover:-translate-y-0.5" style="background:#fff" data-add="button">
            <span class="block font-semibold text-sm">+ Button</span>
            <span class="block text-xs text-muted mt-0.5">A clickable link, e.g. to your website</span>
          </button>
          <button type="button" class="rounded-xl border-2 border-ink p-3 text-left transition hover:-translate-y-0.5" style="background:#fff" data-add="spacer">
            <span class="block font-semibold text-sm">+ Spacer</span>
            <span class="block text-xs text-muted mt-0.5">Blank space between sections</span>
          </button>
        </div>
        <input type="hidden" id="blocksInput" name="blocks">

        <!-- Honeypot: hidden from real visitors via CSS, invisible to screen
             readers via aria-hidden — a bot filling this out is the tell. -->
        <div style="position:absolute;left:-9999px;top:-9999px" aria-hidden="true">
          <label for="website_hp">Leave this field blank</label>
          <input type="text" id="website_hp" name="website_hp" tabindex="-1" autocomplete="off">
        </div>
        <button type="submit" id="submit-btn" class="btn btn-accent w-full justify-center mt-3">Submit</button>
      </form>
      <p id="status-msg" role="status" aria-live="polite" class="text-sm mt-4"></p>

      <div id="deleteSection" hidden class="mt-8 pt-6 text-center" style="border-top:1px solid var(--line)">
        <p id="deletePendingNotice" hidden class="text-sm" style="color:var(--coral-ink)">Your removal request is awaiting review — your page stays up until then.</p>
        <div id="deletePrompt">
          <p class="text-xs text-muted mb-2">Want your page taken down instead of edited?</p>
          <button type="button" id="requestDeleteBtn" class="btn btn-coral !py-1.5 !px-3 text-xs">Request removal</button>
        </div>
        <p id="delete-status" role="status" aria-live="polite" class="text-sm mt-2"></p>
      </div>
    </div>
  </div>
</section>
{% include "dialog.njk" %}

<div id="tourOverlay" style="position:fixed;inset:0;background:rgba(25,23,18,.85);z-index:310;display:none;align-items:center;justify-content:center;padding:1rem">
  <div class="card p-8" style="max-width:30rem;width:100%;">
    <div class="flex items-center gap-1.5 mb-5" id="tourDots"></div>
    <p class="eyebrow" style="color:var(--coral-ink)" id="tourStepLabel"></p>
    <h3 class="h-card mt-2" id="tourTitle" style="font-size:1.4rem"></h3>
    <p class="text-muted leading-relaxed mt-3" id="tourBody"></p>
    <div class="flex items-center justify-between mt-7">
      <button type="button" id="tourSkipBtn" class="text-sm text-muted underline">Skip tour</button>
      <div class="flex gap-2">
        <button type="button" id="tourBackBtn" class="btn !py-2 !px-3 text-sm">Back</button>
        <button type="button" id="tourNextBtn" class="btn btn-accent !py-2 !px-4 text-sm">Next</button>
      </div>
    </div>
  </div>
</div>

<div id="cropModalOverlay" style="position:fixed;inset:0;background:rgba(25,23,18,.85);z-index:300;display:none;align-items:center;justify-content:center;padding:1rem">
  <div style="background:#fff;border:2px solid var(--ink);border-radius:1rem;box-shadow:8px 8px 0 var(--ink);max-width:26rem;width:100%;padding:1.5rem;max-height:92vh;overflow-y:auto">
    <h3 class="h-card mb-1">Move and scale</h3>
    <p class="text-xs text-muted mb-3">Drag to reposition, pinch or use the slider to zoom — or skip straight to automatic face detection.</p>
    <div id="cropFrame" style="position:relative;width:100%;aspect-ratio:1/1;overflow:hidden;border-radius:1rem;background:#191712;cursor:grab;touch-action:none">
      <canvas id="cropCanvas" style="position:absolute;top:0;left:0;width:100%;height:100%"></canvas>
      <div style="position:absolute;inset:0;pointer-events:none;border-radius:50%;box-shadow:0 0 0 9999px rgba(25,23,18,.72);outline:2px solid rgba(255,255,255,.9)"></div>
    </div>
    <div class="flex items-center gap-3 mt-4">
      <span class="text-xs text-muted mono" aria-hidden="true">–</span>
      <input type="range" id="cropZoom" min="1" max="3" step="0.01" value="1" style="flex:1" aria-label="Zoom">
      <span class="text-xs text-muted mono" aria-hidden="true">+</span>
    </div>
    <div class="flex flex-wrap gap-2 mt-4">
      <button type="button" id="cropUseRecommendedBtn" class="btn btn-accent">✨ Use recommended (automatic face detection)</button>
      <button type="button" id="cropSaveBtn" class="btn">Save this crop</button>
      <button type="button" id="cropCancelBtn" class="btn btn-coral">Cancel</button>
    </div>
    <p id="cropStatus" role="status" aria-live="polite" class="text-xs mt-2 text-muted"></p>
  </div>
</div>

<script>
(function () {
  var mode = 'create';

  var pageHeading = document.getElementById('pageHeading');
  var codeCard = document.getElementById('codeCard');
  var codeForm = document.getElementById('code-form');
  var codeInput = document.getElementById('code');
  var codeBtn = document.getElementById('code-btn');
  var codeStatus = document.getElementById('code-status');
  var formCard = document.getElementById('formCard');
  var editionLabel = document.getElementById('editionLabel');
  var pendingEditNotice = document.getElementById('pendingEditNotice');
  var deleteSection = document.getElementById('deleteSection');
  var deletePendingNotice = document.getElementById('deletePendingNotice');
  var deletePrompt = document.getElementById('deletePrompt');
  var requestDeleteBtn = document.getElementById('requestDeleteBtn');
  var deleteStatus = document.getElementById('delete-status');
  var hiddenCode = document.getElementById('hiddenCode');
  var alumniForm = document.getElementById('alumni-form');

  // --- Block builder ---------------------------------------------------
  // `blocks` is the single source of truth for the ENTIRE page now,
  // including identity (matches functions/_lib/dotsBlocks.js's shape
  // exactly) -- name/photo/bio are required block types (pre-seeded,
  // not removable, but freely reorderable like everything else).
  var blocks = [];
  var blocksList = document.getElementById('blocksList');
  var blocksInput = document.getElementById('blocksInput');
  var dragIndex = null;
  var REQUIRED_TYPES = { name: true, bio: true };

  function uid() { return 'b' + Math.random().toString(36).slice(2, 10); }

  function newBlock(type) {
    if (type === 'name') return { id: uid(), type: type, text: '', pronouns: '' };
    if (type === 'photo') return { id: uid(), type: type, url: '' };
    if (type === 'bio') return { id: uid(), type: type, text: '' };
    if (type === 'quote') return { id: uid(), type: type, text: '' };
    if (type === 'subtitle') return { id: uid(), type: type, role: '', location: '' };
    if (type === 'links') return { id: uid(), type: type, instagram: '', linkedin: '', website: '' };
    if (type === 'heading') return { id: uid(), type: type, text: '' };
    if (type === 'paragraph') return { id: uid(), type: type, text: '' };
    if (type === 'image') return { id: uid(), type: type, url: '', caption: '' };
    if (type === 'gallery') return { id: uid(), type: type, images: [] };
    if (type === 'button') return { id: uid(), type: type, label: '', href: '' };
    if (type === 'spacer') return { id: uid(), type: type, height: 40 };
    return null;
  }

  function uploadBlockImage(file, onDone) {
    var fd = new FormData();
    fd.append('code', hiddenCode.value);
    fd.append('file', file);
    return fetch('/api/dots-alumni/upload-block-image', { method: 'POST', body: fd })
      .then(function (res) { return res.json().then(function (data) { return { ok: res.ok, data: data }; }); })
      .then(function (r) { onDone(r.ok ? r.data.url : null, r.ok ? null : (r.data && r.data.error)); })
      .catch(function () { onDone(null, 'Network error.'); });
  }

  // --- Crop / reposition modal ------------------------------------------
  // Every uploaded photo goes to R2 as-is first (uploadBlockImage above),
  // then this modal opens on that already-hosted URL so there's always a
  // real file to fall back to if the user cancels. Two ways out:
  // "recommended" just keeps that original URL untouched -- every photo
  // display on the site already runs it through Cloudflare's automatic
  // face-aware crop (functions/uploads/[[path]].js's ?face=1 transform,
  // via the faceCrop filter in templates), so "recommended" genuinely
  // means "let the system already built for this handle it," not a
  // placeholder. "Save this crop" renders the current pan/zoom to a fixed
  // frame and uploads THAT as a new, separate file -- the manual choice
  // takes precedence over automatic cropping from then on, since it's now
  // the only image faceCrop has to work with.
  (function () {
    var overlay = document.getElementById('cropModalOverlay');
    var frame = document.getElementById('cropFrame');
    var canvas = document.getElementById('cropCanvas');
    var ctx = canvas.getContext('2d');
    var zoomSlider = document.getElementById('cropZoom');
    var useRecommendedBtn = document.getElementById('cropUseRecommendedBtn');
    var saveBtn = document.getElementById('cropSaveBtn');
    var cancelBtn = document.getElementById('cropCancelBtn');
    var cropStatus = document.getElementById('cropStatus');

    var img = null, coverScale = 1, scale = 1, offsetX = 0, offsetY = 0;
    var activeOriginalUrl = null, activeOnDone = null;
    var OUT_W = 960, OUT_H = 960;

    // Pointer Events unify mouse + touch, so a plain single-pointer drag
    // (the old implementation) already worked on phones -- but WhatsApp's
    // actual feel comes from pinch-to-zoom, which needs BOTH active
    // touches tracked at once. `pointers` holds every currently-down
    // pointer by id; one active pointer means "pan", two means "pinch",
    // and lifting one finger during a pinch drops back to panning from
    // wherever that remaining finger already is (no jump).
    var pointers = {};
    var panFrom = null; // {x, y, offsetX, offsetY}
    var pinchFrom = null; // {dist, scale, } while two pointers are down

    function frameSize() {
      var rect = frame.getBoundingClientRect();
      return { w: rect.width, h: rect.height };
    }

    function minScale() { return coverScale; }
    function maxScale() { return coverScale * 3; }

    function clampOffsets() {
      var fs = frameSize();
      var iw = img.naturalWidth * scale, ih = img.naturalHeight * scale;
      offsetX = Math.min(0, Math.max(fs.w - iw, offsetX));
      offsetY = Math.min(0, Math.max(fs.h - ih, offsetY));
    }

    function draw() {
      var fs = frameSize();
      var dpr = window.devicePixelRatio || 1;
      canvas.width = fs.w * dpr;
      canvas.height = fs.h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, fs.w, fs.h);
      if (!img) return;
      ctx.drawImage(img, offsetX, offsetY, img.naturalWidth * scale, img.naturalHeight * scale);
    }

    function pointerDist(ids) {
      var a = pointers[ids[0]], b = pointers[ids[1]];
      return Math.hypot(a.x - b.x, a.y - b.y);
    }
    function pointerMid(ids) {
      var a = pointers[ids[0]], b = pointers[ids[1]];
      return { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
    }

    function setZoomFromScale() {
      zoomSlider.value = String(scale / coverScale);
    }

    frame.addEventListener('pointerdown', function (e) {
      if (!img) return;
      frame.setPointerCapture(e.pointerId);
      pointers[e.pointerId] = { x: e.clientX, y: e.clientY };
      var ids = Object.keys(pointers);
      if (ids.length === 1) {
        panFrom = { x: e.clientX, y: e.clientY, offsetX: offsetX, offsetY: offsetY };
        frame.style.cursor = 'grabbing';
      } else if (ids.length === 2) {
        panFrom = null;
        pinchFrom = { dist: pointerDist(ids), scale: scale };
      }
    });
    frame.addEventListener('pointermove', function (e) {
      if (!pointers[e.pointerId] || !img) return;
      pointers[e.pointerId] = { x: e.clientX, y: e.clientY };
      var ids = Object.keys(pointers);
      if (ids.length === 2 && pinchFrom) {
        var rect = frame.getBoundingClientRect();
        var mid = pointerMid(ids);
        var localX = mid.x - rect.left, localY = mid.y - rect.top;
        var newScale = Math.min(maxScale(), Math.max(minScale(), pinchFrom.scale * (pointerDist(ids) / pinchFrom.dist)));
        var ratio = newScale / scale;
        offsetX = localX - (localX - offsetX) * ratio;
        offsetY = localY - (localY - offsetY) * ratio;
        scale = newScale;
        setZoomFromScale();
        clampOffsets();
        draw();
      } else if (ids.length === 1 && panFrom) {
        offsetX = panFrom.offsetX + (e.clientX - panFrom.x);
        offsetY = panFrom.offsetY + (e.clientY - panFrom.y);
        clampOffsets();
        draw();
      }
    });
    function releasePointer(e) {
      delete pointers[e.pointerId];
      var ids = Object.keys(pointers);
      pinchFrom = null;
      if (ids.length === 1) {
        var p = pointers[ids[0]];
        panFrom = { x: p.x, y: p.y, offsetX: offsetX, offsetY: offsetY };
      } else {
        panFrom = null;
      }
      if (!ids.length) frame.style.cursor = 'grab';
    }
    ['pointerup', 'pointercancel', 'pointerleave'].forEach(function (evt) {
      frame.addEventListener(evt, releasePointer);
    });

    zoomSlider.addEventListener('input', function () {
      if (!img) return;
      var fs = frameSize();
      var cx = fs.w / 2, cy = fs.h / 2;
      var prevScale = scale;
      scale = coverScale * Number(zoomSlider.value);
      var ratio = scale / prevScale;
      offsetX = cx - (cx - offsetX) * ratio;
      offsetY = cy - (cy - offsetY) * ratio;
      clampOffsets();
      draw();
    });

    function loadImage(url) {
      cropStatus.textContent = '';
      cropStatus.style.color = '';
      img = null;
      var el = new Image();
      el.onload = function () {
        img = el;
        var fs = frameSize();
        coverScale = Math.max(fs.w / img.naturalWidth, fs.h / img.naturalHeight);
        scale = coverScale;
        zoomSlider.value = '1';
        offsetX = (fs.w - img.naturalWidth * scale) / 2;
        offsetY = (fs.h - img.naturalHeight * scale) / 2;
        draw();
      };
      el.onerror = function () {
        cropStatus.style.color = 'var(--coral-ink)';
        cropStatus.textContent = "Couldn't load that image for cropping — try again.";
      };
      el.src = url;
    }

    window.openCropModal = function (originalUrl, onDone) {
      activeOriginalUrl = originalUrl;
      activeOnDone = onDone;
      overlay.style.display = 'flex';
      loadImage(originalUrl);
    };

    function close() {
      overlay.style.display = 'none';
      img = null;
      activeOriginalUrl = null;
      activeOnDone = null;
    }

    cancelBtn.addEventListener('click', close);
    overlay.addEventListener('click', function (e) { if (e.target === overlay) close(); });

    useRecommendedBtn.addEventListener('click', function () {
      var onDone = activeOnDone;
      var url = activeOriginalUrl;
      close();
      if (onDone) onDone(url);
    });

    saveBtn.addEventListener('click', function () {
      if (!img) return;
      saveBtn.disabled = true;
      cropStatus.style.color = '';
      cropStatus.textContent = 'Saving your crop…';

      var out = document.createElement('canvas');
      out.width = OUT_W; out.height = OUT_H;
      var octx = out.getContext('2d');
      var fs = frameSize();
      var sx = OUT_W / fs.w, sy = OUT_H / fs.h;
      octx.drawImage(img, offsetX * sx, offsetY * sy, img.naturalWidth * scale * sx, img.naturalHeight * scale * sy);

      out.toBlob(function (blob) {
        if (!blob) {
          saveBtn.disabled = false;
          cropStatus.style.color = 'var(--coral-ink)';
          cropStatus.textContent = "Couldn't process that crop — try again.";
          return;
        }
        var file = new File([blob], 'cropped.jpg', { type: 'image/jpeg' });
        var onDone = activeOnDone;
        uploadBlockImage(file, function (url, err) {
          saveBtn.disabled = false;
          if (!url) {
            cropStatus.style.color = 'var(--coral-ink)';
            cropStatus.textContent = err || 'Upload failed — try again.';
            return;
          }
          close();
          if (onDone) onDone(url);
        });
      }, 'image/jpeg', 0.9);
    });
  })();

  // --- Guided tour -------------------------------------------------------
  // Shown automatically the first time someone reaches the form with a
  // fresh code (mode === 'create'); always re-openable via "Take the
  // tour" in either mode, since a returning participant editing months
  // later may want the refresher just as much as a first-timer does.
  (function () {
    var STEPS = [
      { label: 'Step 1 of 5', title: "This is your own page", body: "You're building your individual page for the DOTS alumni gallery. It's made of sections — called blocks — that you add, remove, and drag into any order, like building blocks for a mini website." },
      { label: 'Step 2 of 5', title: 'The essentials', body: 'Every page needs a Name and a Bio — required, since they show up on the gallery card and can\'t be removed. A Photo is recommended too, though it\'s optional if you\'d rather not add one.' },
      { label: 'Step 3 of 5', title: 'Make it yours', body: 'Add extra sections any time with the buttons below your page: a Quote, what you\'re up to and where you\'re based, social links, or free-form Text, Images, a Gallery, even a Button. All fully optional, add as many or as few as you like.' },
      { label: 'Step 4 of 5', title: 'Rearrange freely', body: 'Drag any section by its ⠿ handle to reorder it, or use the ↑ / ↓ buttons. Your page shows sections in exactly the order you arrange them here — including your name and photo.' },
      { label: 'Step 5 of 5', title: 'Submitting, and editing later', body: "When you submit, staff review it before it goes live — usually within a day or two. Your access code doesn't expire after that: come back to this same page any time to edit it, or ask for it to be removed." },
    ];
    var step = 0;
    var overlay = document.getElementById('tourOverlay');
    var dotsWrap = document.getElementById('tourDots');
    var stepLabel = document.getElementById('tourStepLabel');
    var titleEl = document.getElementById('tourTitle');
    var bodyEl = document.getElementById('tourBody');
    var backBtn = document.getElementById('tourBackBtn');
    var nextBtn = document.getElementById('tourNextBtn');
    var skipBtn = document.getElementById('tourSkipBtn');
    var takeTourBtn = document.getElementById('takeTourBtn');

    function renderStep() {
      var s = STEPS[step];
      stepLabel.textContent = s.label;
      titleEl.textContent = s.title;
      bodyEl.textContent = s.body;
      backBtn.style.visibility = step === 0 ? 'hidden' : 'visible';
      nextBtn.textContent = step === STEPS.length - 1 ? "Let's build it" : 'Next';
      dotsWrap.innerHTML = '';
      STEPS.forEach(function (_, i) {
        var dot = document.createElement('span');
        dot.style.cssText = 'width:.5rem;height:.5rem;border-radius:999px;display:inline-block;background:' + (i === step ? 'var(--coral)' : 'var(--line)');
        dotsWrap.appendChild(dot);
      });
    }

    window.openTour = function () {
      step = 0;
      renderStep();
      overlay.style.display = 'flex';
    };
    function closeTour() { overlay.style.display = 'none'; }

    nextBtn.addEventListener('click', function () {
      if (step === STEPS.length - 1) { closeTour(); return; }
      step++; renderStep();
    });
    backBtn.addEventListener('click', function () { if (step > 0) { step--; renderStep(); } });
    skipBtn.addEventListener('click', closeTour);
    overlay.addEventListener('click', function (e) { if (e.target === overlay) closeTour(); });
    takeTourBtn.addEventListener('click', function () { window.openTour(); });
  })();

  function blockLabel(type) {
    return {
      name: 'Name', photo: 'Photo', bio: 'Bio', quote: 'Quote', subtitle: "What & where", links: 'Links',
      heading: 'Heading', paragraph: 'Text', image: 'Image', gallery: 'Gallery', button: 'Button', spacer: 'Spacer',
    }[type] || type;
  }

  function renderBlocks() {
    blocksList.innerHTML = '';
    blocks.forEach(function (block, index) {
      var required = !!REQUIRED_TYPES[block.type];
      var card = document.createElement('div');
      card.className = 'rounded-xl border-2 p-4';
      card.style.background = required ? 'var(--paper-2)' : '#fff';
      card.style.borderColor = 'var(--ink)';
      card.draggable = true;
      card.dataset.index = String(index);

      card.addEventListener('dragstart', function () { dragIndex = index; card.style.opacity = '.5'; });
      card.addEventListener('dragend', function () { card.style.opacity = ''; });
      card.addEventListener('dragover', function (e) { e.preventDefault(); });
      card.addEventListener('drop', function (e) {
        e.preventDefault();
        if (dragIndex === null || dragIndex === index) return;
        var moved = blocks.splice(dragIndex, 1)[0];
        blocks.splice(index, 0, moved);
        dragIndex = null;
        renderBlocks();
      });

      var head = document.createElement('div');
      head.className = 'flex items-center justify-between mb-3';
      var tag = document.createElement('span');
      tag.className = 'tag';
      tag.textContent = '⠿ ' + blockLabel(block.type);
      if (required) tag.style.background = 'var(--sun)';
      head.appendChild(tag);

      var controls = document.createElement('div');
      controls.className = 'flex items-center gap-1';
      var upBtn = document.createElement('button');
      upBtn.type = 'button';
      upBtn.className = 'btn !py-1 !px-2 text-xs';
      upBtn.textContent = '↑';
      upBtn.disabled = index === 0;
      upBtn.addEventListener('click', function () {
        if (index === 0) return;
        blocks.splice(index - 1, 0, blocks.splice(index, 1)[0]);
        renderBlocks();
      });
      var downBtn = document.createElement('button');
      downBtn.type = 'button';
      downBtn.className = 'btn !py-1 !px-2 text-xs';
      downBtn.textContent = '↓';
      downBtn.disabled = index === blocks.length - 1;
      downBtn.addEventListener('click', function () {
        if (index === blocks.length - 1) return;
        blocks.splice(index + 1, 0, blocks.splice(index, 1)[0]);
        renderBlocks();
      });
      controls.appendChild(upBtn);
      controls.appendChild(downBtn);
      if (!required) {
        var removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'btn btn-coral !py-1 !px-2 text-xs';
        removeBtn.textContent = 'Remove';
        removeBtn.addEventListener('click', function () {
          blocks.splice(index, 1);
          renderBlocks();
        });
        controls.appendChild(removeBtn);
      } else {
        var reqLabel = document.createElement('span');
        reqLabel.className = 'text-xs text-muted';
        reqLabel.style.padding = '0 .4rem';
        reqLabel.textContent = 'Required';
        controls.appendChild(reqLabel);
      }
      head.appendChild(controls);
      card.appendChild(head);

      var body = document.createElement('div');
      body.className = 'flex flex-col gap-2';

      if (block.type === 'name') {
        var nameIn = document.createElement('input');
        nameIn.className = 'input';
        nameIn.type = 'text';
        nameIn.maxLength = 100;
        nameIn.placeholder = 'Your name';
        nameIn.value = block.text || '';
        nameIn.addEventListener('input', function () { block.text = nameIn.value; syncBlocksInput(); });
        var pronounsIn = document.createElement('input');
        pronounsIn.className = 'input';
        pronounsIn.type = 'text';
        pronounsIn.maxLength = 30;
        pronounsIn.placeholder = 'Pronouns (optional), e.g. she/her';
        pronounsIn.value = block.pronouns || '';
        pronounsIn.addEventListener('input', function () { block.pronouns = pronounsIn.value; syncBlocksInput(); });
        body.appendChild(nameIn);
        body.appendChild(pronounsIn);
      } else if (block.type === 'photo') {
        if (block.url) {
          var photoPrev = document.createElement('img');
          photoPrev.src = block.url;
          photoPrev.alt = '';
          photoPrev.style.cssText = 'max-height:8rem;border-radius:.5rem;border:2px solid var(--ink);object-fit:cover';
          body.appendChild(photoPrev);
        }
        var photoFileIn = document.createElement('input');
        photoFileIn.className = 'input';
        photoFileIn.type = 'file';
        photoFileIn.accept = 'image/jpeg,image/png,image/webp';
        var photoStatus = document.createElement('p');
        photoStatus.className = 'text-xs text-muted';
        photoStatus.textContent = block.url ? 'Choose a new file to replace your photo.' : 'Optional, but recommended. JPEG, PNG, or WebP — 5MB maximum.';
        photoFileIn.addEventListener('change', function () {
          if (!photoFileIn.files[0]) return;
          photoStatus.textContent = 'Uploading…';
          uploadBlockImage(photoFileIn.files[0], function (url, err) {
            if (!url) { photoStatus.style.color = 'var(--coral-ink)'; photoStatus.textContent = err || 'Upload failed.'; return; }
            photoStatus.textContent = '';
            window.openCropModal(url, function (finalUrl) {
              block.url = finalUrl;
              syncBlocksInput();
              renderBlocks();
            });
          });
        });
        body.appendChild(photoFileIn);
        body.appendChild(photoStatus);
      } else if (block.type === 'bio') {
        var bioIn = document.createElement('textarea');
        bioIn.className = 'input';
        bioIn.rows = 3;
        bioIn.maxLength = 600;
        bioIn.placeholder = 'A sentence or two — shown on the gallery card.';
        bioIn.value = block.text || '';
        bioIn.addEventListener('input', function () { block.text = bioIn.value; syncBlocksInput(); });
        body.appendChild(bioIn);
      } else if (block.type === 'quote') {
        var quoteIn = document.createElement('input');
        quoteIn.className = 'input';
        quoteIn.type = 'text';
        quoteIn.maxLength = 300;
        quoteIn.placeholder = 'A line of advice, a favourite memory — shown as a pull-quote.';
        quoteIn.value = block.text || '';
        quoteIn.addEventListener('input', function () { block.text = quoteIn.value; syncBlocksInput(); });
        body.appendChild(quoteIn);
      } else if (block.type === 'subtitle') {
        var roleIn = document.createElement('input');
        roleIn.className = 'input';
        roleIn.type = 'text';
        roleIn.maxLength = 120;
        roleIn.placeholder = "What you're up to now, e.g. Studying law in Warsaw";
        roleIn.value = block.role || '';
        roleIn.addEventListener('input', function () { block.role = roleIn.value; syncBlocksInput(); });
        var locIn = document.createElement('input');
        locIn.className = 'input';
        locIn.type = 'text';
        locIn.maxLength = 80;
        locIn.placeholder = 'Where you live now, e.g. Warsaw, Poland';
        locIn.value = block.location || '';
        locIn.addEventListener('input', function () { block.location = locIn.value; syncBlocksInput(); });
        body.appendChild(roleIn);
        body.appendChild(locIn);
      } else if (block.type === 'links') {
        var igIn = document.createElement('input');
        igIn.className = 'input';
        igIn.type = 'text';
        igIn.placeholder = 'Instagram, e.g. instagram.com/you';
        igIn.value = block.instagram || '';
        igIn.addEventListener('input', function () { block.instagram = igIn.value; syncBlocksInput(); });
        var liIn = document.createElement('input');
        liIn.className = 'input';
        liIn.type = 'text';
        liIn.placeholder = 'LinkedIn, e.g. linkedin.com/in/you';
        liIn.value = block.linkedin || '';
        liIn.addEventListener('input', function () { block.linkedin = liIn.value; syncBlocksInput(); });
        var webIn = document.createElement('input');
        webIn.className = 'input';
        webIn.type = 'text';
        webIn.placeholder = 'Website, e.g. your-site.com';
        webIn.value = block.website || '';
        webIn.addEventListener('input', function () { block.website = webIn.value; syncBlocksInput(); });
        body.appendChild(igIn);
        body.appendChild(liIn);
        body.appendChild(webIn);
      } else if (block.type === 'heading') {
        var hIn = document.createElement('input');
        hIn.className = 'input';
        hIn.type = 'text';
        hIn.maxLength = 200;
        hIn.placeholder = 'Section heading';
        hIn.value = block.text || '';
        hIn.addEventListener('input', function () { block.text = hIn.value; syncBlocksInput(); });
        body.appendChild(hIn);
      } else if (block.type === 'paragraph') {
        var pIn = document.createElement('textarea');
        pIn.className = 'input';
        pIn.rows = 4;
        pIn.maxLength = 4000;
        pIn.placeholder = 'Write as much as you like…';
        pIn.value = block.text || '';
        pIn.addEventListener('input', function () { block.text = pIn.value; syncBlocksInput(); });
        body.appendChild(pIn);
      } else if (block.type === 'image') {
        if (block.url) {
          var prevImg = document.createElement('img');
          prevImg.src = block.url;
          prevImg.alt = '';
          prevImg.style.cssText = 'max-height:8rem;border-radius:.5rem;border:2px solid var(--ink);object-fit:cover';
          body.appendChild(prevImg);
        }
        var fIn = document.createElement('input');
        fIn.className = 'input';
        fIn.type = 'file';
        fIn.accept = 'image/jpeg,image/png,image/webp';
        var upStatus = document.createElement('p');
        upStatus.className = 'text-xs text-muted';
        upStatus.textContent = block.url ? 'Choose a new file to replace this photo.' : '';
        fIn.addEventListener('change', function () {
          if (!fIn.files[0]) return;
          upStatus.textContent = 'Uploading…';
          uploadBlockImage(fIn.files[0], function (url, err) {
            if (!url) { upStatus.style.color = 'var(--coral-ink)'; upStatus.textContent = err || 'Upload failed.'; return; }
            upStatus.textContent = '';
            window.openCropModal(url, function (finalUrl) {
              block.url = finalUrl;
              syncBlocksInput();
              renderBlocks();
            });
          });
        });
        body.appendChild(fIn);
        body.appendChild(upStatus);
        var capIn = document.createElement('input');
        capIn.className = 'input';
        capIn.type = 'text';
        capIn.maxLength = 300;
        capIn.placeholder = 'Caption (optional)';
        capIn.value = block.caption || '';
        capIn.addEventListener('input', function () { block.caption = capIn.value; syncBlocksInput(); });
        body.appendChild(capIn);
      } else if (block.type === 'gallery') {
        if (block.images && block.images.length) {
          var grid = document.createElement('div');
          grid.className = 'flex flex-wrap gap-2';
          block.images.forEach(function (url, imgIdx) {
            var wrap = document.createElement('div');
            wrap.style.position = 'relative';
            var gImg = document.createElement('img');
            gImg.src = url;
            gImg.alt = '';
            gImg.style.cssText = 'width:4rem;height:4rem;border-radius:.5rem;object-fit:cover;border:2px solid var(--ink)';
            wrap.appendChild(gImg);
            var rmBtn = document.createElement('button');
            rmBtn.type = 'button';
            rmBtn.textContent = '×';
            rmBtn.title = 'Remove photo';
            rmBtn.style.cssText = 'position:absolute;top:-.4rem;right:-.4rem;width:1.25rem;height:1.25rem;border-radius:999px;background:var(--coral-ink);color:#fff;font-size:.75rem;line-height:1;border:none;cursor:pointer';
            rmBtn.addEventListener('click', function () {
              block.images.splice(imgIdx, 1);
              syncBlocksInput();
              renderBlocks();
            });
            wrap.appendChild(rmBtn);
            grid.appendChild(wrap);
          });
          body.appendChild(grid);
        }
        var gIn = document.createElement('input');
        gIn.className = 'input';
        gIn.type = 'file';
        gIn.accept = 'image/jpeg,image/png,image/webp';
        gIn.multiple = true;
        var gStatus = document.createElement('p');
        gStatus.className = 'text-xs text-muted';
        gStatus.textContent = 'Up to 12 photos.';
        gIn.addEventListener('change', function () {
          var files = Array.prototype.slice.call(gIn.files).slice(0, 12 - (block.images || []).length);
          if (!files.length) return;
          gStatus.textContent = 'Uploading…';
          var remaining = files.length;
          files.forEach(function (file) {
            uploadBlockImage(file, function (url) {
              if (url) { block.images = block.images || []; block.images.push(url); }
              remaining -= 1;
              if (remaining === 0) { syncBlocksInput(); renderBlocks(); }
            });
          });
        });
        body.appendChild(gIn);
        body.appendChild(gStatus);
      } else if (block.type === 'button') {
        var lblIn = document.createElement('input');
        lblIn.className = 'input';
        lblIn.type = 'text';
        lblIn.maxLength = 100;
        lblIn.placeholder = 'Button label, e.g. "Visit my website"';
        lblIn.value = block.label || '';
        lblIn.addEventListener('input', function () { block.label = lblIn.value; syncBlocksInput(); });
        var hrefIn = document.createElement('input');
        hrefIn.className = 'input mt-2';
        hrefIn.type = 'text';
        hrefIn.maxLength = 500;
        hrefIn.placeholder = 'Link (https://…)';
        hrefIn.value = block.href || '';
        hrefIn.addEventListener('input', function () { block.href = hrefIn.value; syncBlocksInput(); });
        body.appendChild(lblIn);
        body.appendChild(hrefIn);
      } else if (block.type === 'spacer') {
        var hgtIn = document.createElement('input');
        hgtIn.className = 'input';
        hgtIn.type = 'number';
        hgtIn.min = 0;
        hgtIn.max = 300;
        hgtIn.value = block.height || 40;
        hgtIn.addEventListener('input', function () { block.height = Number(hgtIn.value) || 0; syncBlocksInput(); });
        var hgtLbl = document.createElement('p');
        hgtLbl.className = 'text-xs text-muted';
        hgtLbl.textContent = 'Blank space height, in pixels.';
        body.appendChild(hgtIn);
        body.appendChild(hgtLbl);
      }

      card.appendChild(body);
      blocksList.appendChild(card);
    });
    syncBlocksInput();
  }

  function syncBlocksInput() {
    blocksInput.value = JSON.stringify(blocks);
  }

  document.querySelectorAll('[data-add]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var b = newBlock(btn.getAttribute('data-add'));
      if (b) { blocks.push(b); renderBlocks(); }
    });
  });

  // --- Prefill / migration ----------------------------------------------
  // Builds the unified block list an existing entry should start from.
  // If it was already created/edited under this system, `current.blocks`
  // already has a 'name' block and is used as-is. Otherwise (an entry
  // that predates the unified builder) this synthesizes the equivalent
  // blocks from the old flat fields, so opening the edit form is itself
  // the migration -- nothing is lost, nothing needs a separate one-time
  // script.
  function isUnified(list) {
    return Array.isArray(list) && list.some(function (b) { return b.type === 'name'; });
  }

  function buildBlocksFromCurrent(current) {
    if (isUnified(current.blocks)) {
      return current.blocks.map(function (b) { return Object.assign({}, b); });
    }
    var out = [
      { id: uid(), type: 'name', text: current.name || '', pronouns: current.pronouns || '' },
      { id: uid(), type: 'photo', url: current.photoUrl || '' },
      { id: uid(), type: 'bio', text: current.bio || '' },
    ];
    if (current.currentRole || current.location) {
      out.push({ id: uid(), type: 'subtitle', role: current.currentRole || '', location: current.location || '' });
    }
    if (current.quote) out.push({ id: uid(), type: 'quote', text: current.quote });
    if (current.links && current.links.length) {
      var lb = { id: uid(), type: 'links', instagram: '', linkedin: '', website: '' };
      current.links.forEach(function (l) {
        if (l.label === 'Instagram') lb.instagram = l.url || '';
        if (l.label === 'LinkedIn') lb.linkedin = l.url || '';
        if (l.label === 'Website') lb.website = l.url || '';
      });
      out.push(lb);
    }
    if (current.story) out.push({ id: uid(), type: 'paragraph', text: current.story });
    if (current.photos && current.photos.length) out.push({ id: uid(), type: 'gallery', images: current.photos.slice() });
    if (current.blocks && current.blocks.length) out.push.apply(out, current.blocks.map(function (b) { return Object.assign({}, b); }));
    return out;
  }

  function checkCode(code) {
    codeBtn.disabled = true;
    codeStatus.style.color = 'unset';
    codeStatus.textContent = 'Checking…';

    fetch('/api/dots-alumni/check-code', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ code: code }),
    }).then(function (res) { return res.json(); }).then(function (data) {
      codeBtn.disabled = false;
      if (!data.valid) {
        codeStatus.style.color = 'var(--coral-ink)';
        codeStatus.textContent = data.error || 'That code is not valid.';
        return;
      }
      hiddenCode.value = code;
      mode = data.mode || 'create';
      if (mode === 'edit') {
        pageHeading.textContent = 'Edit your page';
        editionLabel.textContent = 'Changes are reviewed before they go live, so your current page stays up until then.';
        document.getElementById('submit-btn').textContent = 'Propose changes';
        pendingEditNotice.hidden = !data.hasPendingEdit;
        if (data.current) {
          blocks = buildBlocksFromCurrent(data.current);
          renderBlocks();
        }
        deleteSection.hidden = false;
        deletePendingNotice.hidden = !data.hasPendingDeletion;
        deletePrompt.hidden = !!data.hasPendingDeletion;
      } else {
        blocks = [newBlock('name'), newBlock('photo'), newBlock('bio')];
        renderBlocks();
      }
      codeCard.hidden = true;
      formCard.hidden = false;
      if (mode === 'create' && window.openTour) window.openTour();
    }).catch(function () {
      codeBtn.disabled = false;
      codeStatus.style.color = 'var(--coral-ink)';
      codeStatus.textContent = 'Network error. Please try again.';
    });
  }

  codeForm.addEventListener('submit', function (e) {
    e.preventDefault();
    checkCode(codeInput.value.trim().toUpperCase());
  });

  // Convenience: a shared link like /dots/alumni/submit/?code=ABCD1234
  // jumps straight to checking the code.
  var prefill = new URLSearchParams(location.search).get('code');
  if (prefill) {
    codeInput.value = prefill.toUpperCase();
    checkCode(prefill.toUpperCase());
  }

  // --- Submission ------------------------------------------------------
  alumniForm.addEventListener('submit', function (e) {
    e.preventDefault();

    var missing = [];
    var hasName = blocks.some(function (b) { return b.type === 'name' && b.text && b.text.trim(); });
    var hasBio = blocks.some(function (b) { return b.type === 'bio' && b.text && b.text.trim(); });
    if (!hasName) missing.push('a name');
    if (!hasBio) missing.push('a bio');

    var form = e.target;
    var statusMsg = document.getElementById('status-msg');
    var submitBtn = document.getElementById('submit-btn');

    if (missing.length) {
      statusMsg.style.color = 'var(--coral-ink)';
      statusMsg.textContent = 'Your page needs ' + missing.join(', ') + ' before you can submit.';
      return;
    }

    statusMsg.style.color = 'unset';
    statusMsg.textContent = mode === 'edit' ? 'Submitting your changes…' : 'Submitting…';
    submitBtn.disabled = true;

    var endpoint = mode === 'edit' ? '/api/dots-alumni/propose-edit' : '/api/dots-alumni/submit';

    fetch(endpoint, {
      method: 'POST',
      body: new FormData(form),
    }).then(function (res) {
      return res.json().then(function (data) { return { ok: res.ok, data: data }; });
    }).then(function (r) {
      submitBtn.disabled = false;
      if (!r.ok) {
        statusMsg.style.color = 'var(--coral-ink)';
        statusMsg.textContent = (r.data && r.data.error) || 'Something went wrong. Please try again.';
        return;
      }
      form.hidden = true;
      statusMsg.style.color = 'var(--mint-ink)';
      statusMsg.textContent = mode === 'edit'
        ? 'Thanks! Your changes are in for review — your live page stays as it is until they’re approved.'
        : 'Thanks! Your submission is in for review and will appear on the alumni page once approved.';
    }).catch(function () {
      submitBtn.disabled = false;
      statusMsg.style.color = 'var(--coral-ink)';
      statusMsg.textContent = 'Network error. Please try again.';
    });
  });

  requestDeleteBtn.addEventListener('click', function () {
    confirmDialog(
      'Ask staff to remove your page? This asks for review, same as an edit — your page stays live until they approve it.',
      'Request removal',
    ).then(function (ok) {
      if (!ok) return;
      requestDeleteBtn.disabled = true;
      deleteStatus.style.color = '';
      deleteStatus.textContent = 'Sending…';
      fetch('/api/dots-alumni/request-deletion', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code: hiddenCode.value }),
      }).then(function (res) {
        return res.json().then(function (data) { return { ok: res.ok, data: data }; });
      }).then(function (r) {
        requestDeleteBtn.disabled = false;
        if (!r.ok) {
          deleteStatus.style.color = 'var(--coral-ink)';
          deleteStatus.textContent = (r.data && r.data.error) || 'Something went wrong.';
          return;
        }
        deleteStatus.textContent = '';
        deletePendingNotice.hidden = false;
        deletePrompt.hidden = true;
      }).catch(function () {
        requestDeleteBtn.disabled = false;
        deleteStatus.style.color = 'var(--coral-ink)';
        deleteStatus.textContent = 'Network error. Please try again.';
      });
    });
  });
})();
</script>
