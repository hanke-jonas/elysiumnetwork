---
layout: portal-base.njk
title: "Elysium+ Cloud"
permalink: /portal/
---
<div id="filesContent" class="hidden">
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div>
      <p class="eyebrow" style="color:var(--coral-ink)">Elysium+ Cloud</p>
      <h1 class="h-sec mt-1">My files</h1>
    </div>
    <div class="flex gap-2">
      <button id="newFolderBtn" type="button" class="btn">{% icon "plus", "w-4 h-4" %} New folder</button>
      <button id="uploadBtn" type="button" class="btn btn-accent">{% icon "box", "w-4 h-4" %} Upload</button>
    </div>
  </div>

  <nav id="breadcrumb" class="mono text-xs text-muted uppercase tracking-wider mb-4"></nav>

  <input type="file" id="fileInput" multiple style="display:none">

  <div id="dropzone" class="rounded-2xl border-2 border-dashed p-4 mb-6 text-center text-sm text-muted transition" style="background:var(--paper-2);border-color:rgba(25,23,18,.3)">
    Drag files here, or use "Upload" above — 90MB max per file
  </div>

  <p id="status" role="status" aria-live="polite" class="text-sm mb-4"></p>

  <div id="bulkBar" class="hidden items-center gap-3 rounded-xl border-2 border-ink px-4 py-2.5 mb-4" style="background:var(--paper-2)">
    <span id="bulkCount" class="text-sm font-semibold"></span>
    <button type="button" id="bulkDeleteBtn" class="btn !py-1.5 !px-3 text-xs">Delete selected</button>
    <button type="button" id="bulkClearBtn" class="btn !py-1.5 !px-3 text-xs">Clear selection</button>
  </div>

  <div id="grid" class="grid gap-4" style="grid-template-columns:repeat(auto-fill,minmax(150px,1fr))"></div>
</div>

<script>
(function () {
  var content = document.getElementById('filesContent');

  fetch('/api/auth/me', { credentials: 'include' }).then(function (r) { return r.json(); }).then(function (data) {
    if (!data.signedIn || (data.type !== 'public' && data.type !== 'staff')) {
      location.href = '/portal/login/';
      return;
    }
    init();
  });

  function accountFetch(url, opts) {
    opts = opts || {};
    opts.credentials = 'include';
    opts.headers = opts.body instanceof FormData ? (opts.headers || {}) : Object.assign({ 'Content-Type': 'application/json' }, opts.headers || {});
    return fetch(url, opts).then(function (res) {
      return res.json().then(function (data) { return { ok: res.ok, status: res.status, data: data }; });
    });
  }

  function init() {
    content.classList.remove('hidden');

    var grid = document.getElementById('grid');
    var breadcrumb = document.getElementById('breadcrumb');
    var status = document.getElementById('status');
    var dropzone = document.getElementById('dropzone');
    var fileInput = document.getElementById('fileInput');
    var bulkBar = document.getElementById('bulkBar');
    var bulkCount = document.getElementById('bulkCount');
    var prefix = '';

    function setStatus(msg, isError) {
      status.textContent = msg || '';
      status.style.color = isError ? 'var(--coral-ink)' : '';
    }

    function humanSize(bytes) {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return Math.round(bytes / 1024) + ' KB';
      return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
    }

    function isImage(name) { return /\.(jpe?g|png|webp|gif)$/i.test(name); }

    function escapeHtml(s) {
      return String(s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function renderBreadcrumb() {
      var parts = prefix ? prefix.replace(/\/$/, '').split('/') : [];
      var html = '<a href="#" data-nav="" class="hover:underline">My files</a>';
      var acc = '';
      parts.forEach(function (part) {
        acc += part + '/';
        html += ' <span class="mx-1 opacity-40">/</span> <a href="#" data-nav="' + acc + '" class="hover:underline">' + part + '</a>';
      });
      breadcrumb.innerHTML = html;
      breadcrumb.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function (e) { e.preventDefault(); load(a.getAttribute('data-nav')); });
      });
    }

    function copyToClipboard(text, btn) {
      navigator.clipboard.writeText(location.origin + text).then(function () {
        var orig = btn.textContent;
        btn.textContent = 'Copied!';
        setTimeout(function () { btn.textContent = orig; }, 1200);
      });
    }

    function markedKeys() {
      return Array.prototype.slice.call(grid.querySelectorAll('.mark-check:checked')).map(function (cb) { return cb.getAttribute('data-key'); });
    }
    function updateBulkBar() {
      var n = markedKeys().length;
      bulkBar.classList.toggle('hidden', n === 0);
      bulkBar.classList.toggle('flex', n > 0);
      bulkCount.textContent = n + ' marked';
    }

    function render(data) {
      grid.innerHTML = '';

      data.folders.forEach(function (name) {
        var card = document.createElement('div');
        card.className = 'card p-4';
        card.innerHTML =
          '<button type="button" class="text-left w-full folder-open" style="cursor:pointer">' +
            '<div class="text-3xl mb-2">📁</div><p class="font-semibold text-sm truncate">' + escapeHtml(name) + '</p>' +
          '</button>' +
          '<button type="button" class="btn !py-1 !px-2 text-xs mt-2 w-full folder-delete" data-folder="' + escapeHtml(name) + '">Delete folder</button>';
        card.querySelector('.folder-open').addEventListener('click', function () { load(prefix + name + '/'); });
        card.querySelector('.folder-delete').addEventListener('click', function () {
          if (!confirm('Delete "' + name + '" and everything inside it? This cannot be undone.')) return;
          accountFetch('/api/account/media', { method: 'POST', body: JSON.stringify({ action: 'delete-folder', prefix: prefix + name + '/' }) })
            .then(function (res) {
              if (!res.ok) { setStatus(res.data.error || 'Could not delete folder', true); return; }
              load(prefix);
            });
        });
        grid.appendChild(card);
      });

      data.files.forEach(function (f) {
        var card = document.createElement('div');
        card.className = 'card p-3 flex flex-col gap-2 relative';
        var preview = isImage(f.name)
          ? '<img src="' + f.url + '" alt="" class="w-full h-24 object-cover rounded-lg border-2 border-ink">'
          : '<div class="w-full h-24 grid place-items-center rounded-lg border-2 border-ink text-3xl" style="background:var(--paper-2)">📄</div>';
        card.innerHTML =
          '<input type="checkbox" class="mark-check absolute top-2 left-2 z-10 w-5 h-5" data-key="' + f.key + '" aria-label="Mark ' + escapeHtml(f.name) + '">' +
          preview +
          '<p class="text-xs font-semibold truncate" title="' + escapeHtml(f.name) + '">' + escapeHtml(f.name) + '</p>' +
          '<p class="text-[11px] text-muted">' + humanSize(f.size) + '</p>' +
          '<div class="flex gap-1.5">' +
            '<button type="button" class="btn !py-1 !px-2 text-xs flex-1" data-copy="' + f.url + '">Copy URL</button>' +
            '<button type="button" class="btn !py-1 !px-2 text-xs" data-del="' + f.key + '" aria-label="Delete">🗑</button>' +
          '</div>';
        grid.appendChild(card);
      });

      grid.querySelectorAll('[data-copy]').forEach(function (btn) {
        btn.addEventListener('click', function () { copyToClipboard(btn.getAttribute('data-copy'), btn); });
      });
      grid.querySelectorAll('[data-del]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          if (!confirm('Delete this file? This cannot be undone.')) return;
          accountFetch('/api/account/media', { method: 'POST', body: JSON.stringify({ action: 'delete', key: btn.getAttribute('data-del') }) })
            .then(function () { load(prefix); });
        });
      });
      grid.querySelectorAll('.mark-check').forEach(function (cb) { cb.addEventListener('change', updateBulkBar); });

      if (!data.folders.length && !data.files.length) {
        grid.innerHTML = '<p class="text-muted text-sm col-span-full">Nothing here yet.</p>';
      }
      updateBulkBar();
    }

    function load(newPrefix) {
      prefix = newPrefix || '';
      setStatus('Loading…');
      accountFetch('/api/account/media?prefix=' + encodeURIComponent(prefix)).then(function (res) {
        if (!res.ok) { setStatus(res.data.error || 'Failed to load', true); return; }
        setStatus('');
        renderBreadcrumb();
        render(res.data);
      });
    }

    document.getElementById('newFolderBtn').addEventListener('click', function () {
      var name = prompt('Folder name:');
      if (!name) return;
      accountFetch('/api/account/media', { method: 'POST', body: JSON.stringify({ action: 'create-folder', prefix: prefix, name: name }) })
        .then(function (res) {
          if (!res.ok) { setStatus(res.data.error || 'Could not create folder', true); return; }
          load(prefix);
        });
    });

    document.getElementById('bulkClearBtn').addEventListener('click', function () {
      grid.querySelectorAll('.mark-check:checked').forEach(function (cb) { cb.checked = false; });
      updateBulkBar();
    });
    document.getElementById('bulkDeleteBtn').addEventListener('click', function () {
      var keys = markedKeys();
      if (!keys.length) return;
      if (!confirm('Delete ' + keys.length + ' marked file(s)? This cannot be undone.')) return;
      accountFetch('/api/account/media', { method: 'POST', body: JSON.stringify({ action: 'delete-many', keys: keys }) })
        .then(function () { load(prefix); });
    });

    function uploadFiles(fileList) {
      var files = Array.prototype.slice.call(fileList);
      if (!files.length) return;
      setStatus('Uploading ' + files.length + ' file' + (files.length > 1 ? 's' : '') + '…');
      Promise.all(files.map(function (file) {
        var fd = new FormData();
        fd.append('file', file);
        fd.append('folder', prefix);
        return accountFetch('/api/account/media/upload', { method: 'POST', body: fd });
      })).then(function (results) {
        var failed = results.filter(function (r) { return !r.ok; });
        setStatus(failed.length ? (failed.length + ' file(s) failed to upload — check file type/size') : 'Done.', !!failed.length);
        load(prefix);
      });
    }

    document.getElementById('uploadBtn').addEventListener('click', function () { fileInput.click(); });
    fileInput.addEventListener('change', function () { uploadFiles(fileInput.files); fileInput.value = ''; });
    dropzone.addEventListener('dragover', function (e) { e.preventDefault(); dropzone.style.borderColor = 'var(--blue-ink)'; });
    dropzone.addEventListener('dragleave', function () { dropzone.style.borderColor = 'rgba(25,23,18,.3)'; });
    dropzone.addEventListener('drop', function (e) {
      e.preventDefault();
      dropzone.style.borderColor = 'rgba(25,23,18,.3)';
      uploadFiles(e.dataTransfer.files);
    });

    load('');
  }
})();
</script>
