---
layout: base.njk
title: Elysium+ — European youth network
description: Elysium+ is a European youth network rooted in Ukraine, moving young people across Ukraine, Poland, Italy and Germany through funded exchanges, training and non-formal education.
permalink: /
---
<section class="relative overflow-hidden border-b-2 border-ink">
  <div class="max-w-[1400px] mx-auto px-5 sm:px-8 pt-14 sm:pt-20 pb-14 grid lg:grid-cols-12 gap-8 items-center">
    <div class="lg:col-span-8">
      <div class="flex flex-wrap gap-2.5">
        <div class="stamp" style="border-color:var(--coral);color:var(--coral)">est. {{ site.founded_year }} · Chernihiv, Ukraine</div>
        {% for br in site.branches %}{% if br.slug == 'ukraine' and br.esc %}
        <a href="{{ br.esc.url }}" target="_blank" rel="noopener" class="stamp" style="border-color:var(--mint);color:var(--mint-ink)">Accredited ESC {{ br.esc.role }}</a>
        {% endif %}{% endfor %}
      </div>
      <h1 class="h-hero mt-6">Young people move.<br>Europe <mark>changes.</mark></h1>
      <p class="mt-7 text-lg sm:text-xl text-muted max-w-xl leading-relaxed">Elysium+ sends young people across Ukraine, Poland, Italy and Germany through fully funded exchanges, training and non-formal education — built on inclusion, democracy and solidarity.</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="{{ site.join_form }}" class="btn btn-accent magnetic">Join a project {% icon "arrow-ur", "w-4 h-4" %}</a>
        <a href="/calls/" class="btn magnetic">See active calls {% icon "arrow", "w-4 h-4" %}</a>
      </div>
    </div>
    <div class="lg:col-span-4 flex justify-center" id="heroParallax">
      <div class="relative">
        <img src="{{ site.logo_hero }}" alt="Elysium+" width="320" height="320" class="w-48 sm:w-64 drop-shadow-[6px_10px_0_rgba(25,23,18,.15)]" id="heroHeart" style="transform:rotate(-4deg)">
        <span class="font-hand text-2xl absolute -bottom-3 -right-2 rotate-6" style="color:var(--coral)">that's us! ↴</span>
      </div>
    </div>
  </div>

  <div class="border-t-2 border-ink bg-ink">
    <div class="max-w-[1400px] mx-auto px-5 sm:px-8 grid grid-cols-3 divide-x-2 divide-white/15">
      {% set stats = [[site.branches.length | string, "countries, one network", "globe"],["20+","Erasmus+ projects joined","compass"],["2020","founded as a school initiative","spark"]] %}
      {% set spal = ["var(--blue)","var(--coral)","var(--sun)"] %}
      {% for s in stats %}
      <div class="px-5 sm:px-8 py-8 sm:py-9 reveal reveal-d{{ loop.index }}">
        <div class="w-9 h-9 rounded-lg grid place-items-center border-2 border-paper/25 mb-3" style="color:{{ spal[loop.index0] }}">{% icon s[2], "w-4.5 h-4.5" %}</div>
        <p class="num count-up text-4xl sm:text-5xl font-bold" style="color:{{ spal[loop.index0] }}">{{ s[0] }}</p>
        <p class="mt-1.5 text-xs sm:text-sm text-paper/70 leading-snug">{{ s[1] }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<div class="border-b-2 border-ink py-3 select-none" style="background:var(--sun)">
  <div class="marquee">
    <div class="marquee-track mono text-sm font-bold uppercase tracking-wider text-ink">
      {% set ticks = ["Chernihiv 51.50°N","Mińsk Mazowiecki 52.18°N","San Pietro Val Lemina 44.92°N","Leipzig 51.34°N","Erasmus+","DiscoverEU","Non-formal education","Youth mobility","Inclusion","Solidarity"] %}
      {% for r in range(0, 2) %}{% for t in ticks %}<span class="px-6 inline-flex items-center gap-6">{{ t }}<span class="opacity-50 tick-heart">♥</span></span>{% endfor %}{% endfor %}
    </div>
  </div>
</div>

{% include "globe.njk" %}

<section class="bg-paper border-b-2 border-ink">
  <div class="max-w-[1400px] mx-auto px-5 sm:px-8 py-20 sm:py-24 grid md:grid-cols-2 gap-6">
    <div class="card p-8 sm:p-10 reveal">
      <span class="tape left"></span>
      <h2 class="eyebrow" style="color:var(--coral-ink)">01 · Mission</h2>
      <p class="mt-4 text-xl leading-relaxed font-medium">{{ site.mission }}</p>
    </div>
    <div class="card p-8 sm:p-10 reveal reveal-d1">
      <span class="tape right"></span>
      <h2 class="eyebrow" style="color:var(--blue-ink)">02 · Vision</h2>
      <p class="mt-4 text-xl leading-relaxed">{{ site.vision }}</p>
    </div>
  </div>
</section>

<section class="bg-paper-2 border-b-2 border-ink">
  <div class="max-w-[1400px] mx-auto px-5 sm:px-8 py-20 sm:py-24">
    <div class="flex flex-wrap items-end justify-between gap-4 reveal">
      <div class="max-w-2xl">
        <p class="eyebrow" style="color:var(--coral-ink)">What we do</p>
        <h2 class="h-sec mt-3">Learning that happens by doing</h2>
      </div>
      <div class="flex items-center gap-2">
        <button type="button" id="themesPrev" class="carousel-arrow" aria-label="Previous">{% icon "arrow", "w-4 h-4 rotate-180" %}</button>
        <button type="button" id="themesNext" class="carousel-arrow" aria-label="Next">{% icon "arrow", "w-4 h-4" %}</button>
      </div>
    </div>
    <div class="mt-12 carousel-track" id="themesTrack">
      {% set palette = ["var(--blue)","var(--coral)","var(--sun)","var(--mint)","var(--plum)","var(--blue)"] %}
      {% set rot = ["-1.5deg","1deg","-.5deg","1.5deg","-1deg",".5deg"] %}
      {% for t in site.themes %}
      <button type="button" class="card p-6 carousel-item text-left detail-trigger" style="transform:rotate({{ rot[loop.index0] }})" data-detail-title="{{ t.title }}" data-detail-body="{{ t.detail }}" data-detail-accent="{{ palette[loop.index0] }}" data-detail-cta-href="/calls/" data-detail-cta-label="See active calls">
        <div class="w-11 h-11 rounded-lg grid place-items-center border-2 border-ink mb-4" style="background:{{ palette[loop.index0] }}">{% icon t.icon, "w-5 h-5" %}</div>
        <h3 class="h-card">{{ t.title }}</h3>
        <p class="mt-2 text-muted leading-relaxed">{{ t.text }}</p>
        <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-bold opacity-60">Learn more {% icon "arrow-ur", "w-3.5 h-3.5" %}</span>
      </button>
      {% endfor %}
    </div>
  </div>
</section>

<script>
  (function(){
    var track = document.getElementById('themesTrack');
    var prev = document.getElementById('themesPrev');
    var next = document.getElementById('themesNext');
    if (!track || !prev || !next) return;

    function step(){
      var first = track.querySelector('.carousel-item');
      if (!first) return track.clientWidth;
      var gap = parseFloat(getComputedStyle(track).columnGap || 24);
      return first.getBoundingClientRect().width + gap;
    }
    // A few px of slack rather than an exact equality check, since fractional
    // scroll positions (common with sub-pixel layout) would otherwise miss
    // the "already at the end" case entirely.
    function atEnd(){ return track.scrollLeft + track.clientWidth >= track.scrollWidth - 4; }
    function atStart(){ return track.scrollLeft <= 4; }

    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function goTo(target){
      target = Math.max(0, Math.min(target, track.scrollWidth - track.clientWidth));
      track.scrollTo({ left: target, behavior: reduceMotion ? 'instant' : 'smooth' });
    }

    next.addEventListener('click', function(){
      goTo(atEnd() ? 0 : track.scrollLeft + step());
    });
    prev.addEventListener('click', function(){
      goTo(atStart() ? track.scrollWidth : track.scrollLeft - step());
    });
  })();
</script>

<section class="bg-paper border-b-2 border-ink">
  <div class="max-w-[1400px] mx-auto px-5 sm:px-8 py-20 sm:py-24">
    <div class="flex flex-wrap items-end justify-between gap-4 reveal">
      <div class="max-w-xl"><p class="eyebrow" style="color:var(--coral-ink)">What we stand for</p><h2 class="h-sec mt-3">The principles behind the work</h2></div>
      <a href="/standards/" class="btn">Read our full standards {% icon "arrow", "w-4 h-4" %}</a>
    </div>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {# "Freedom & equality" (always the first entry) is fixed to plum rather
         than following the color-cycle — plum is this site's consistent
         marker for equality/gender-equity specifically, cutting across
         whichever position a value happens to render in. #}
      {% set vpal = ["var(--plum)","var(--blue)","var(--sun)","var(--mint)"] %}
      {% for v in site.values_short %}
      <button type="button" class="card p-6 reveal reveal-d{{ loop.index }} w-full text-left detail-trigger relative" data-detail-title="{{ v[0] }}" data-detail-body="{{ v[2] }}" data-detail-accent="{{ vpal[loop.index0] }}" data-detail-cta-href="/standards/" data-detail-cta-label="Read our full standards">
        {% if loop.index0 == 0 %}
        <span class="absolute top-4 right-4 w-7 h-7 rounded-full border-2 border-ink grid place-items-center" style="background:var(--plum)" title="equality, always">{% icon "venus", "w-4 h-4" %}</span>
        {% endif %}
        <span class="block w-8 h-1.5 rounded-full mb-4 border border-ink" style="background:{{ vpal[loop.index0] }}"></span>
        <h3 class="h-card">{{ v[0] }}</h3>
        <p class="mt-2 text-muted leading-relaxed">{{ v[1] }}</p>
        <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-bold opacity-60">Learn more {% icon "arrow-ur", "w-3.5 h-3.5" %}</span>
        {% if loop.index0 == 0 %}
        <span class="font-hand text-lg absolute -bottom-2 -right-1 rotate-6 pointer-events-none" style="color:var(--plum-ink)">no exceptions.</span>
        {% endif %}
      </button>
      {% endfor %}
    </div>
  </div>
</section>

<section class="bg-paper-2 border-b-2 border-ink">
  <div class="max-w-[1400px] mx-auto px-5 sm:px-8 py-20 sm:py-24 space-y-6">
    {% set featured = calls | firstOpenOrFirst %}
    {% set otherCalls = [] %}
    {% for c in calls %}{% if featured and c.status != 'closed' and c.id != featured.id %}{% set otherCalls = otherCalls.concat([c]) %}{% endif %}{% endfor %}
    {% if featured %}
    <div class="card !rounded-2xl overflow-hidden relative reveal">
      <div class="p-8 sm:p-12 grid lg:grid-cols-3 gap-8 items-center">
        <div class="lg:col-span-2">
          <p class="eyebrow" style="color:var(--coral-ink)">{% if featured.status == 'open' %}Open now{% else %}Featured project{% endif %}</p>
          <h2 class="h-sec mt-4">{{ featured.title }}</h2>
          <p class="mt-4 text-muted text-lg leading-relaxed max-w-2xl">{{ featured.summary }}</p>
        </div>
        <div class="lg:justify-self-end"><a href="/calls/" class="btn btn-accent w-full lg:w-auto justify-center">See active calls {% icon "arrow", "w-4 h-4" %}</a></div>
      </div>
    </div>
    {% endif %}
    {% if otherCalls.length > 0 %}
    <div class="grid gap-5 sm:grid-cols-2">
      {% set opal = ["var(--blue)","var(--mint)","var(--plum)"] %}
      {% for c in otherCalls %}
      <a href="/calls/" class="card p-6 block reveal reveal-d{{ loop.index }}">
        <span class="tag" style="background:{{ opal[loop.index0 % opal.length] }}">{% if c.status == 'coming_up' %}Coming up{% else %}{{ c.status }}{% endif %}</span>
        <h3 class="h-card mt-3">{{ c.title }}</h3>
        <p class="mt-2 text-sm text-muted leading-relaxed">{{ c.deadline }}</p>
      </a>
      {% endfor %}
    </div>
    {% endif %}
    {% include "opportunity-portal-promo.njk" %}
  </div>
</section>

<section class="bg-paper pb-20 sm:pb-24 pt-4">
  <div class="max-w-[1400px] mx-auto px-5 sm:px-8">
    <div class="rounded-2xl p-10 sm:p-16 text-center reveal border-2 border-ink" style="background:var(--blue);box-shadow:8px 8px 0 var(--ink)">
      <h2 class="h-sec">Be part of the change</h2>
      <p class="mt-4 text-ink/85 text-lg max-w-2xl mx-auto leading-relaxed">Join a project, volunteer your skills, or support our work. There's a place for you in Elysium+.</p>
      <div class="mt-8 flex flex-wrap gap-3 justify-center">
        <a href="{{ site.join_form }}" class="btn btn-ink magnetic">Join Us {% icon "arrow-ur", "w-4 h-4" %}</a>
        <a href="/support/" class="btn magnetic">Support the network</a>
      </div>
    </div>
  </div>
</section>

<script>
  (function(){
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var zone = document.getElementById('heroParallax');
    var heart = document.getElementById('heroHeart');
    if (!zone || !heart) return;
    zone.addEventListener('mousemove', function(e){
      var rect = zone.getBoundingClientRect();
      var x = (e.clientX - rect.left - rect.width / 2) / (rect.width / 2);
      var y = (e.clientY - rect.top - rect.height / 2) / (rect.height / 2);
      heart.style.transform = 'rotate(-4deg) translate(' + (x * 10) + 'px,' + (y * 10) + 'px)';
    });
    zone.addEventListener('mouseleave', function(){
      heart.style.transform = 'rotate(-4deg)';
    });
  })();

  // Click the hero heart 8 times within ~2.5s — a nod to 8 March,
  // International Women's Day — for a burst of the site's own heart-cursor
  // hearts plus a small stamp toast. Kept separate from the parallax IIFE
  // above (which exits entirely under prefers-reduced-motion) since the
  // toast itself isn't motion and should still appear either way; only the
  // burst animation is skipped for reduced-motion.
  (function(){
    var heart = document.getElementById('heroHeart');
    // Not gated on window.elysiumShowEggToast existing yet: this page's own
    // inline scripts run (in document order) before base.njk's later
    // script block defines it, so checking at setup time would always bail
    // out. Checked instead at click time, by which point everything has
    // long since loaded.
    if (!heart) return;
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var count = 0, resetTimer = null;
    heart.addEventListener('click', function(){
      count++;
      clearTimeout(resetTimer);
      resetTimer = setTimeout(function(){ count = 0; }, 2500);
      if (count < 8) return;
      count = 0;
      if (!reduceMotion && window.elysiumSpawnHeart) {
        var rect = heart.getBoundingClientRect();
        var cx = rect.left + rect.width / 2, cy = rect.top + rect.height / 2;
        for (var i = 0; i < 12; i++) {
          (function(i){
            setTimeout(function(){
              window.elysiumSpawnHeart(cx + (Math.random() * 160 - 80), cy + (Math.random() * 80 - 40));
            }, i * 30);
          })(i);
        }
      }
      window.elysiumShowEggToast('<span class="stamp" style="border-color:var(--coral);color:var(--coral-ink);background:#fff">08 · International Women’s Day is the 8th of March</span>');
    });
  })();
</script>
